# unmei · 环境变量样板
# cp .env.example .env 后改实值;.env 不入库

# ─── PostgreSQL 18 ─────────────────────────────────────────
POSTGRES_DB=unmei
POSTGRES_USER=unmei
POSTGRES_PASSWORD=unmei_dev_pwd
POSTGRES_PORT=6032

# ─── 缓存(kevy-embedded · in-process,无端口)──────────────
# UNMEI_CACHE_DIR=./data/cache

# ─── 风控(台账 D7)────────────────────────────────────────
# 默认关:规则照跑、事件照落、一单不拦。后台看到真实命中率、
# 运营逐条改过判定之后,再打开。
# UNMEI_RISK_ENFORCE=1

# ─── 对外地址(支付回调靠它)────────────────────────────────
# 渠道回调打的是 `${UNMEI_PUBLIC_BASE}/v1/webhooks/wechat`。
# **不设的话兜底成 `http://localhost:6028`** —— 渠道根本到不了那个地址,
# 而它不会报错:支付照建,只是回调永远不来(轮询兜底还在,所以你看不出区别)。
# 接真凭据那一步(工序单第 46 步)必须设成公网能打到的地址。
# UNMEI_PUBLIC_BASE=https://api.buwanren.example.com

# ─── 算力源 mingli-api ────────────────────────────────────
# 跑在宿主 :6027,容器内通过 host.docker.internal 访问
MINGLI_API_BASE=http://host.docker.internal:6027

# ─── JWT 秘钥(prod 必须改 ≥ 32 chars) ───────────────────
UNMEI_JWT_SECRET=dev_jwt_secret_change_me_in_prod_32chars
UNMEI_ADMIN_JWT_SECRET=dev_admin_jwt_secret_change_me_in_prod_32chars

# ─── 服务端口 ─────────────────────────────────────────────
UNMEI_API_PORT=6028
UNMEI_ADMIN_API_PORT=6029

# ─── 微信小程序 ────────────────────────────────────────
# 在微信公众平台 → 开发 → 开发管理 → 开发设置 拿
WX_MP_APPID=
WX_MP_SECRET=

# 上面两个空着的时候，jscode2session 走 mock：任意 code 都能登进去，
# 同一个 code 永远是同一个账号 —— 那是本机开发用的，不是能对外开的。
# 所以默认【不放行】：/v1/auth/wx/miniprogram 直接报错。
# 本机想用 mock 登录，把下面这行取消注释；**部署到线上不要带它**。
# UNMEI_WX_MOCK=1

# 支付的「查询」也还是桩，而它回的是「已支付」——`payment_query_sweeper`
# 每 30 秒问一次，于是每一笔待付支付都会在 90 秒内被结成已付，一分钱没收。
# 配没配真凭据都走这个适配器，所以默认【不放行】。
# `scripts/e2e.sh` 那条全链路要它，本机跑就取消注释；**线上不要带**。
# UNMEI_PAY_STUB_AUTOSETTLE=1

# ─── 微信公众号 / H5 / 扫码登录 ─────────────────────────
# 公众号:微信公众平台 → 设置与开发 → 公众号设置 → 开发者ID
# 开放平台扫码:open.weixin.qq.com → 管理中心 → 网站应用
WX_H5_APPID=
WX_H5_SECRET=

# ─── 微信支付 v3 ──────────────────────────────────────────
# 商户号、商户私钥路径、证书序列号、回调地址
WX_PAY_MCHID=
WX_PAY_KEY_PATH=/etc/unmei/wxpay/apiclient_key.pem
WX_PAY_SERIAL_NO=
# APIv3 密钥（商户平台 → API 安全 → 设置 APIv3 密钥）。
# **回调是用它解密的**（AES-GCM）—— 缺了它回调解不开、支付永远不结算，
# 而这件事之前既不在这份模板里、也不在 docker-compose 里（2026-08-18 补）
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://your-domain.com/v1/pay/wx/notify

# ─── 对外地址（真收钱之前必须设）──────────────────────────
# 支付回调告诉微信「回调到哪儿」。不设就退回 http://localhost:6028 ——
# 那样回调永远不来、支付永远不结算，而下单那一步照样返回 200。
# 服务启动时会为这件事 warn 一句，但那时钱可能已经在路上了。
UNMEI_PUBLIC_BASE=https://your-domain.com

# ─── 物流查询（接真承运商时要）────────────────────────────
# 不设就查不到轨迹；轮询那支 worker 会一直空转
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# ─── 风控开关 ─────────────────────────────────────────────
# 默认观察模式：规则照跑、事件照落、一单不拦。
# 设成 1 / true 才会真的拦单 —— 那是产品行为变更，别顺手打开
UNMEI_RISK_ENFORCE=

# ─── 日志 ─────────────────────────────────────────────────
RUST_LOG=info,unmei_api=debug,unmei_wx=debug,sqlx=warn
