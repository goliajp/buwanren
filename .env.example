# unmei · 环境变量样板
# cp .env.example .env 后改实值;.env 不入库

# ─── PostgreSQL 18 ─────────────────────────────────────────
POSTGRES_DB=unmei
POSTGRES_USER=unmei
POSTGRES_PASSWORD=unmei_dev_pwd
POSTGRES_PORT=6032

# ─── 缓存(kevy-embedded · in-process,无端口)──────────────
# UNMEI_CACHE_DIR=./data/cache
# UNMEI_ADMIN_CACHE_DIR=./data/admin-cache

# ─── 算力源 mingli-api ────────────────────────────────────
# 跑在宿主 :6027,容器内通过 host.docker.internal 访问
MINGLI_API_BASE=http://host.docker.internal:6027

# ─── JWT 秘钥(prod 必须改 ≥ 32 chars) ───────────────────
UNMEI_JWT_SECRET=dev_jwt_secret_change_me_in_prod_32chars
UNMEI_ADMIN_JWT_SECRET=dev_admin_jwt_secret_change_me_in_prod_32chars

# ─── 服务端口 ─────────────────────────────────────────────
UNMEI_API_PORT=6028
UNMEI_ADMIN_API_PORT=6029

# ─── 微信小程序 ────────────────────────────────────────
# 在微信公众平台 → 开发 → 开发管理 → 开发设置 拿
WX_MP_APPID=
WX_MP_SECRET=

# ─── 微信公众号 / H5 / 扫码登录 ─────────────────────────
# 公众号:微信公众平台 → 设置与开发 → 公众号设置 → 开发者ID
# 开放平台扫码:open.weixin.qq.com → 管理中心 → 网站应用
WX_H5_APPID=
WX_H5_SECRET=

# ─── 微信支付 v3 ──────────────────────────────────────────
# 商户号、商户私钥路径、证书序列号、回调地址
WX_PAY_MCHID=
WX_PAY_KEY_PATH=/etc/unmei/wxpay/apiclient_key.pem
WX_PAY_SERIAL_NO=
WX_PAY_NOTIFY_URL=https://your-domain.com/v1/pay/wx/notify

# ─── 日志 ─────────────────────────────────────────────────
RUST_LOG=info,unmei_api=debug,unmei_wx=debug,sqlx=warn
