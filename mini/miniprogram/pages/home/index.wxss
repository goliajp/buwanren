/* 这一页下面就是 tab 栏，全局 .page 那 96rpx 的页底留白跟它重了一份。
   而这一页是最挤的一屏（罗盘要吃掉所有富余），最矮的机器上差的就是这几十像素。 */
.page { padding-bottom: 40rpx; display: flex; flex-direction: column; }
.today-block { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }

.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }
.hd .subtitle { color: var(--ink-mid); }

.delta {
  padding: 12rpx 0 8rpx;
}

/* 三行普通文字行 —— 不是展示体。字号跟这一屏别处的正文一档，
   五行的颜色留在行内那几个字上，靠色不靠大。 */
.delta-line {
  font-size: 32rpx;
  line-height: 1.5;
  color: var(--ink-mid);
}
.delta-line.dim { color: var(--ink-faint); }
.delta-line text { font-weight: 600; font-weight: 500; }

.delta-role {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-faint);
  letter-spacing: 0.1em;
}

.quote {
  padding: 40rpx 24rpx 32rpx;
  position: relative;
}
.quote-mark {
  font-weight: 600;
  font-size: 48rpx;
  color: var(--stamp);
  opacity: 0.7;
  line-height: 1;
}
.quote-mark-r { text-align: right; }
.quote-body {
  padding: 8rpx 0;
  font-size: 30rpx;
  color: var(--ink-mid);
  line-height: 1.7;
  letter-spacing: 0.04em;
}

.foot-hint {
  padding: 40rpx 0 20rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-faint);
  letter-spacing: 0.01em;
}

/* empty · 无本命 */
.empty {
  padding: 100rpx 0 60rpx;
  text-align: center;
}
.empty-t {
  font-weight: 600;
  font-size: 80rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.12em;
  margin-bottom: 32rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  letter-spacing: 0.08em;
  margin-bottom: 8rpx;
}
.empty .btn {
  margin-top: 60rpx;
}

/* 取不到时说一句，别渲成「你还没建」—— 那是另一件事 */
.err { padding: 24rpx 0; color: var(--peach); font-size: 26rpx; line-height: 1.7; }

/* 没本命时「转一下」不是消失，是灰着 —— 空状态要看得见出口。 */
/* `.btn-off`（opacity .42）删了：一颗【能按】的按钮长得像禁用的，
   而这一颗是这一屏唯一的出路。它本来也从没生效过 ——
   `button.btn` 的特异性盖着它。 */
.today-block { margin-top: 20rpx; }
.today-k { font-size: 26rpx; color: var(--ink-faint); margin-bottom: 14rpx; }

/* 弹性槽：近几次。矮屏它落在折线之下、看不见；长屏才出现（设计 10.1）。 */
.recent { margin-top: 36rpx; }
.recent-k { font-size: 24rpx; color: var(--ink-faint); margin-bottom: 12rpx; }
.recent-row { display: flex; justify-content: space-between; padding: 14rpx 0;
              border-bottom: 1rpx solid var(--paper-inset); }
.recent-d { font-size: 24rpx; color: var(--ink-faint); }
.recent-v { font-size: 26rpx; }
.recent-err { font-size: 24rpx; color: var(--ink-faint); margin-top: 28rpx; }

/* 引文压扁一层：原先是三个块（左引号 / 正文 / 右引号），
   在最矮的机器上光它就占掉 100px 出头。 */
.quote { font-size: 30rpx; line-height: 1.7; margin-top: 24rpx; }

/* ── 罗盘。从 pages/ask 搬来（REDESIGN.md：起卦归我家）──────────
   `.compass-face` 的宽高改由 wxml 上的内联 style 给（按剩余空间算），
   这里不再写死 560rpx —— 写死的话矮屏放不下、长屏留白。 */
/* ── 罗盘吃掉纵向富余 ───────────────────────────────────────
   这就是 `flex: 1` 的字面意思，所以交给 CSS，不再用 JS 量。

   原先是「量页高 → 改直径 → 再量」的收敛循环。它把**版式变成了时序问题**：
   内容是异步到的，循环要跑几轮才落定，而慢一点的机器上还没落定就被量走。
   同一份代码本机绿、CI 红，正是这么来的（2026-08-23）。

   老引擎没有 aspect-ratio（老安卓 webview / iOS 14 之前），
   基础规则给它一个按宽度算的方形罗盘 —— 也就是设计里的默认尺寸；
   新引擎才按剩余高度伸缩。降级的后果写明白：矮屏上那一页会滚。 */
.compass-wrap {
  position: relative;
  width: 100%;
  /* 不留上下内边距：这一块已经是伸缩的那一块，长屏上的呼吸感由富余本身给
     （它居中，富余自然摊在两头），矮屏上这圈边距就是纯溢出。 */
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
  min-height: 0;
}
/* 指针。盘沿从 2rpx 细线换成 12rpx 实心之后，原来那个 top:20rpx
   正好落在盘沿上、被压掉大半 —— 改成【骑在盘沿外面】，
   尖端朝下扎进盘里，看得出它指着哪一格。
   颜色用暖黑:琥珀色的指针压在琥珀色的盘沿上等于没有。 */
.compass-pointer {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 30rpx solid var(--ink);
  z-index: 6;
  filter: drop-shadow(0 3rpx 3rpx rgba(43,38,32,.28));
}
.compass-face {
  position: relative;
  /* 老引擎：按屏宽算的方形（设计的默认尺寸） */
  width: 78vw;
  height: 78vw;
  transition: transform 3s cubic-bezier(0.16, 1, 0.3, 1);
  transform-origin: center center;
}
@supports (aspect-ratio: 1) {
  .compass-face {
    /* 新引擎：高度由 flex 分，宽度由 aspect-ratio 跟着走。
       下限 132px —— 盘沿要绕 8 个卦符 + 8 个方位共 16 个标签，
       132px 直径周长约 415px，每个标签摊到 26px，两个字（西南）仍然完整。
       再小就得叠字，那时候该收的是标签不是盘。 */
    flex: 1 1 auto;
    align-self: center;
    width: auto;
    height: auto;
    min-height: 264rpx;
    max-height: 78vw;
    aspect-ratio: 1;
  }
}
/* 盘面（2026-08-31 重做）。原先是四圈 1-2rpx 的细线 ——
   在米底上几乎看不见，而它是这一屏最大的东西:占六成面积，
   却由几根看不清的线构成。

   更要紧的是【剪影】:三同心圆 + 顶部指针 + 摇一摇，这个组合
   已经很接近式盘、罗盘，而这一版的硬要求是「绝对不要玄学古风」。
   实心盘沿 + 八等分扇格把它拉回「抽奖转盘」那一侧。 */

/* 盘沿:12rpx 实心琥珀 + 底部硬投影（像素风用硬边，不用 blur）。
   `inset` 那一圈是顶光高光，让盘沿看着有厚度。 */
.ring {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.ring-1 {
  top: 0; left: 0; right: 0; bottom: 0;
  border: 12rpx solid var(--amber-deep);
  background: var(--paper);
  box-shadow:
    0 10rpx 0 rgba(232,121,26,.22),
    0 6rpx 0 rgba(255,255,255,.5) inset;
}
/* 八等分扇格。`repeating-conic-gradient` 一条规则画完 ——
   交替的两档米色，缝隙不画线:线又会把它拉回刻度盘。 */
.ring-2 {
  top: 12rpx; left: 12rpx; right: 12rpx; bottom: 12rpx;
  background: repeating-conic-gradient(from -22.5deg,
    var(--paper) 0deg 45deg,
    #FFF3E4 45deg 90deg);
}
/* 内圈那道浅槽 —— 把中心按钮跟扇格隔开，
   按钮才不是「贴在花纹上」，而是「嵌在盘心里」。 */
.ring-3 {
  top: 92rpx; left: 92rpx; right: 92rpx; bottom: 92rpx;
  background: var(--paper);
  box-shadow: 0 2rpx 8rpx rgba(43,38,32,.10) inset;
}
/* 第四圈原先是又一根细线。盘沿和扇格已经把结构说清了，
   再加一圈只是噪音 —— 留着但不画东西，省得动 wxml 的层数。 */
.ring-4 { display: none; }

.compass-btn {
  position: absolute;
  top: 50%; left: 50%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  padding: 0;
  border-radius: 50%;
  /* 从深灰球换成琥珀。它是这一屏唯一可按的东西 ——
     原先是整屏最暗的一块，看着像个仪表而不是「点我」 */
  background: radial-gradient(circle at 50% 28%, #FFB463 0%, var(--amber) 52%, var(--amber-deep) 100%);
  border: none;
  box-shadow:
    0 8rpx 0 var(--amber-deep),
    0 14rpx 30rpx rgba(232,121,26,.34),
    0 2rpx 0 rgba(255,255,255,.4) inset;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  transition: transform 0.15s ease-out;
}
.compass-btn::after { border: none; }
.compass-btn-hover {
  transform: translate(0, 4rpx) scale(0.97);
  box-shadow: 0 2rpx 0 var(--amber-deep), 0 6rpx 14rpx rgba(232,121,26,.3),
              0 2rpx 0 rgba(255,255,255,.4) inset;
}
.compass-btn-lit {
  border-color: rgba(201, 169, 98, 0.78);
  box-shadow:
    0 6rpx 32rpx rgba(201, 169, 98, 0.32),
    0 1rpx 0 rgba(255, 255, 255, 0.1) inset;
}
/* 原先是等宽字体 + 0.24em 字距 + uppercase —— 三样加起来像终端输出。
   这是一句对人说的话，就按人话排 */
.compass-hint {
  padding: 28rpx 0 8rpx;
  font-size: 25rpx;
  color: var(--ink-faint);
  letter-spacing: 0.01em;
  text-align: center;
}

/* 中心那句「问一件事」。原先没有自己的规则，靠 button 的默认色 ——
   球换成琥珀之后它必须是白的，否则读不出来 */
.compass-btn .cb-cn {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

/* 通往村子的那条路（0830 标尺 §1.5.2）。做成一条带子而不是按钮 ——
   这一屏的主动作是中间那个罗盘，它不该跟罗盘抢。 */
.tovillage {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 18rpx; padding: 16rpx 20rpx;
  background: var(--moss-lite); border-radius: var(--r-card);
  font-size: 25rpx; color: #2E7D5B; font-weight: 600;
}
.tovillage-go { color: #2E8B57; }

/* ── 盘面上的标记摆到圆周上 ────────────────────────────────
   `.bagua-0`…`.dir-7`、`.dot-*` 这二十四条定位规则**一条都没写过**：
   wxml 里一直在渲这些节点，样式里也给了尺寸与颜色，唯独没给位置 ——
   于是十六个标签和八个金点全叠在圆心，被中间那颗按钮整个盖住。
   盘上什么都没有，所以按下去转了三秒也看不出在转，
   而那是这个产品每天都要用的那一下。
   （从逐帧截图上看出来的：按下 400ms 与 1.6s 两帧一模一样。）

   位置用【百分比】而不是像素：盘的直径随屏走（见上面 `aspect-ratio` 那一段），
   写死像素的话矮屏上标签会压到环上。
   0 号在正上方（指针位置），顺时针每 45° 一个 ——
   跟 index.ts 里 `DIRECTION_ANGLE` 那张表同一套角度，
   两处对不上的话，转完停的位置会跟屏上写的方位差一格。 */
/* 盘上唯一的标记：一圈刻度。八个一样大的点转起来看不出快慢，
   所以第一个（正上方、指针底下那个）做成实心大点 —— 它是「转到哪儿了」的锚。
   转完之后指针指着它，也就指着后端给的那个方向：一眼看得出「停在这儿」。 */
/* 八颗点落在八个扇格的正中（扇格从 -22.5° 起，点在 0/45/90…°）——
   它们现在是【格子的标记】，不是刻度:原先是浮在细线圈上的散点，
   看着像仪表的刻度;贴着格子就成了「八个格，转到哪一格」。
   实心一档、加白描边，从米色扇格上抠出来。 */
.dot {
  position: absolute;
  width: 16rpx; height: 16rpx;
  margin: -8rpx 0 0 -8rpx;
  border-radius: 999rpx;
  background: rgba(232,121,26,.42);
  box-shadow: 0 0 0 3rpx var(--paper);
  z-index: 2;
}
/* 指针停的那一格（正上方）实心且大一档 —— 一眼看得出停在哪儿 */
.dot-0 {
  width: 26rpx; height: 26rpx; margin: -13rpx 0 0 -13rpx;
  background: var(--amber-deep);
  box-shadow: 0 0 0 4rpx var(--paper), 0 0 0 10rpx rgba(255,154,60,.20);
}

.dot-0 { left: 50.00%; top: 13.00%; }
.dot-1 { left: 76.16%; top: 23.84%; }
.dot-2 { left: 87.00%; top: 50.00%; }
.dot-3 { left: 76.16%; top: 76.16%; }
.dot-4 { left: 50.00%; top: 87.00%; }
.dot-5 { left: 23.84%; top: 76.16%; }
.dot-6 { left: 13.00%; top: 50.00%; }
.dot-7 { left: 23.84%; top: 23.84%; }

/* 还没填出生时间时，中心那颗让位 —— 那时屏上写着「转出来的还不算你的」，
   而底下有一颗满橙的「填出生时间」。两颗一样重的按钮摆在一屏上，
   人不知道该按哪颗。仍然点得动，只是不抢主色。
   写成 `button.compass-btn.…`：单类压不过上面那条同样是 `.compass-btn` 的规则，
   而它带 radial-gradient，覆盖不掉就等于这条没写。 */
button.compass-btn.compass-btn-quiet {
  background: radial-gradient(circle at 50% 28%, #F3E7D6 0%, #E9DBC6 52%, #DCCBB2 100%);
  box-shadow: 0 2rpx 10rpx rgba(120, 96, 64, .12);
}
button.compass-btn.compass-btn-quiet .cb-cn { color: #9A8A72; }
