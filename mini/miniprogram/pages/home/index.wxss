/* 这一页下面就是 tab 栏，全局 .page 那 96rpx 的页底留白跟它重了一份。
   而这一页是最挤的一屏（罗盘要吃掉所有富余），最矮的机器上差的就是这几十像素。 */
.page { padding-bottom: 40rpx; display: flex; flex-direction: column; }
.today-block { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }

.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }
.hd .subtitle { color: var(--ink-mid); }

.delta {
  padding: 12rpx 0 8rpx;
}

/* 三行普通文字行 —— 不是展示体。字号跟这一屏别处的正文一档，
   五行的颜色留在行内那几个字上，靠色不靠大。 */
.delta-line {
  font-size: 32rpx;
  line-height: 1.5;
  color: var(--ink-mid);
}
.delta-line.dim { color: var(--ink-faint); }
.delta-line text { font-weight: 600; font-weight: 500; }

.delta-role {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-faint);
  letter-spacing: 0.1em;
}

.quote {
  padding: 40rpx 24rpx 32rpx;
  position: relative;
}
.quote-mark {
  font-weight: 600;
  font-size: 48rpx;
  color: var(--stamp);
  opacity: 0.7;
  line-height: 1;
}
.quote-mark-r { text-align: right; }
.quote-body {
  padding: 8rpx 0;
  font-size: 30rpx;
  color: var(--ink-mid);
  line-height: 1.7;
  letter-spacing: 0.04em;
}

.foot-hint {
  padding: 40rpx 0 20rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-faint);
  letter-spacing: 0.01em;
}

/* empty · 无本命 */
.empty {
  padding: 100rpx 0 60rpx;
  text-align: center;
}
.empty-t {
  font-weight: 600;
  font-size: 80rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.12em;
  margin-bottom: 32rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  letter-spacing: 0.08em;
  margin-bottom: 8rpx;
}
.empty .btn {
  margin-top: 60rpx;
}

/* 取不到时说一句,别渲成「你还没建」—— 那是另一件事 */
.err { padding: 24rpx 0; color: var(--peach); font-size: 26rpx; line-height: 1.7; }

/* 没本命时「转一下」不是消失，是灰着 —— 空状态要看得见出口。 */
/* `.btn-off`（opacity .42）删了：一颗【能按】的按钮长得像禁用的，
   而这一颗是这一屏唯一的出路。它本来也从没生效过 ——
   `button.btn` 的特异性盖着它。 */
.today-block { margin-top: 20rpx; }
.today-k { font-size: 26rpx; color: var(--ink-faint); margin-bottom: 14rpx; }

/* 弹性槽：近几次。矮屏它落在折线之下、看不见；长屏才出现（设计 10.1）。 */
.recent { margin-top: 36rpx; }
.recent-k { font-size: 24rpx; color: var(--ink-faint); margin-bottom: 12rpx; }
.recent-row { display: flex; justify-content: space-between; padding: 14rpx 0;
              border-bottom: 1rpx solid var(--paper-inset); }
.recent-d { font-size: 24rpx; color: var(--ink-faint); }
.recent-v { font-size: 26rpx; }
.recent-err { font-size: 24rpx; color: var(--ink-faint); margin-top: 28rpx; }

/* 引文压扁一层：原先是三个块（左引号 / 正文 / 右引号），
   在最矮的机器上光它就占掉 100px 出头。 */
.quote { font-size: 30rpx; line-height: 1.7; margin-top: 24rpx; }

/* ── 罗盘。从 pages/ask 搬来（REDESIGN.md：起卦归我家）──────────
   `.compass-face` 的宽高改由 wxml 上的内联 style 给（按剩余空间算），
   这里不再写死 560rpx —— 写死的话矮屏放不下、长屏留白。 */
/* ── 罗盘吃掉纵向富余 ───────────────────────────────────────
   这就是 `flex: 1` 的字面意思，所以交给 CSS，不再用 JS 量。

   原先是「量页高 → 改直径 → 再量」的收敛循环。它把**版式变成了时序问题**：
   内容是异步到的，循环要跑几轮才落定，而慢一点的机器上还没落定就被量走。
   同一份代码本机绿、CI 红，正是这么来的（2026-08-23）。

   老引擎没有 aspect-ratio（老安卓 webview / iOS 14 之前），
   基础规则给它一个按宽度算的方形罗盘 —— 也就是设计里的默认尺寸；
   新引擎才按剩余高度伸缩。降级的后果写明白：矮屏上那一页会滚。 */
.compass-wrap {
  position: relative;
  width: 100%;
  /* 不留上下内边距：这一块已经是伸缩的那一块，长屏上的呼吸感由富余本身给
     （它居中，富余自然摊在两头），矮屏上这圈边距就是纯溢出。 */
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
  min-height: 0;
}
.compass-pointer {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 32rpx solid var(--wx-tu);
  z-index: 4;
  filter: drop-shadow(0 2rpx 4rpx rgba(40, 30, 12, 0.24));
}
.compass-face {
  position: relative;
  /* 老引擎：按屏宽算的方形（设计的默认尺寸） */
  width: 78vw;
  height: 78vw;
  transition: transform 3s cubic-bezier(0.16, 1, 0.3, 1);
  transform-origin: center center;
}
@supports (aspect-ratio: 1) {
  .compass-face {
    /* 新引擎：高度由 flex 分，宽度由 aspect-ratio 跟着走。
       下限 132px —— 盘沿要绕 8 个卦符 + 8 个方位共 16 个标签，
       132px 直径周长约 415px，每个标签摊到 26px，两个字（西南）仍然完整。
       再小就得叠字，那时候该收的是标签不是盘。 */
    flex: 1 1 auto;
    align-self: center;
    width: auto;
    height: auto;
    min-height: 264rpx;
    max-height: 78vw;
    aspect-ratio: 1;
  }
}
.ring {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.ring-1 {
  top: 0; left: 0; right: 0; bottom: 0;
  border: 2rpx solid rgba(255,154,60,.42);
  background: radial-gradient(circle at 50% 50%,
    rgba(201, 169, 98, 0) 78%,
    rgba(201, 169, 98, 0.14) 100%);
}
.ring-2 {
  top: 40rpx; left: 40rpx; right: 40rpx; bottom: 40rpx;
  border: 1rpx dashed rgba(255,154,60,.34);
}
.ring-3 {
  top: 60rpx; left: 60rpx; right: 60rpx; bottom: 60rpx;
  border: 1rpx solid rgba(43,38,32,.14);
}
.ring-4 {
  top: 160rpx; left: 160rpx; right: 160rpx; bottom: 160rpx;
  border: 1rpx solid rgba(43,38,32,.10);
}
.bagua {
  position: absolute;
  top: 50%; left: 50%;
  width: 60rpx;
  height: 60rpx;
  margin: -30rpx 0 0 -30rpx;   /* center anchor */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.bagua .bg-t {
  font-weight: 600;
  font-size: 60rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1;
  letter-spacing: 0;
}
.dir {
  position: absolute;
  top: 50%; left: 50%;
  width: 60rpx;
  height: 30rpx;
  margin: -15rpx 0 0 -30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.dir text {
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 20rpx;
  color: var(--stone-subtle, #78716c);
  letter-spacing: 0.06em;
}
.compass-btn {
  position: absolute;
  top: 50%; left: 50%;
  width: 200rpx;
  height: 200rpx;
  margin: -100rpx 0 0 -100rpx;
  padding: 0;
  border-radius: 50%;
  /* 从深灰球换成琥珀。它是这一屏唯一可按的东西 ——
     原先是整屏最暗的一块，看着像个仪表而不是「点我」 */
  background: radial-gradient(circle at 50% 28%, #FFB463 0%, var(--amber) 52%, var(--amber-deep) 100%);
  border: none;
  box-shadow:
    0 8rpx 0 var(--amber-deep),
    0 14rpx 30rpx rgba(232,121,26,.34),
    0 2rpx 0 rgba(255,255,255,.4) inset;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  transition: transform 0.15s ease-out;
}
.compass-btn::after { border: none; }
.compass-btn-hover {
  transform: translate(0, 4rpx) scale(0.97);
  box-shadow: 0 2rpx 0 var(--amber-deep), 0 6rpx 14rpx rgba(232,121,26,.3),
              0 2rpx 0 rgba(255,255,255,.4) inset;
}
.compass-btn-lit {
  border-color: rgba(201, 169, 98, 0.78);
  box-shadow:
    0 6rpx 32rpx rgba(201, 169, 98, 0.32),
    0 1rpx 0 rgba(255, 255, 255, 0.1) inset;
}
/* 原先是等宽字体 + 0.24em 字距 + uppercase —— 三样加起来像终端输出。
   这是一句对人说的话，就按人话排 */
.compass-hint {
  padding: 28rpx 0 8rpx;
  font-size: 25rpx;
  color: var(--ink-faint);
  letter-spacing: 0.01em;
  text-align: center;
}

/* 中心那句「问一件事」。原先没有自己的规则，靠 button 的默认色 ——
   球换成琥珀之后它必须是白的，否则读不出来 */
.compass-btn .cb-cn {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

/* 通往村子的那条路（0830 标尺 §1.5.2）。做成一条带子而不是按钮 ——
   这一屏的主动作是中间那个罗盘，它不该跟罗盘抢。 */
.tovillage {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 18rpx; padding: 16rpx 20rpx;
  background: var(--moss-lite); border-radius: var(--r-card);
  font-size: 25rpx; color: #2E7D5B; font-weight: 600;
}
.tovillage-go { color: #2E8B57; }
