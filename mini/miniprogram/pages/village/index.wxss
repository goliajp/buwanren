.wrap { display: flex; flex-direction: column; align-items: center;
        background: var(--paper); min-height: 100vh; }
.hd { display: flex; width: 100%; box-sizing: border-box;
      padding: 16rpx 32rpx 10rpx; align-items: center; gap: 20rpx; }
.sub { font-size: 26rpx; color: var(--ink-mid); }
.count { margin-left: auto; font-size: 26rpx; color: var(--ink); }
/* 画布的像素尺寸由村子声明(VILLAGE_SIZE),这里只管它在屏幕上占多大 */
/* 画布按可用高度等比铺，窄屏上两侧会留一点白。
   给一圈极淡的描边 + 阴影，让那点留白读起来是【画框】而不是「没铺满」 */
.village { display: block; border-radius: var(--r-card);
           box-shadow: 0 2rpx 10rpx rgba(43,38,32,.10), 0 0 0 1rpx rgba(43,38,32,.05); }
.card { width: 100%; box-sizing: border-box; padding: 24rpx 32rpx;
        display: flex; align-items: center; gap: 24rpx; }
.who { font-size: 30rpx; color: var(--ink); }
.acts { margin-left: auto; display: flex; gap: 16rpx; }
.act { padding: 12rpx 32rpx; border-radius: 16rpx;
       background: var(--ink); color: var(--paper); font-size: 28rpx; }
.err { padding: 32rpx; color: var(--peach); font-size: 26rpx; line-height: 1.7; }
.scan { margin-left: 16rpx; padding: 8rpx 20rpx; border-radius: 16rpx;
        border: none; background: var(--amber-lite); color: var(--amber-deep);
        font-size: 24rpx; font-weight: 600; border-radius: 999rpx; }
.hint { color: var(--ink-faint); font-size: 26rpx; }
.say { margin: 0 32rpx 32rpx; padding: 24rpx 28rpx; border-radius: 20rpx;
       background: var(--paper); color: var(--ink); font-size: 30rpx; line-height: 1.8; }

/* 「该扫了」（设计册 E2）。高度按触点定：56px = 112rpx，
   `fitCanvas` 里减掉的就是这个数 —— 两处要对得上，改一处就得改另一处。 */
.nudge {
  width: 100%;
  box-sizing: border-box;
  height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--paper-inset);
  border-top: 1rpx solid var(--stone-line-x);
  border-bottom: 1rpx solid var(--stone-line-x);
}
.nudge-hover { background: var(--paper-inset); }
.nudge-t { font-size: 30rpx; color: var(--ink); }
.nudge-s { font-size: 24rpx; color: var(--ink-faint); margin-top: 4rpx; }

/* E2 的弹性槽：手输编号。矮屏收起（app.wxss 里那条 max-height 规则） */
.manual { width: 100%; box-sizing: border-box; padding: 20rpx 32rpx 24rpx; }
.manual-k { font-size: 24rpx; color: var(--ink-faint); margin-bottom: 12rpx; }
.manual-row { display: flex; align-items: center; gap: 16rpx; }
.manual-input {
  flex: 1; background: var(--paper); border: 1rpx solid var(--stone-line-x);
  border-radius: 16rpx; padding: 14rpx 20rpx; font-size: 26rpx; color: var(--ink);
}
.manual-go {
  flex: none; padding: 14rpx 32rpx; border-radius: 16rpx;
  background: var(--ink); color: var(--paper); font-size: 26rpx;
}
.manual-go-hover { opacity: .75; }
.manual-err { margin-top: 12rpx; font-size: 24rpx; color: var(--peach); line-height: 1.6; }

/* 问候语 + 日期（设计册 V1）。两行，占的是原先那一行副标的位置 */
.greet { flex: 1; }
.greet-hi { display: block; font-weight: 700; font-size: 44rpx; color: var(--ink);
            letter-spacing: -0.01em; }
.greet-day { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--ink-faint); letter-spacing: 0.06em; }

/* 弹性槽：住着几位、今晚那一场 */
.tally { width: 100%; box-sizing: border-box; padding: 16rpx 32rpx 20rpx;
         display: flex; align-items: baseline; gap: 16rpx; }
.tally-n { flex: none; font-size: 24rpx; color: var(--ink-mid); }
.tally-go { margin-left: auto; font-size: 24rpx; color: var(--ink); }
.tally-dim { margin-left: auto; font-size: 22rpx; color: var(--ink-faint); }

/* 某位今天说的一句（设计册 V1 · 0830 版重做）。
   原先是四行居中的文字，读起来像一段引文 —— 而它是这一屏的主角。
   现在是【一张卡片 + 一张脸】:卡片把她的话从背景里抬出来，
   头像让「有人在跟你说话」这件事在零点几秒内成立。

   头像暂时是【姓名末字 + 色圆牌】。没有美术就不假装有 ——
   等 40 张头像画好，换掉这一处即可，版式不用动。

   **改这一块的高度就要改 index.ts 里 `fitCanvas` 的那个常量** ——
   画布按可用高度铺，它俩对不上时画布不会让位，
   症状是「多一块就超出去几十像素」，而那几十像素正好等于差值。 */
.says {
  /* align-self 不能省:`.wrap` 是 align-items:center，
     不写的话卡片按内容宽收缩，看起来像一段居中的引文 —— 正是要改掉的那个毛病 */
  align-self: stretch;
  margin: 0 24rpx 12rpx;
  padding: 20rpx 22rpx;
  background: var(--paper-panel);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  transition: transform .12s cubic-bezier(.34,1.56,.64,1);
}
.says-hover { transform: scale(.985); }
.says-face {
  flex: none;
  width: 84rpx; height: 84rpx; border-radius: 999rpx;
  background: linear-gradient(150deg, var(--amber-lite), #FFC489);
  color: #8A5A1E;
  font-size: 38rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.says-body { flex: 1; min-width: 0; }
.says-who { font-size: 23rpx; color: var(--ink-faint); }
.says-text { font-size: 33rpx; font-weight: 600; color: var(--ink); line-height: 1.5; margin-top: 4rpx; }
/* 身份与「去看看」并成一行 —— 省下的那一行全给画布。
   村子是这一屏的场景，它每多 40rpx 都值 */
.says-foot { display: flex; align-items: baseline; margin-top: 10rpx; }
.says-id { font-size: 21rpx; color: var(--stone-label); }
.says-go { margin-left: auto; font-size: 24rpx; color: var(--amber-deep); font-weight: 600; }

/* 收集进度 —— 从「住着 9 位 · 还空 31 间」那种运营口径改成图鉴条。
   星露谷式:一眼看得出「我集了多少」，不用读数字。
   **常驻，不放弹性槽** —— 它是这个产品的核心反馈，不是可有可无的补充。 */
.bar { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 32rpx 2rpx; width: 100%; box-sizing: border-box; }
.bar-track { flex: 1; height: 18rpx; border-radius: 999rpx; background: var(--paper-inset);
             overflow: hidden; box-shadow: inset 0 1rpx 3rpx rgba(43,38,32,.08); }
.bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--moss), #62C795);
            transition: width .5s cubic-bezier(.34,1.2,.64,1); }
.bar-n { flex: none; font-size: 26rpx; font-weight: 700; color: var(--moss); font-variant-numeric: tabular-nums; }
/* 一位都没有时进度条是空的 —— 空条比没有条更让人想填满它 */
.bar-fill { min-width: 0; }
