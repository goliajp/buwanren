<view class="page">
  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card"><view class="sk-body">
      <view class="sk sk-line mid"></view><view class="sk sk-line long"></view>
    </view></view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="onBack">回村里</button>
  </view>

  <block wx:else>
    <!-- 0830:这是【这个角色的主页】，而它原先没有脸 ——
         一个靠角色立身的产品，最不该没有角色的就是这一屏。
         头像与名字并排，属性从三行横线表格改成一排药丸:
         「会这一门／稀有度／住下了吗」是三个标签，不是三条记录。 -->
    <view class="hd">
      <view class="face face-{{who.direction}}">{{who.face}}</view>
      <view class="hd-body">
        <view class="name">{{who.name}}</view>
        <view class="title" wx:if="{{who.title}}">{{who.title}}</view>
      </view>
    </view>

    <!-- 「缺」是这个产品的身份字段，所以它排在最前、颜色最重 -->
    <view class="tags">
      <text class="tag tag-lack">缺 {{who.lack}}</text>
      <text class="tag" wx:if="{{who.art}}">{{who.art}}</text>
      <text class="tag" wx:if="{{who.rarity}}">{{who.rarity}}</text>
      <text class="tag {{who.at_home ? 'tag-home' : ''}}">{{who.at_home ? '住着' : '还没请来'}}</text>
    </view>

    <!-- 问签的结果。同一天问同一位逐字相同 —— 那是设定，不是缓存 -->
    <view class="reading" wx:if="{{say}}">
      <view class="reading-k">他说</view>
      <view class="reading-v">{{say}}</view>
    </view>

    <view class="acts">
      <block wx:if="{{who.at_home}}">
        <button class="btn" bindtap="onAsk">{{asking ? '问着……' : '问事'}}</button>
        <!-- 她卖的东西，入口在她这儿（设计册 10.8：香在苏合家里卖，不在铺子里）。
             这一颗按 `sells` 出现 —— 由后端说这位村民卖不卖东西，页面不写死名单：
             写死的话，第二个卖东西的人来了没人记得改这里。 -->
        <button class="btn ghost" wx:if="{{sells}}" bindtap="goSells">{{sellsLabel}}</button>
        <button class="btn ghost" wx:if="{{canEnter}}" bindtap="onEnter">去家里坐坐</button>
        <view class="hint" wx:else>屋子还没搬进来</view>
      </block>
      <block wx:else>
        <!-- 没请回家不给问签 —— 那是设定不是权限，所以不给这颗按钮，
             而不是点了再报错 -->
        <button class="btn" bindtap="goInvite">{{inviting ? '找着……' : '请回家'}}</button>
      </block>
      <!-- 「回村里」原先在另一个容器里，于是它永远自己占一行、
           还按内容宽左对齐。它跟「去家里坐坐」是同一档的次要动作，
           该并排 —— 放进同一个 acts 里就行 -->
      <button class="btn ghost" bindtap="onBack">回村里</button>
    </view>
  </block>
</view>
