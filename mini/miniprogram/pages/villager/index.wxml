<view class="page">
  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card"><view class="sk-body">
      <view class="sk sk-line mid"></view><view class="sk sk-line long"></view>
    </view></view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="onBack">回村里</button>
  </view>

  <block wx:else>
    <!-- 0830：这是【这个角色的主页】，而它原先没有脸 ——
         一个靠角色立身的产品，最不该没有角色的就是这一屏。
         头像与名字并排，属性从三行横线表格改成一排药丸：
         「会这一门／稀有度／住下了吗」是三个标签，不是三条记录。 -->
    <view class="hd">
      <!-- 状态点压在脸的右下角，所以要包一层能定位的壳 -->
      <view class="facewrap">
        <!-- 画好脸的人铺真图，没画好的仍旧是圆底 + 姓名末字。
             有图时不渲那个字:它会从像素的透明处透出来。 -->
        <view class="face face-{{who.direction}} {{脸样 ? 'face-art' : ''}}" style="{{脸样}}">
          <text wx:if="{{!脸样}}">{{who.face}}</text>
        </view>
        <!-- 【状态跟着人走】。「住着 / 还没请来」是个是非题，
             占一整个胶囊太重;做成脸上那个小点，不读字也看得出来。 -->
        <view class="dot {{who.at_home ? 'dot-home' : ''}}"></view>
      </view>
      <view class="hd-body">
        <view class="name">{{who.name}}</view>
        <!-- 【身份跟身份在一起】。「占卜的老太太」和「塔罗」回答的是
             同一个问题（她是谁），本来就该在一行上，不该拆成
             一行副标题加一个胶囊。 -->
        <view class="title" wx:if="{{who.title}}">{{who.title}}<text wx:if="{{who.art}}"> · {{who.art}}</text></view>
      </view>
    </view>

    <!-- 【「缺」是玩法钩子，单独成块】。它跟上面两样不是一类东西:
         那两样说「他是谁」，这一句说「他身上缺着什么、所以会那样劝你」——
         这是「不完人」这个名字的来处，也是请他回村的理由。
         三样原先并排成三个一模一样的胶囊，读的人得逐个读完才知道谁是谁。 -->
    <view class="lack lack-{{who.direction}}">
      <text class="lack-k">缺{{who.lack}}</text>
      <!-- 【一人一句】。这一句原先四十位共用「缺过才懂，所以才这样劝你」——
           看第二个人就露出模板，而「四十个各不相同的人」正是这个产品的立身之本。
           每个「缺」本来就写着自己那一句（lack_bias.note，四十条各不相同），
           只是从来没人接。取不到才退回通用那句。 -->
      <text class="lack-s">{{who.lack_note || '缺过才懂，所以才这样劝你'}}</text>
    </view>

    <!-- 问签的结果。同一天问同一位逐字相同 —— 那是设定，不是缓存 -->
    <view class="reading" wx:if="{{say}}">
      <view class="reading-k">{{who.name}}说</view>
      <view class="reading-v">{{say}}</view>
    </view>

    <!-- 还没问的时候。这一屏原先在这儿是空的 —— 她住在你村里，
         却一句话都没有，而「居民是主角」正是这一版的三条主线之一。
         她住着就说一句今天的闲话（后端只给住着的人）；
         没写过台词的人不编 —— 那时就说清「问她」是怎么回事，把空变成邀请。 -->
    <view class="reading daily" wx:elif="{{who.at_home && who.line}}">
      <view class="reading-k">{{who.name}}今天说</view>
      <view class="reading-v">{{who.line}}</view>
      <!-- 【2026-09-01】原先写「想问一件具体的事」—— 而按下去调的
           `villageApi.ask(id)` 不带任何问题参数，后端也不收。
           人被明确告知可以问一件具体的事，产品收不到那件事。
           跟首页统一成「装在心里」——那句是诚实的。 -->
      <view class="reading-hint">心里装着一件事，按下面那颗 · 一天一次</view>
    </view>
    <view class="reading daily" wx:elif="{{who.at_home}}">
      <view class="reading-v dim">今天还没问过{{who.name}}</view>
      <view class="reading-hint">一天一次 · 同一天再问，说的是同一句</view>
    </view>

    <!-- 【还没请来】那一支原先什么都没有：屏上只有四个标签，
         中间三百多像素空着 —— 而这正是决定要花九十九块的地方。
         这三条对每一位都成立（它们是产品机制，不是四十条内容），
         所以不必等台词写齐就能说。 -->
    <view class="gets" wx:if="{{!who.at_home}}">
      <!-- 【怎么来的，写在最前面】。下面那三条说的全是「付完你在 app 里
           会有什么」，读起来就是一次数字购买 —— 而实际发生的是:
           寄一枚实物御守过来，几天后你扫开它，人才住进去。
           那三步只画在「谁能来」那一屏底部，而从地图上点一位进来的人
           根本不经过那儿（2026-09-01 五路评审里两路都点了这条:
           以为即时开通、付完发现要等快递的人，第一反应是申请退款）。 -->
      <view class="ships">
        <text class="ships-k">怎么来</text>
        <text class="ships-v">寄一枚御守到你手上 · 扫开它，{{who.name}}就住进村里</text>
      </view>
      <view class="gets-k">请{{who.name}}回村之后</view>
      <view class="gets-row">
        <view class="gets-n">1</view>
        <view class="gets-b">
          <view class="gets-t">{{who.name}}住进村里那一间</view>
          <view class="gets-s">四十间屋子空着的那一间，从此有人</view>
        </view>
      </view>
      <view class="gets-row">
        <view class="gets-n">2</view>
        <view class="gets-b">
          <view class="gets-t">每天跟你说一句</view>
          <view class="gets-s">{{who.name}}自己的口气，不是通用的话</view>
        </view>
      </view>
      <view class="gets-row">
        <view class="gets-n">3</view>
        <view class="gets-b">
          <view class="gets-t">有事可以问{{who.name}}</view>
          <view class="gets-s" wx:if="{{who.art}}">这一门是{{who.art}} · 一天一次</view>
          <view class="gets-s" wx:else>一天一次</view>
        </view>
      </view>
    </view>

    <view class="acts">
      <block wx:if="{{who.at_home}}">
        <button class="btn" bindtap="onAsk">
          <block wx:if="{{asking}}">问着……</block>
          <block wx:else>问问{{who.name}}</block>
        </button>
        <!-- 她卖的东西，入口在她这儿（设计册 10.8：香在苏合家里卖，不在铺子里）。
             这一颗按 `sells` 出现 —— 由后端说这位村民卖不卖东西，页面不写死名单：
             写死的话，第二个卖东西的人来了没人记得改这里。 -->
        <button class="btn ghost" wx:if="{{sells}}" bindtap="goSells">{{sellsLabel}}</button>
        <button class="btn ghost" wx:if="{{canEnter}}" bindtap="onEnter">去屋里看看</button>
        <!-- 【2026-09-01】原先写「屋子还没搬进来」—— 搬进来的是人，
             不是屋子;而且它说的其实是【我们还没把这一间做出来】。
             主语错了一次，读的人就得自己猜一次。 -->
        <view class="hint" wx:else>{{who.name}}的屋子还在盖 —— 做好了就能进去坐坐</view>
      </block>
      <block wx:else>
        <!-- 没请回家不给问签 —— 那是设定不是权限，所以不给这颗按钮，
             而不是点了再报错 -->
        <!-- 【2026-09-01】价钱写在按钮上。
             这颗是全屏唯一要掏钱的地方，而它之前只写「请婆婆回村」——
             按下去是马上扣钱还是先看看？没人知道，于是不按。
             价来自列表接口（`from_price_minor`），取不到就不写，不编。
             没上架的那位按钮变灰并说明白，别让人白点一趟。 -->
        <button class="btn" bindtap="goInvite" disabled="{{请不来}}">
          <block wx:if="{{inviting}}">找着……</block>
          <block wx:elif="{{请不来}}">{{请不来}}</block>
          <block wx:elif="{{价}}">请{{who.name}}回村 · {{价}}</block>
          <block wx:else>请{{who.name}}回村</block>
        </button>
        <!-- 掏钱之前先说清楚下一步是什么 —— 按钮上的价钱回答「多少」，
             这一行回答「按下去会发生什么」。两个都得有，人才敢按。 -->
        <!-- 「先看清楚再决定买不买」那句撤了。屏上已经没有别的可看 ——
             它读起来像在提醒这里有坑，而真正该说的（这是实物、要寄、要扫）
             现在写在上面「怎么来」那一行里。 -->
      </block>
      <!-- 「回村里」原先在另一个容器里，于是它永远自己占一行、
           还按内容宽左对齐。它跟「去屋里看看」是同一档的次要动作，
           该并排 —— 放进同一个 acts 里就行 -->
      <button class="btn ghost" bindtap="onBack">回村里</button>
    </view>
  </block>
</view>
