.page { padding: 32rpx 40rpx 40rpx; }
.hd { margin-bottom: 24rpx; }
.name { font-size: 48rpx; font-weight: 700; }
.title { font-size: 26rpx; color: var(--ink-faint); margin-top: 8rpx; }
.lack-row { display: flex; align-items: baseline; gap: 16rpx; margin: 24rpx 0; }
.lack-k { font-size: 26rpx; color: var(--ink-faint); }
.lack-v { font-size: 40rpx; font-weight: 700; }
.hr { height: 1rpx; background: var(--stone-line-x); margin: 24rpx 0; }
.meta-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid var(--paper-inset); }
.meta-k { font-size: 26rpx; color: var(--ink-faint); }
.meta-v { font-size: 28rpx; }
.reading { margin-top: 32rpx; padding: 24rpx; background: var(--paper-inset); }
.reading-k { font-size: 24rpx; color: var(--ink-faint); }
.reading-v { font-size: 30rpx; line-height: 1.7; margin-top: 12rpx; }
.acts { margin-top: 40rpx; display: flex; gap: 20rpx; flex-wrap: wrap; }
.hint { font-size: 24rpx; color: #999; align-self: center; }
.cta { margin-top: 48rpx; }
.loading, .err-msg { font-size: 28rpx; color: var(--ink-faint); }


/* ── 0830:角色的主页要有脸 ──────────────────────────────── */
.page { display: flex; flex-direction: column; }
/* 居中的角色卡。左对齐时头像和标签挤在顶上，底下空六百像素 ——
   而这一屏本来就是「一个人」，居中更像一张卡而不是一条记录。 */
/* `margin-top: auto` 两头各一个（这里与 `.acts`），剩下的高度就在
   角色卡上下对半分 —— 卡真的落在中间，而不是贴着顶、底下空六百像素。
   这一屏的内容天生就少（一张脸、一个名字、几个标签），
   靠对齐来把「少」变成「一张卡」，而不是变成「没写完」。 */
.hd { display: flex; flex-direction: column; align-items: center; gap: 16rpx;
      margin-top: auto; padding: 40rpx 0 4rpx; text-align: center; }
.face {
  flex: none; width: 168rpx; height: 168rpx; border-radius: 999rpx;
  font-size: 74rpx !important;

  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 0 12rpx rgba(255,154,60,.10), 0 10rpx 28rpx rgba(232,121,26,.24);
}
.hd-body { text-align: center; }
.hd .name { font-size: 46rpx; font-weight: 700; color: var(--ink); line-height: 1.2; }
.hd .title { margin-top: 6rpx; font-size: 25rpx; color: var(--ink-faint); }

/* 属性 = 一排标签。三行横线表格把三个短词读成了三条记录 */
.tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; margin-top: 26rpx; }
/* `:not(.tag-lack)` 是必须的:页面样式在 app.wxss 之后加载，
   而 `.tag` 与 `.lack-<方向>` 权重相同 —— 不排除的话这里的灰底
   会把方向色盖掉，看着就像方向色根本没做（今天踩过三次的那个坑）。 */
.tag {
  font-size: 23rpx; font-weight: 600;
  padding: 8rpx 18rpx; border-radius: 999rpx;
}
.tag:not(.tag-lack) { background: var(--paper-inset); color: var(--ink-mid); }
/* 「缺」是身份字段 —— 它排最前，也最重。
   底色由 `.lack-<方向>`（app.wxss）给，跟头像同一个色:
   同一件事在一张卡上不该用两种颜色说两遍。这里不写 background —— */
.tag-lack { font-weight: 700; }
/* 写成 `.tag.tag-home` 而不是 `.tag-home`：上面那条 `:not()` 把权重
   算成两个类，单个类的规则压不过它 —— 症状是「住着」那颗绿药丸变回灰的，
   看着像这个状态根本没做。`:not()` 的权重来自它的参数，容易忘。 */
.tag.tag-home { background: var(--moss-lite); color: #2E8B57; }

.acts { margin-top: auto; display: flex; flex-wrap: wrap; gap: 16rpx; padding-top: 40rpx; }
/* 主按钮独占一行 —— 它是这一屏要你做的那件事;两颗次要的并排。
   次要按钮的左右内边距要收 —— 用主按钮那个 56rpx 的话，
   两颗一行放不下，会各占一行、还各自左对齐 */
.acts .btn { flex: 1; min-width: 0; box-sizing: border-box; }
.acts .btn:not(.ghost) { flex: none; width: 100%; }
.acts .btn.ghost { padding-left: 20rpx; padding-right: 20rpx; }
