/* 全屏一件事：上面是他，下面是两条都往前的路。 */
.page { display: flex; flex-direction: column; min-height: 100vh; padding: 0 40rpx 64rpx; box-sizing: border-box; }
.stage { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 40vh; }
.glyph { font-size: 96rpx; font-weight: 700; letter-spacing: 8rpx; }
.body { margin-bottom: 48rpx; }
.line1 { font-size: 44rpx; font-weight: 700; }
.line2 { font-size: 28rpx; color: #767676; margin-top: 16rpx; line-height: 1.6; }
.acts { display: flex; gap: 20rpx; }
