.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 128rpx; line-height: 1; margin: 8rpx 0 16rpx; }
.hd .subtitle { color: var(--ink-mid); }

.delta {
  padding: 40rpx 0 24rpx;
}

.delta-row {
  display: flex;
  align-items: baseline;
  gap: 48rpx;
  margin-bottom: 12rpx;
}

.delta-k {
  font-family: "Songti SC", serif;
  font-size: 42rpx;
  color: var(--stone-label);
  letter-spacing: 0.3em;
  min-width: 84rpx;
}

.delta-v {
  font-family: "Songti SC", serif;
  font-size: 132rpx;
  font-weight: 500;
  line-height: 1;
}

.delta-role {
  padding-left: 132rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 0.2em;
  margin-bottom: 40rpx;
}

.delta-v-list {
  font-family: "Songti SC", serif;
  font-size: 84rpx;
  font-weight: 500;
  line-height: 1;
}

.quote {
  padding: 40rpx 24rpx 32rpx;
  position: relative;
}
.quote-mark {
  font-family: "Songti SC", serif;
  font-size: 48rpx;
  color: var(--stamp);
  opacity: 0.7;
  line-height: 1;
}
.quote-mark-r { text-align: right; }
.quote-body {
  padding: 8rpx 0;
  font-size: 30rpx;
  color: var(--ink-mid);
  line-height: 1.7;
  letter-spacing: 0.04em;
}

.foot-hint {
  padding: 60rpx 0 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--stone-label);
  letter-spacing: 0.24em;
}

/* empty · 无本命 */
.empty {
  padding: 100rpx 0 60rpx;
  text-align: center;
}
.empty-t {
  font-family: "Songti SC", serif;
  font-size: 80rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.12em;
  margin-bottom: 32rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  letter-spacing: 0.08em;
  margin-bottom: 8rpx;
}
.empty .btn {
  margin-top: 60rpx;
}
