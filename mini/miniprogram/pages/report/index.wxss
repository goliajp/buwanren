/* 一册六页，不滚动（设计册 10.3）。内容区固定，页签贴底 —— 翻页时
   标题和页签不动，动的只有中间那块，读起来像翻纸而不是刷网页 */
.page { display: flex; flex-direction: column; min-height: 100vh; }

.hd { padding: 14rpx 0 10rpx; }
.hd .title { font-size: 52rpx; line-height: 1.15; }
.hd .sub { font-size: 24rpx; color: var(--ink-faint); margin-top: 10rpx; letter-spacing: 0.04em; }

.loading, .err { padding: 40rpx 0; color: var(--ink-faint); font-size: 26rpx; }
.err-msg { margin-bottom: 20rpx; }

/* 还差生辰那一屏 */
.wait { padding: 60rpx 0 0; }
.wait-line { font-size: 36rpx; color: var(--ink); line-height: 1.6; }
.wait-note { margin-top: 20rpx; font-size: 26rpx; color: var(--ink-mid); line-height: 1.9; }

.pg { flex: 1; padding-top: 12rpx; }
.pg-hd { display: flex; align-items: baseline; }
.pg-title { font-size: 40rpx; color: var(--ink); }
.pg-lead { margin-left: 16rpx; font-size: 24rpx; color: var(--ink-mid); }
.pg-note { margin-top: 10rpx; font-size: 22rpx; color: var(--stone-label); line-height: 1.7; }

/* 四柱 —— 四张牌并排（0830）。
   原先是四行列表:读起来是一张表，而它是一【盘】。
   牌的样子也让五行色用得上 —— 每张顶一条色带，四张排开就看得出偏在哪一行。 */
.pillars { margin-top: 22rpx; display: flex; gap: 12rpx; }
.pillar {
  flex: 1; min-width: 0;
  background: var(--paper-panel);
  border-radius: 20rpx;
  box-shadow: var(--sh-card);
  padding: 0 0 16rpx;
  overflow: hidden;
  text-align: center;
}
/* 顶上那条色带 = 这一柱的天干五行。
   **不给默认底色** —— 页面样式排在 app.wxss 之后，写了默认值就会把
   `.wx-mu-bg` 那几条盖掉，四条色带全变成同一个灰。
   没有 pinyin 时它就是透明的，那也如实:数据不全就别假装有颜色。 */
.p-bar { height: 10rpx; width: 100%; }
.p-pos { display: block; margin-top: 14rpx; font-size: 21rpx; color: var(--stone-label); }
.p-gz {
  display: block; margin-top: 4rpx;
  font-size: 40rpx; font-weight: 700; color: var(--ink);
  letter-spacing: 0.02em; line-height: 1.15;
}
.p-god { display: block; margin-top: 8rpx; font-size: 23rpx; font-weight: 600; color: var(--ink-mid); }
.p-meta { display: block; margin-top: 3rpx; font-size: 19rpx; color: var(--stone-label); }
/* 藏干竖着排在牌底 —— 横排四张牌里放不下三个词 */
.p-hidden { margin-top: 10rpx; padding: 0 6rpx; }
.p-h { display: block; font-size: 18rpx; color: var(--ink-faint); line-height: 1.55; }
.p-foot { margin-top: 12rpx; font-size: 19rpx; color: var(--stone-label); }

/* 五行条 */
.bars { margin-top: 26rpx; }
.bar { display: flex; align-items: center; margin-bottom: 14rpx; }
.bar-k { width: 44rpx; font-size: 26rpx; color: var(--ink-mid); }
.bar-track { flex: 1; height: 12rpx; background: var(--paper-inset); border-radius: 16rpx; overflow: hidden; }
/* 条按五行上色。原先五根全是墨色 —— 那时这一页说的是「有五个数」，
   而它要说的是「你偏在哪一行」。
   **不设默认底色**:页面样式排在 app.wxss 之后，写了就会把 wx-*-bg 盖掉。 */
.bar-fill { height: 100%; border-radius: 999rpx; }
/* 最高那根加一圈光 —— 答案不该要人自己比一遍 */
.bar-top { box-shadow: 0 0 0 2rpx rgba(255,255,255,.9), 0 2rpx 8rpx rgba(43,38,32,.18); }
.bar-v { width: 56rpx; text-align: right; font-size: 22rpx; color: var(--stone-label); }

.rows { margin-top: 24rpx; }
.row {
  display: flex; align-items: baseline;
  padding: 13rpx 0; border-bottom: 1rpx solid var(--stone-line-x);
}
.row-k { width: 110rpx; font-size: 24rpx; color: var(--stone-label); }
.row-v { flex: 1; font-size: 28rpx; color: var(--ink); }
/* 大运里的当前那格 —— 十格干支谁都排得出，「你在这一格」才是要看的 */
.row-now .row-v { font-weight: 600; }
.row-now-tag {
  font-size: 20rpx; color: var(--paper); background: var(--ink);
  padding: 2rpx 10rpx; border-radius: 16rpx;
}

/* 便签:排盘写给你的一张条子 —— 它不是这一册的正文，
   是夹在里面说明「凭什么这么说」的那张纸。
   暖黄底、一点点厚度、斜 0.6° —— 再多就成了装饰，而它是要读的东西。 */
.quote {
  margin-top: 28rpx; padding: 24rpx 26rpx;
  background: #FFF8E7;
  border-radius: 8rpx;
  transform: rotate(-0.6deg);
  box-shadow: 0 2rpx 6rpx rgba(43,38,32,.09), 0 12rpx 24rpx rgba(43,38,32,.07);
  font-size: 26rpx; color: #6B5A3C; line-height: 1.85;
}

.src { margin-top: 20rpx; font-size: 20rpx; color: var(--stone-label); }

/* 页名一排。当前那个反白 —— 六页里在哪儿一眼看得出 */
.tabs {
  display: flex; margin-top: auto; padding-top: 20rpx;
  border-top: 1rpx solid var(--stone-line-x);
}
.tab {
  flex: 1; text-align: center; font-size: 22rpx;
  color: var(--stone-label); padding: 8rpx 0;
}
.tab-on { color: var(--ink); border-bottom: 2rpx solid var(--ink); }

.acts { display: flex; align-items: center; padding: 20rpx 0 24rpx; }
.turn { font-size: 26rpx; color: var(--ink-mid); }
.turn-off { color: var(--stone-line); }
.turn-back { flex: 1; text-align: center; font-size: 24rpx; color: var(--stone-label); }


/* ── 大运时间轴（0830 §6.6）────────────────────────────────
   原先是十行列表 + 当前那行加粗。列表看得出「有哪些」，看不出「走到哪儿」——
   而后者才是这一页的价值。横着排成一条，当前那格亮起来，一眼就是答案。

   干支竖排两个字:一格四十来像素，横排放不下。 */
.timeline { display: flex; gap: 6rpx; margin-top: 26rpx; align-items: flex-end; }
.tl {
  flex: 1; min-width: 0; text-align: center;
  padding: 14rpx 0 10rpx;
  border-radius: 14rpx;
  background: var(--paper-panel);
  box-shadow: 0 1rpx 3rpx rgba(43,38,32,.05);
}
.tl-gz { font-size: 26rpx; font-weight: 600; color: var(--ink-mid); line-height: 1.25; }
.tl-age { margin-top: 6rpx; font-size: 18rpx; color: var(--stone-label);
          font-variant-numeric: tabular-nums; }
.tl-dot { display: none; }
/* 现在走着的那一格:琥珀、抬起来、底下一个点 */
.tl-now {
  background: linear-gradient(160deg, #FFB463, var(--amber));
  box-shadow: 0 6rpx 16rpx rgba(232,121,26,.32);
  transform: translateY(-6rpx);
  padding: 18rpx 0 14rpx;
}
.tl-now .tl-gz { color: #fff; font-size: 28rpx; font-weight: 700; }
.tl-now .tl-age { color: rgba(255,255,255,.9); font-weight: 600; }
.tl-now .tl-dot {
  display: block; width: 8rpx; height: 8rpx; border-radius: 999rpx;
  background: var(--amber); margin: 8rpx auto 0;
}
