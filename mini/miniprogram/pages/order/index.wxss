.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }
.loading, .err { padding: 80rpx 0; text-align: center; color: var(--stone-label); }
.err-msg { margin-bottom: 28rpx; }
.line { display: flex; justify-content: space-between; align-items: baseline;
        border-top: 1rpx solid var(--stone-line); padding: 24rpx 0; }
.line-name { font-weight: 600; font-size: 32rpx; color: var(--ink); flex: 1; }
.line-qty { font-size: 26rpx; color: var(--stone-label); margin: 0 20rpx; }
.line-sub { font-size: 30rpx; color: var(--ink); }
.sum { border-top: 1rpx solid var(--stone-line); padding-top: 24rpx; margin-top: 8rpx; }
.sum-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.sum-k { font-size: 26rpx; color: var(--stone-label); }
.sum-v { font-weight: 600; font-size: 34rpx; color: var(--ink); }
.note { margin: 28rpx 0; font-size: 26rpx; color: var(--stone-label); }
.cta { display: flex; gap: 20rpx; margin-top: 40rpx; }
.cta .btn { flex: 1; }
.foot-hint { margin-top: 32rpx; text-align: center; font-size: 22rpx; color: var(--stone-label); }

/* 寄出的那些 —— 买了实物（御守）才有；纯报告的单子这一块整个不出现 */
.ship { border-top: 1rpx solid var(--stone-line); margin-top: 32rpx; padding-top: 24rpx; }
.ship-k { font-size: 24rpx; color: var(--stone-label); margin-bottom: 16rpx; }
.pkg { border: 1rpx solid var(--stone-line); border-radius: 16rpx; padding: 22rpx; margin-bottom: 18rpx; }
.pkg-hover { background: var(--paper-inset); }
.pkg-top { display: flex; justify-content: space-between; align-items: baseline; }
.pkg-status { font-weight: 600; font-size: 32rpx; color: var(--ink); }
.pkg-arrow { font-size: 24rpx; color: var(--stone-label); }
.pkg-no { font-size: 22rpx; color: var(--stone-label); margin-top: 10rpx; }
.trace { display: flex; margin-top: 18rpx; font-size: 24rpx; color: var(--stone-label); }
.trace-t { width: 160rpx; flex: none; }
.trace-s { flex: 1; color: var(--ink); }
.trace-l { margin-left: 16rpx; }
.trace-empty { margin-top: 18rpx; font-size: 24rpx; color: var(--stone-label); }

/* 「收到了，去扫开它」（设计册 M3）。扫不出来的那一条跟村子主屏同一套话 */
.wake-alt { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx;
            font-size: 24rpx; color: var(--stone-label); }
.wake-input { flex: 1; background: var(--paper-inset); 
              border-radius: 16rpx; padding: 12rpx 18rpx; font-size: 26rpx; color: var(--ink); }
/* 墨黑那一块是旧色板的残留 —— 这一屏别的东西都是琥珀与米白，
   它一个人黑着，看起来像别的产品掉进来的。它是次要动作（扫不出来时才用），
   所以用浅琥珀，不跟主按钮抢。 */
.wake-go { flex: none; padding: 12rpx 24rpx; border-radius: 16rpx;
           background: var(--amber-lite); color: #8A4A12; font-weight: 600; font-size: 24rpx; }
.wake-err { margin-top: 12rpx; font-size: 24rpx; color: var(--peach); line-height: 1.6; }
.slot-done { margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid var(--stone-line-x);
             font-size: 22rpx; color: var(--stone-label); line-height: 1.7; }

/* 更早那几条（设计册 10.3：一屏八条，超了折叠） */
.trace-more { padding: 10rpx 0 0; font-size: 22rpx; color: var(--stone-label); }

/* 标题 = 买的那个东西；状态与金额并到副行（设计册 M3） */
.hd .title { font-size: 46rpx; line-height: 1.2; }
.hd .sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-faint); letter-spacing: 0.04em; }

/* 这一屏是二级页，底下没有 tab 条 —— 全局那 96rpx 是给 tab 让的位，
   在这儿白占 48px。轨迹要排到八条（10.3），这 48px 正是差的那一截。 */
.page { padding-bottom: 48rpx; }
.hd .title { font-size: 52rpx; }

/* 「收到了，去扫开它」那一组自己排一列：主按钮一行、手输那一行在下面。
   `.cta` 是横排的（两颗按钮并排），把这一组塞进去会让主按钮被挤成
   一列竖着的字 —— 2026-08-28 从截图上看见的。 */
.cta.cta-wake { flex-direction: column; align-items: stretch; }
.cta.cta-wake .btn { flex: none; width: 100%; }

/* 册子那条主按钮。跟「去扫开它」一样排在退款前面 ——
   买家点进这一屏最想做的事是把买的东西拿到手 */
.cta-read { padding-bottom: 8rpx; }


/* ── 0830 ─────────────────────────────────────────────────────
   按钮原先并排在内容底下飘着,而这一屏下面三分之二是空的 ——
   一屏的主动作应该【贴底】,拇指够得到的地方。 */
.page { display: flex; flex-direction: column; }
/* 只有【最靠上】那一组顶开剩余高度，后面的紧跟着它 ——
   原先每一组都是 auto，于是空白在几组之间对半分:
   一颗按钮、三百五十像素的空、又一颗按钮。
   `~` 选的是「前面还有一组 .cta 的那些」，也就是除第一组之外的全部;
   两个类名的权重压得过上面那一条。 */
.cta { margin-top: auto; }
.cta ~ .cta { margin-top: 24rpx; }
/* 主按钮全宽,次要的两颗并排在它下面。三颗一样大 = 没有主次 */
.cta .btn { flex: none; width: 100%; box-sizing: border-box; }
.cta { flex-wrap: wrap; }
.cta .btn.ghost { width: calc(50% - 10rpx); }
.cta-read { padding-bottom: 8rpx; }
/* 写成 `.cta.cta-read`（三个类）才压得过上面的 `.cta .btn.ghost` ——
   否则这一颗降成次要之后会缩成半宽、孤零零占着左半边，像没排完。 */
.cta.cta-read .btn { width: 100%; }

/* 御守那一单摆上他的脸（0830 标尺 §1.5.2 沉浸感）。
   底色由 `.face-<方向>`（app.wxss）给 —— 这里不写 background（门禁盯着）。 */
.hd.hd-who { display: flex; align-items: center; gap: 22rpx; }
.hd-who .who-face {
  flex: none; width: 96rpx; height: 96rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; font-weight: 700;
}
.hd-who .hd-body { flex: 1; min-width: 0; }
