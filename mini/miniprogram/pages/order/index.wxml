<view class="page">
  <!-- 标题是【买的那个东西】，不是状态词（设计册 M3 线框：
       「婆婆的御守 / ¥99 · 8/18 下单 · 已付」）。原先反过来：
       大字写着「已付」，而买的是什么要往下看一块。
       状态跟金额、日期一样是这一单的属性，它们一行说完就够。

       并成一行还腾出了地方：轨迹要能排到八条（10.3），
       而八条轨迹加上原先那三块，这一屏装不下（实测超 157px）。 -->
  <!-- 御守那一单摆上他的脸。标题已经说了「丹增的御守」，
       但这一屏此前【一张脸都没有】—— 而从商品页到确认屏都有他。
       买了别的（香、报告）就没有这一格，照旧只有标题。 -->
  <view class="hd {{who ? 'hd-who' : ''}}">
    <view class="who-face face-{{who.direction}} {{who.脸样 ? 'face-art' : ''}}" wx:if="{{who}}" style="{{who.脸样}}"><text wx:if="{{!who.脸样}}">{{who.face}}</text></view>
    <view class="hd-body">
    <view class="title">{{headline || '　'}}</view>
    <!-- 取不到时不显示这一行：三个字段都空的话它会渲成「· 下单 ·」，
         一串没有意义的分隔符。标题区照常在（不许整屏换错误页），
         但不该在那儿摆一句假话。 -->
    <view class="sub" wx:if="{{statusText}}">{{totalText}} · {{whenText}}下单 · {{statusText}}</view>
    </view>
  </view>
  <view class="hr"></view>

  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card"><view class="sk-body">
      <view class="sk sk-line long"></view><view class="sk sk-line short"></view>
    </view></view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="load">再试一次</button>
  </view>

  <block wx:else>
    <!-- 【走到哪儿】。这一页原先在最常见的情况下（买一件、还没付、没有物流）
         整屏只有标题、金额、状态三行，中间七百多像素全空 ——
         而人点进来就是想知道这一单现在怎么样、接下来会怎样。
         这里【不放 flexslot】：那个槽在 699px 以下整个隐藏，
         而参照机 iPhone SE 正好在那以下，等于给最该看到的人看不见。 -->
    <!-- 展开详细轨迹时收起它:两者说的是同一件事（这单走到哪儿），
         一个粗一个细。同时摆着不只是挤 —— 十二条轨迹的单子会被顶出屏外，
         而顶出去的那一截在真机上的样子是【底下看不见】，不是报错。 -->
    <view class="track" wx:if="{{!traceOf}}">
      <view wx:for="{{走到哪儿}}" wx:key="t" class="tk tk-{{item.s}}">
        <view class="tk-dot"></view>
        <view class="tk-t">{{item.t}}</view>
      </view>
    </view>

    <!-- 【下一步等什么】。进度线说得出「在哪儿」，说不出「接下来会怎样」——
         而人点进订单就是想知道这两件。这一句按【买了会发生什么】分三种，
         判据来自 becomes_resident 与这一单有没有册子，不在这里猜。 -->
    <view class="nextline" wx:if="{{下一步 && !traceOf}}">{{下一步}}</view>

    <!-- 【这一单有时限】。三十分钟不付，系统自己取消（order.rs 建单时写的
         `expires_at`，payment_sweep 到点扫）。屏上原先一个字都没说 ——
         而旁边就是「不要这一单了」那条文字链，过期之后状态变「已取消」，
         买家最容易的理解是「我手滑点了它」（2026-09-01 第二轮评审 · 转化路）。 -->
    <view class="ttl" wx:if="{{还有多久 && !traceOf}}">{{还有多久}}</view>

    <!-- 订单号。这一屏原先没有任何能报给客服的东西 ——
         出了事人只能说「我买的那个说明书」。长按可复制。

         【只露前八位】（2026-09-02 第四轮评审 · 第一次来的人）。
         整串是 `ord-` 加一个 uuid，四十个字符;原样摆在屏上，
         人读到的是「开发者的东西漏出来了」，而这一屏是催他付钱的。
         八位十六进制够客服定位到唯一一单（四十亿分之一），
         长按复制的仍然是整串 —— 要精确的时候拿得到。 -->
    <view class="ordno" wx:if="{{!traceOf}}" bindlongpress="onCopyId">单号 {{短单号}}　长按复制</view>

    <!-- 多件时才逐行列。单件的话标题已经说了是什么，再列一遍是重复。 -->
    <view class="lines" wx:if="{{lines.length > 1}}">
      <view wx:for="{{lines}}" wx:key="name" class="line">
        <text class="line-name">{{item.name}}</text>
        <text class="line-qty">×{{item.qty}}</text>
        <text class="line-sub">{{item.sub}}</text>
      </view>
    </view>

    <!-- 「已付」只在跟合计对不上时才说（部分退款、还没付）。
         两个数一样时并排写两遍，读的人得比一比才知道没事。 -->
    <!-- 「已付」只在【付过一部分、又跟合计对不上】时才说。
         原先的判据是「跟合计不一样」—— 一分没付时 ¥0.00 ≠ ¥199 也成立，
         于是待付的单子上多一行「已付 ¥0.00」，那是噪音不是信息 -->
    <view class="sum" wx:if="{{paidMinor > 0 && paidText !== totalText}}">
      <view class="sum-row"><text class="sum-k">已付</text><text class="sum-v">{{paidText}}</text></view>
    </view>

    <view class="ship" wx:if="{{shipErr}}">
      <view class="ship-k">寄出</view>
      <view class="pkg-no">{{shipErr}}</view>
      <text class="pkg-arrow" bindtap="loadShipments" hover-class="press-text" hover-stay-time="80">再试一次</text>
    </view>

    <view class="ship" wx:elif="{{shipments.length}}">
      <view class="ship-k">寄出</view>
      <view wx:for="{{shipments}}" wx:key="id" class="pkg"
            data-sid="{{item.id}}" bindtap="onTrace"
            hover-class="pkg-hover" hover-stay-time="100">
        <view class="pkg-top">
          <text class="pkg-status">{{item.statusText}}</text>
          <text class="pkg-arrow">{{traceOf === item.id ? '收起' : '看轨迹'}}</text>
        </view>
        <view class="pkg-no" wx:if="{{item.tracking_no}}">
          {{item.carrier_code}} · {{item.tracking_no}}
        </view>
        <view class="pkg-no" wx:else>还没有单号</view>

        <block wx:if="{{traceOf === item.id}}">
          <view wx:for="{{trace}}" wx:for-item="ev" wx:key="时间" class="trace">
            <text class="trace-t">{{ev.时间}}</text>
            <text class="trace-s">{{ev.说}}</text>
            <text class="trace-l" wx:if="{{ev.在}}">{{ev.在}}</text>
          </view>
          <!-- 超过八条的那几条不显示，但要说一声（设计册 10.3）。
               默不作声地少几条，跟「就这些」长得一模一样。 -->
          <view class="trace-more" wx:if="{{traceMore > 0}}">更早还有 {{traceMore}} 条</view>
          <view class="trace-empty" wx:if="{{trace.length === 0}}">还没有轨迹</view>
        </block>
      </view>
    </view>

    <view class="note" wx:if="{{note}}">{{note}}</view>

    <!-- 【这一单真正完成的样子:他住进来了】（2026-09-01 第二轮评审 · 转化路）。
         这个位置原先是「收到了，去扫一下」加一个手输编号的输入框 ——
         两样都够不着任何东西:买御守不寄实物、不发凭据，后端在付款那一刻
         直接让他搬进村里。那颗按钮按下去只会扫无可扫。
         扫护身符那条路仍在村子主屏（连手输编号一起），
         那是【线下拿到实体御守的人】走的，跟这一单无关。 -->
    <view class="cta cta-visit" wx:if="{{住下了 && who}}">
      <button class="btn" bindtap="onVisit">去{{who.name}}屋里看看</button>
    </view>

    <!-- 买的是说明书的话，主按钮是「读你的说明书」。
         **订单的完成态不是「已付」，是你读到了** —— 跟御守那条同一个道理。
         还差生辰的也给这个按钮：进去那一屏说得清还差什么、去哪儿填，
         而不是在这里显示「已完成」让买家以为东西已经到手了。 -->
    <!-- 还没付钱时它降成次要：这一屏的主按钮只能有一颗，
         而那一颗永远是【下一步该做的那件事】。两颗橙的并排放着，
         等于让买家自己猜先按哪个。 -->
    <!-- 【2026-09-01】待付的单子上不摆「读你的说明书」。
         报告是履约之后才建的（unmei-app/src/report.rs），付款之前
         这颗按钮按下去只会失望;而它原先【压在主按钮「去支付」的上面】,
         次要动作排在主动作前面。付过了才摆它。 -->
    <!-- 还要 `!住下了`：他刚住进来的时候，这一屏的主按钮是「去他屋里看看」。
         两颗实心按钮并排，等于让人自己挑先做哪件。
         那时这一册照样从「我的 › 我买过的」进得去，只是不占这一屏的主位。 -->
    <view class="cta cta-read" wx:if="{{report && status !== 'unpaid' && !住下了}}">
      <button class="btn" bindtap="onRead">
        {{report.status === 'ready' ? '读你的说明书' : '这份说明书还差你的出生时间'}}
      </button>
    </view>

    <view class="cta">
      <!-- 「去支付」跟上面那颗「去他屋里看看」**结构上互斥**:
           没付钱的单子不可能有人住进来。数据上两颗已经不会同时为真 ——
           但那是数据在保证，不是结构在保证，而下一个改这个判据的人
           不会知道这一屏押着它。`!住下了` 写在这儿，两颗就永远只出现一颗。 -->
      <button wx:if="{{status === 'unpaid' && !住下了}}" class="btn" bindtap="onPay" disabled="{{paying}}">
        <!-- 【一个动作一个词】。确认屏、订单列表、我的·最近一笔
             三处都写「去付」，只有这一处写「去支付」。 -->
        {{paying ? '发起中……' : '去付'}}
      </button>
      <!-- 「不要了」是【不可逆】的，而它原先跟「回去」同色同宽同高，
           并排摆着 —— 一次误触没掉一张单。破坏性动作不该长得像
           旁边那颗无害的按钮:降成一行文字链，并且点下去有二次确认
           （order/index.ts 的 onCancel）。 -->
      <view wx:if="{{status === 'unpaid'}}" class="cta-drop" bindtap="onCancel" hover-class="press-text" hover-stay-time="80">不要这一单了</view>
      <button wx:if="{{status === 'paid' || status === 'fulfilling' || status === 'done'}}"
              class="btn ghost" bindtap="onRefund" disabled="{{refunding}}">
        {{refunding ? '申请中……' : '申请退款'}}
      </button>
      <button class="btn ghost" bindtap="onBack">回去</button>
    </view>

    <!-- 弹性槽（设计册 M3）：说清这一单什么时候才算真的完成 -->
    <view class="flexslot slot-done" wx:if="{{住下了 && who}}">{{who.name}}已经在村里那一格住下了 —— 这单到此为止</view>

    <!-- 进弹性槽：这是给在网页版上验的人看的说明，不是买家要读的 -->
    <view class="foot-hint flexslot">支付要在微信里完成 · 移动网页版上到这一步为止</view>
  </block>
</view>
