/* 沿用全局那几个变量与 .page / .hd / .btn，不另起一套 */
.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1.1; margin: 8rpx 0 16rpx; }

.loading, .err { padding: 80rpx 0; text-align: center; color: var(--stone-label); }
.err-msg { margin-bottom: 28rpx; }

.sub {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--stone-label);
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.price-row { margin: 8rpx 0 28rpx; }
.price {
  font-weight: 600;
  font-size: 60rpx;
  color: var(--ink);
}
.price-none { font-size: 28rpx; color: var(--stone-label); }

.tags { margin-bottom: 28rpx; }
.tag {
  display: inline-block;
  font-size: 24rpx;
  color: var(--stone-label);
  border: 1rpx solid var(--stone-line);
  border-radius: 16rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.desc {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.9;
  margin-bottom: 32rpx;
}

.ship {
  font-size: 26rpx;
  color: var(--stone-label);
  line-height: 1.8;
  border-top: 1rpx solid var(--stone-line);
  padding-top: 24rpx;
  margin-bottom: 40rpx;
}

/* 按钮组跟上面留出距离 —— 加了「你会收到」三条之后它贴了上去，
   第三条的副标题被压在按钮下面（截图上看见的）。 */
.cta { display: flex; gap: 20rpx; margin-top: 34rpx; }
/* 「请他回家」是主，「回去」是次 —— 等宽会读成两个并列的选择。 */
.cta .btn { flex: 2; }
.cta .btn.ghost { flex: 1; }

.foot-hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--stone-label);
}

.note { margin: 20rpx 0; font-size: 26rpx; color: var(--stone-label); }

/* 0830 标尺 §1.5.3：御守是一个人，所以这一屏的第一眼是他，不是「一件商品」。
   底色由 `.face-<方向>`（app.wxss）给 —— 这里不写 background（门禁盯着）。 */
.hd.who { display: flex; align-items: center; gap: 24rpx; }
.who-face {
  flex: none; width: 112rpx; height: 112rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 50rpx; font-weight: 700;
  box-shadow: 0 0 0 10rpx rgba(255,154,60,.10), 0 8rpx 22rpx rgba(232,121,26,.20);
}
.who-body { flex: 1; min-width: 0; }
.who-sub { margin-top: 6rpx; font-size: 25rpx; color: var(--ink-faint); }

/* ── 你会收到什么 ─────────────────────────────────────────
   花这笔钱的决策屏原先只有一行小灰字把三件事挤在一起，底下半屏空着。 */
.gets { margin-top: 30rpx; padding-top: 26rpx; border-top: 1rpx solid var(--stone-line-x); }
.gets-k { font-size: 24rpx; color: var(--ink-faint); margin-bottom: 20rpx; }
.gets-row { display: flex; align-items: flex-start; gap: 18rpx; margin-bottom: 22rpx; }
.gets-row:last-child { margin-bottom: 0; }
.gets-n {
  flex: none; width: 40rpx; height: 40rpx; margin-top: 2rpx;
  border-radius: 999rpx; background: var(--amber-lite);
  color: var(--amber-deep); font-size: 23rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.gets-b { flex: 1; min-width: 0; }
.gets-t { font-size: 28rpx; font-weight: 600; color: var(--ink); line-height: 1.45; }
.gets-s { font-size: 23rpx; color: var(--ink-faint); margin-top: 5rpx; line-height: 1.5; }
