.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }
/* 副标题跟「我买过的」同一档字号与颜色 —— 同一组的两屏不该各写一套 */
.hd .sub { font-size: 24rpx; color: var(--ink-faint); margin-top: 12rpx; }

.cats { margin-bottom: 32rpx; }
.cat {
  display: inline-block;
  font-size: 26rpx;
  color: var(--stone-label);
  border: 1rpx solid var(--stone-line-ui);
  border-radius: 16rpx;
  padding: 8rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.cat-on { color: var(--ink); border-color: var(--ink); }

.loading, .err, .empty { padding: 80rpx 0; text-align: center; color: var(--stone-label); }
/* 圆牌居中 —— `.empty-art` 的底色与字号在 app.wxss，这里只管摆放 */
.empty { display: flex; flex-direction: column; align-items: center; }

/* 「回去」贴底。`.page` 得是纵向 flex，`margin-top: auto` 才顶得开。
   高度【不要】在这儿写 —— app.wxss 已经给了 `min-height: 100vh`，
   这里再写一个 100% 会把它盖掉（页面样式排在后面），
   而 100% 的父级没有高度，于是按钮跟在内容后面、底下空五百像素。 */
.page { display: flex; flex-direction: column; }
/* 【贴底，但不拉开太远】。`.page` 是 `min-height: 100vh`（全局），
   配上 `margin-top: auto` 就把这颗按钮顶到视口底 —— 在 iPhone SE 上
   正好，在长屏（14 / ProMax）上会在内容与按钮之间撑出三到五百像素，
   一屏看着像没做完。而那片空白只在长屏出现，我一直只看最矮那一档，
   所以从没见过它。

   `margin-bottom: auto` 让上下两段弹性平分那段富余：按钮不再钉死在
   视口底，而是跟着内容往下留一段。矮屏上富余是 0，行为不变。 */
.cta { margin-top: auto; margin-bottom: auto; padding-top: 40rpx; }
.cta .btn { width: 100%; box-sizing: border-box; }
.err-msg { margin-bottom: 28rpx; }

/* 【卡片，不是表格行】（2026-09-05）。「我买过的」那一屏的注释写着:
   「横线是文档的语言，卡片是物件的语言，而一笔订单是一件东西」——
   一份订阅同样是一件东西，而这一屏一直是三条细线分出来的行。
   同一组的两个入口，一屏是物件、一屏是表格，读起来像后者没做完。
   （0830 版 §3.4「从表格到东西」；那一批只落到了「我买过的」。） */
.list, .offers { display: flex; flex-direction: column; gap: 14rpx; }
.item {
  background: var(--paper-panel);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  padding: 22rpx 24rpx;
  transition: transform .12s cubic-bezier(.34,1.56,.64,1);
}
.item-name { font-weight: 600; font-size: 32rpx; color: var(--ink); }
.item-sub { font-size: 26rpx; color: var(--stone-label); margin-top: 10rpx; line-height: 1.6; }
.item-meta { font-size: 22rpx; color: var(--stone-label); margin-top: 12rpx; }
.arrow { float: right; }

.more {
  border-top: 1rpx solid var(--stone-line);
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--stone-label);
}

/* 订着的：空状态是主设计，出口比列表更重要。 */
.empty-t { font-size: 30rpx; font-weight: 600; }
.empty-sub { font-size: 26rpx; color: var(--ink-faint); margin-top: 12rpx; }
.offers { margin-top: 44rpx; }
.offers-k { font-size: 26rpx; color: var(--ink-faint); }
.offers-err { font-size: 26rpx; color: var(--ink-faint); margin-top: 32rpx; }

/* 能订的那一条右边:价在动作前面 —— 决定按不按的是它。 */
.item-meta { display: flex; align-items: baseline; gap: 12rpx; }
.item-price { font-size: 28rpx; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }

/* 扣不成的那两种（past_due / grace）。灰色的一行读起来跟「订着」一样平，
   而这两种是【他现在就得动手】的 —— 不显眼等于没说。 */
.item-meta.meta-hot { color: var(--peach-text); }

/* 卡上那一个动作。
   「补上这一期」是这一屏唯一花钱的动作，给它主色;
   「不再续了」是退出的动作，压成灰的一行 —— 两个一样重的话，
   眼睛就分不出哪个是这张卡在等他做的事。
   两个都撑到 44px 高（`check-tap-size.py` 那条线）。 */
.item-do {
  margin-top: 18rpx;
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--peach-text);
}
.item-do.do-quiet { font-weight: 400; color: var(--ink-faint); }
