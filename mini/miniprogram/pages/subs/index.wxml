<view class="page">
  <view class="hd">
    <view class="title">订着的</view>
    <view class="hr"></view>
  </view>

  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card"><view class="sk-body">
      <view class="sk sk-line mid"></view><view class="sk sk-line short"></view>
    </view></view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="load">再试一次</button>
  </view>

  <block wx:else>
    <view class="list" wx:if="{{subs.length > 0}}">
      <view wx:for="{{subs}}" wx:key="id" class="item">
        <view class="item-name">{{item.plan_id || item.id}}</view>
        <view class="item-meta">{{item.status}}<text wx:if="{{item.current_period_end}}"> · 到 {{item.current_period_end}}</text></view>
      </view>
    </view>

    <block wx:else>
      <!-- 「下面是哪儿能有」得下面**真的有**才说得出口。
           2026-08-28 唯一那件可订的商品下架之后，这一屏成了
           一句「下面是哪儿能有」跟着一片空白 —— 设计册 10.7 说空状态要
           指出去处，指向空白比不指更糟。 -->
      <view class="empty">
        <!-- 圆牌跟「我买过的」那一屏同一套 —— 同一组入口里，
             一屏有插画一屏没有，读起来像后者没做完 -->
        <view class="empty-art">订</view>
        <view class="empty-t">还没有订着的</view>
        <view class="empty-sub" wx:if="{{offers.length > 0}}">空着不是问题 —— 下面是哪儿能有</view>
        <view class="empty-sub" wx:elif="{{!offersErr}}">村里现在没有可以订的东西 · 等有了会摆在这儿</view>
      </view>

      <view class="offers" wx:if="{{offers.length > 0}}">
        <view class="offers-k">村里现在有这些可以订</view>
        <view wx:for="{{offers}}" wx:key="id" class="item"
              data-id="{{item.id}}" bindtap="onTap"
              hover-class="item-hover" hover-stay-time="100">
          <view class="item-name">{{item.name}}</view>
          <view class="item-sub" wx:if="{{item.sub_title}}">{{item.sub_title}}</view>
          <view class="item-meta">看看 <text class="arrow">›</text></view>
        </view>
      </view>
      <view class="offers-err" wx:elif="{{offersErr}}">{{offersErr}}</view>
    </block>
  </block>

  <!-- 「回去」。`onBack` 一直在，只是没有一颗按钮按得到它 ——
       同一组入口里「我得到的」有这一颗，这一屏没有。
       真机上那条原生导航栏带返回箭头，所以它不是死路，但两屏该一样。 -->
  <view class="cta">
    <button class="btn ghost" bindtap="onBack">回去</button>
  </view>
</view>
