.page { padding: 32rpx 40rpx 40rpx; }
.card { padding: 24rpx; background: var(--paper-inset); }
.card-name { font-size: 34rpx; font-weight: 700; }
.card-sub { font-size: 24rpx; color: var(--ink-faint); margin-top: 8rpx; }
/* 钱用墨色，不用桃粉。0830 §3.2：桃粉是「喜欢」那一档，压不住价格。
   这里原是旧的暗红 #9a3b3b，统一换色时被一并映射成了桃粉 */
.card-price { font-size: 34rpx; font-weight: 700; color: var(--ink); margin-top: 16rpx;
              font-variant-numeric: tabular-nums; }
.hr { height: 1rpx; background: var(--stone-line-x); margin: 28rpx 0; }
.row { display: flex; justify-content: space-between; align-items: center;
       padding: 22rpx 0; border-bottom: 1rpx solid var(--paper-inset); }
.row.col { display: block; }
.row-k { font-size: 28rpx; }
.row-v { font-size: 26rpx; color: #555; max-width: 60%; text-align: right; }
.dim { color: #999; }
.stepper { display: flex; align-items: center; gap: 24rpx; }
.step { font-size: 34rpx; width: 56rpx; text-align: center; }
.step-off { opacity: .3; }
.step-n { font-size: 30rpx; min-width: 48rpx; text-align: center; }
.msg { margin-top: 16rpx; font-size: 28rpx; padding: 12rpx 0; border-bottom: 1rpx solid var(--stone-line-x); }
.sum-k { font-size: 24rpx; color: var(--ink-faint); margin-bottom: 8rpx; }
.note { font-size: 26rpx; color: var(--peach); margin-top: 16rpx; }
.pay { display: flex; justify-content: space-between; align-items: center; margin-top: 40rpx; }
.pay-total { font-size: 34rpx; font-weight: 700; }
.foot { font-size: 24rpx; color: var(--ink-faint); margin-top: 20rpx; }


/* ── 0830 ────────────────────────────────────────────────────
   留言那一行原先是「标签 + 一个黑框输入框」，两者挤在一起、还压着标签。
   输入框按这一版的调子来：凹陷的浅底、无边框、圆角。 */
.row .msg, .msg {
  flex: 1;
  margin-left: 20rpx;
  background: var(--paper-inset);
  
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  color: var(--ink);
  min-width: 0;
}
/* 「去付」是这一屏的动作，给它整行的分量 */
.sum-act { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.sum-act .btn { flex: none; }

/* 御守那一张卡上摆人（0830 标尺 §1.5.2）。
   底色由 `.face-<方向>`（app.wxss）给 —— 这里不写 background（门禁盯着） */
.card-who { display: flex; align-items: center; gap: 22rpx; }
.card-who .who-face {
  flex: none; width: 96rpx; height: 96rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; font-weight: 700;
}
.card-who .who-body { flex: 1; min-width: 0; }

/* 没填「寄到哪」时按钮待命 —— 满橙的大按钮长得跟能按一样。
   要写成 `button.btn.btn-wait`：app.wxss 里是 `button.btn`（标签 + 类），
   单个 `.btn-wait` 压不过它，症状是「这条 CSS 像没写」。 */
button.btn.btn-wait { background: #EADFCD; color: #A08E74; box-shadow: none; }
