<view class="page">
  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card"><view class="sk-body">
      <view class="sk sk-line mid"></view><view class="sk sk-line long"></view>
    </view></view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="onBack">回去</button>
  </view>

  <block wx:else>
    <!-- 御守是一个人。上一屏还是「丹增 · 下山的武僧」，这一屏原先只剩
         「御守 ¥99」—— 你以为在请一个人，付钱前发现在买一件货
         （标尺 §1.5.2 沉浸感）。有人就摆人，没有就照旧摆商品。 -->
    <view class="card card-who" wx:if="{{p.villager && 住进来}}">
      <view class="who-face face-{{p.villager.direction}} {{脸样 ? 'face-art' : ''}}" style="{{脸样}}"><text wx:if="{{!脸样}}">{{face}}</text></view>
      <view class="who-body">
        <view class="card-name">{{p.villager.name}}的御守</view>
        <view class="card-sub">{{p.villager.title}}<text wx:if="{{p.villager.art}}"> · {{p.villager.art}}</text></view>
        <view class="card-price">{{unitText}}</view>
      </view>
    </view>
    <view class="card card-who" wx:elif="{{p.villager}}">
      <view class="who-face face-{{p.villager.direction}} {{脸样 ? 'face-art' : ''}}" style="{{脸样}}"><text wx:if="{{!脸样}}">{{face}}</text></view>
      <view class="who-body">
        <view class="card-name">{{p.product.name}}</view>
        <view class="card-sub">{{p.villager.name}}那儿的<text wx:if="{{p.villager.title}}"> · {{p.villager.title}}</text></view>
        <view class="card-price">{{unitText}}</view>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="card-name">{{p.product.name}}</view>
      <view class="card-sub" wx:if="{{p.product.sub_title}}">{{p.product.sub_title}}</view>
      <view class="card-price">{{unitText}}</view>
    </view>

    <view class="hr"></view>

    <!-- 寄到哪。微信地址簿只有真机有 —— 网页版会说这台设备上没有，不假装填好 -->
    <!-- 【只有真要寄的那一件问这个】。御守付完那位就搬进村里、说明书是算出来的，
         两样都没有包裹 —— 而上一版对每一件都要地址，等于在主推的那一件前面
         摆了一道跟它无关的坎（2026-09-01 第二轮评审 · 转化路）。 -->
    <block wx:if="{{要寄}}">
      <view class="row" bindtap="chooseAddr" hover-class="press-card" hover-stay-time="80">
        <text class="row-k">寄到</text>
        <text class="row-v" wx:if="{{contact}}">{{contact.name}} · {{contact.phone}} · {{contact.address}}</text>
        <text class="row-v dim" wx:else>还没填 ›</text>
      </view>
      <view class="note" wx:if="{{addrNote}}">{{addrNote}}</view>
    </block>

    <!-- 【御守不摆数量】。它是把一位具体的人请进村里那一格 ——
         数量填 2 等于请两个婆婆，而村里只有一个婆婆、一格屋子。
         摆一个填了没意义的字段，比不摆更让人犹豫:人会停下来想
         「填 2 会怎样」，而那个问题没有答案。香和别的实物照旧摆。 -->
    <!-- 【订阅也不摆数量】（2026-09-06 · 五路体验走查）。
         按月送的香填 2 是什么意思？每月寄两盒、还是订两份？——
         这个问题屏上答不了，而后端 `renew_due` 每期就发一件。
         摆一个填了没意义的字段，比不摆更让人犹豫。 -->
    <view class="row" wx:if="{{!住进来 && !订阅}}">
      <text class="row-k">数量</text>
      <view class="stepper">
        <text class="step {{qty <= 1 ? 'step-off' : ''}}" bindtap="minus" hover-class="press-btn" hover-stay-time="80">−</text>
        <text class="step-n">{{qty}}</text>
        <text class="step" bindtap="plus" hover-class="press-btn" hover-stay-time="80">＋</text>
      </view>
    </view>

    <view class="row col">
      <text class="row-k">留句话</text>
      <input class="msg" value="{{message}}" placeholder="不写也行" bindinput="onMessage"/>
    </view>

    <view class="hr"></view>

    <view class="sum-k">算下来</view>
    <!-- 【明细里的名字跟卡片上那个一样】。上头卡片写着「婆婆的御守」，
         这一行却写「御守 × 1」—— 同一屏两个名字，读的人得比一比才知道
         说的是同一件（2026-09-01 第二轮评审 · 转化路）。
         判据跟卡片同一个（`p.villager && 住进来`），不另起一套。 -->
    <view class="row">
      <text class="row-k" wx:if="{{p.villager && 住进来}}">{{p.villager.name}}的御守 × {{qty}}</text>
      <!-- 【多档的那几件要写清是哪一档】（2026-09-06 · 五路体验走查）。
           香有三档（三支 ¥29 / 十支 ¥88 / 单配 ¥268），而这一行原先写的是
           商品名「苏合配的那一味 × 1　¥29」—— 「试香 · 三支」这五个字
           在整条掏钱的路上一次都没出现过，而正文写着「十支约够一个月」。 -->
      <text class="row-k" wx:elif="{{档名}}">{{档名}} × {{qty}}</text>
      <text class="row-k" wx:else>{{p.product.name}} × {{qty}}</text>
      <text class="row-v">{{totalText}}</text>
    </view>
    <!-- 【不列运费】。后端算总价是 `let total = subtotal`，压根没有运费这回事，
         而「另算 · 以订单为准」把结账屏上最不能含糊的那个数变成了约数：
         写着「一共 ¥99」，下面又说还有一笔说不准的。包邮就直说包邮。 -->
    <!-- 不寄的那几件连运费这一行都不该有:没有包裹就谈不上包邮 -->
    <view class="row" wx:if="{{要寄}}"><text class="row-k">运费</text><text class="row-v">包邮</text></view>

    <!-- 【券码】。输完点一下「试试」，服务端算完当场显示减了多少 ——
         折扣只有服务端算得准（封顶、余额、活动有效期），
         而人是看着这个数按下付款的。
         减多少显示在下面单独一行，不去改上面那个「一共」：
         那一行说的是这些东西本身值多少，两件事分开读。 -->
    <view class="row row-coupon">
      <text class="row-k">优惠券</text>
      <!-- 【他手里有的，摆出来让他点】（2026-09-05）。这一格原先只收码 ——
           也就是【他得先知道那串码】。而运营发的券绑在他账号上，
           系统一直知道有哪几张，只是从没说过。

           摆在【这一行里面】，不另起一块:这一屏放东西的地方是满的
           （实测内容 633px，一屏 667px，用上券之后那一行「这张券减」
           就已经把它顶出去 11px 了）。另起一块要 69px，一块都放不下。
           所以券条占的是输入框那个位子 —— 要手打别处的码，点「填码」换回来。

           先到期的那张排在最前（后端 `GET /v1/coupons` 那边排的），
           这一格默认摆的就是它:该先花掉的正是它。 -->
      <block wx:if="{{我的券.length > 0 && !手填}}">
        <view class="coupon-pick {{券状态 === '用上了' ? 'pick-on' : ''}}"
              bindtap="用这张" hover-class="press-btn" hover-stay-time="80">
          {{券状态 === '在算' ? '在算…' : 当前券面}}
        </view>
        <text class="coupon-try" wx:if="{{我的券.length > 1}}"
              hover-class="press-btn" bindtap="换一张">换一张</text>
        <text class="coupon-try" hover-class="press-btn" bindtap="要手填">填码</text>
      </block>
      <block wx:else>
        <input
          class="coupon-in"
          placeholder="有券码就填这儿"
          value="{{券码}}"
          bindinput="券码输入"
          confirm-type="done"
          bindconfirm="试券" />
        <!-- 【这颗一直在】。上一版加了 `wx:if="{{券码}}"` —— 输入框空着时
             它不存在，于是人先看到一个孤零零的输入框，输完字才冒出一颗按钮，
             那一下的跳动比省下来的那点干净更贵。
             空着时它自己什么都不做（`试券` 里第一句就返回）。 -->
        <text class="coupon-try" hover-class="press-btn" bindtap="试券">
          {{券状态 === '在算' ? '在算…' : '试试'}}
        </text>
      </block>
    </view>
    <view class="row row-off" wx:if="{{券状态 === '用上了'}}">
      <text class="row-k">这张券减</text>
      <text class="row-v off">− {{减了文本}}</text>
    </view>
    <view class="coupon-bad" wx:if="{{券状态 === '不行'}}">{{券说}}</view>

    <view class="note" wx:if="{{note}}">{{note}}</view>

    <!-- 底下这一块钉在屏底（见 wxss 里 `.pay`）。
         读的顺序跟看到的顺序一致:先「付完会怎样」，再「一共多少 · 去付」。

         【两块合成一块】（2026-09-02 第四轮评审 · 两路各自量到）。
         原先「付完会怎样」是另一个 `position: fixed`，靠
         `bottom: 112rpx` 去躲成交栏 —— 而成交栏实测高 66px（132rpx），
         于是那行字的下半截被压掉 10px，就在付款那一屏上。
         偏移量写死就一定会跟另一块的高度失联;放进同一个容器，
         它自己堆在成交栏上面，两块怎么长都不会打架。 -->
    <view class="pay">
      <view class="foot">{{付完呢}}</view>
      <view class="pay-row">
      <!-- 用上券之后这里说的是【实付】。上面那一行「这张券减」
           已经把过程说清楚了，成交按钮旁边只该有一个数。 -->
      <view class="pay-total">一共 {{券状态 === '用上了' ? 实付文本 : totalText}}</view>
      <!-- 没填【寄到哪】时按钮待命。满橙的大按钮长得跟能按一样，
           而这是实物：没有地址寄不出去。仍然可以按 —— 按了就地说差什么，
           不是禁掉让人猜为什么按不动（跟填出生时间那一屏一致）。 -->
      <!-- 【2026-09-01】没地址时这颗【直接做那件该做的事】。
           原先它是灰的（btn-wait）、87px 宽，缩在右下角:整屏唯一的成交按钮
           长得跟禁用一模一样，而真正的拦路条件「寄到 还没填」在上面那一行，
           用的是跟「数量」「留句话」同一种灰，没有任何提示。
           人会按几次、什么都不发生，然后退出去（五路评审里两路都点了这条）。
           现在它说的就是下一步:按下去弹地址簿。 -->
      <!-- 处理器名写死成 `go`，由它自己判断该弹地址簿还是该建单。
           原先写的是 `bindtap="{{有地址 ? 'go' : 'chooseAddr'}}"` ——
           动态处理器名在镜像的垫片里【不求值】，绑上去的是那串花括号本身，
           于是按钮点了什么都不发生。真机支不支持是一回事，
           一颗按钮两个处理器本来就比一个处理器两条路难读。 -->
      <button class="btn" bindtap="go" disabled="{{buying}}">
        <block wx:if="{{buying}}">建单中…</block>
        <block wx:elif="{{!要寄 || 有地址}}">去付</block>
        <block wx:else>先填寄到哪儿</block>
      </button>
      </view>
    </view>
  </block>
</view>
