<view class="page">
  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card"><view class="sk-body">
      <view class="sk sk-line mid"></view><view class="sk sk-line long"></view>
    </view></view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="onBack">回去</button>
  </view>

  <block wx:else>
    <!-- 御守是一个人。上一屏还是「丹增 · 下山的武僧」，这一屏原先只剩
         「御守 ¥99」—— 你以为在请一个人，付钱前发现在买一件货
         （标尺 §1.5.2 沉浸感）。有人就摆人，没有就照旧摆商品。 -->
    <view class="card card-who" wx:if="{{p.villager}}">
      <view class="who-face face-{{p.villager.direction}}">{{face}}</view>
      <view class="who-body">
        <view class="card-name">{{p.villager.name}}的御守</view>
        <view class="card-sub">{{p.villager.title}}<text wx:if="{{p.villager.art}}"> · {{p.villager.art}}</text></view>
        <view class="card-price">{{unitText}}</view>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="card-name">{{p.product.name}}</view>
      <view class="card-sub" wx:if="{{p.product.sub_title}}">{{p.product.sub_title}}</view>
      <view class="card-price">{{unitText}}</view>
    </view>

    <view class="hr"></view>

    <!-- 寄到哪。微信地址簿只有真机有 —— 网页版会说这台设备上没有，不假装填好 -->
    <view class="row" bindtap="chooseAddr">
      <text class="row-k">寄到</text>
      <text class="row-v" wx:if="{{contact}}">{{contact.name}} · {{contact.phone}} · {{contact.address}}</text>
      <text class="row-v dim" wx:else>还没填 ›</text>
    </view>
    <view class="note" wx:if="{{addrNote}}">{{addrNote}}</view>

    <view class="row">
      <text class="row-k">数量</text>
      <view class="stepper">
        <text class="step {{qty <= 1 ? 'step-off' : ''}}" bindtap="minus">−</text>
        <text class="step-n">{{qty}}</text>
        <text class="step" bindtap="plus">＋</text>
      </view>
    </view>

    <view class="row col">
      <text class="row-k">留句话</text>
      <input class="msg" value="{{message}}" placeholder="不写也行" bindinput="onMessage"/>
    </view>

    <view class="hr"></view>

    <view class="sum-k">算下来</view>
    <view class="row"><text class="row-k">{{p.product.name}} × {{qty}}</text><text class="row-v">{{totalText}}</text></view>
    <view class="row"><text class="row-k">运费</text><text class="row-v">另算 · 以订单为准</text></view>

    <view class="note" wx:if="{{note}}">{{note}}</view>

    <view class="pay">
      <view class="pay-total">一共 {{totalText}}</view>
      <button class="btn" bindtap="go" disabled="{{buying}}">{{buying ? '建单中…' : '去付'}}</button>
    </view>
    <view class="foot">付完之后就等它到 —— 到了会有人告诉你</view>
  </block>
</view>
