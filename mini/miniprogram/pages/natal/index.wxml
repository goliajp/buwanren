<view class="page">

  <!-- summary 模式 -->
  <view wx:if="{{err}}" class="err">{{err}}</view>

  <block wx:if="{{mode === 'summary'}}">
    <!-- 这一屏是刚填完出生时间的人看到的【第一个结果】，也是整条链上最贵那一步
         的回报。原先它是:标题一个「命」字，底下「日主 辛金」「身势 偏弱」——
         一屏古书，而看的人多半不懂这几个词，也不知道接下来该干什么。
         现在:先说结论（你缺什么、该往哪儿使劲），术语收到底下当注脚。 -->
    <view class="says intro">
      <view class="says-face intro-face">村</view>
      <view class="says-body">
        <view class="says-who">村子说</view>
        <view class="says-text">算好了</view>
        <view class="says-foot">
          <text class="says-id">下面这些，后面每一句话都从这儿来</text>
        </view>
      </view>
    </view>

    <!-- 缺 · 朱砂章大字卡 -->
    <view class="stamp-card">
      <view class="stamp-label">缺</view>
      <view class="stamp-value wx-{{summary.primary_pinyin}}">
        {{summary.primary_yongshen}}
      </view>
      <view class="stamp-sub">你缺的是<text class="stamp-em">{{summary.primary_yongshen}}</text><text wx:if="{{summary.secondary_yongshen}}">，其次是 {{summary.secondary_yongshen}}</text></view>
    </view>

    <!-- 那一句原先在弹性槽里，矮屏收起 —— 而它是这一屏唯一一句人话。
         现在它是主体:结论之后紧跟着「所以你该怎么办」。 -->
    <view class="sohow" wx:if="{{summary.friendly_hint}}">{{summary.friendly_hint}}</view>

    <!-- 这里原先是「过 · 应避」两个五行字块。上面那句人话已经说了
         「热闹和人情已经够多了」，底下再列一次「火 木」= 同一件事说两遍
         （标尺 §1.5.5 第 4 条），而且后一遍还是术语。
         五行退到「那一份」的专业细节里去 —— 这一屏留人话。 -->

    <!-- 那一句进弹性槽：这一页上它是唯一「删掉仍然成立」的一块。
         盘面（日主 · 身势 · 缺 · 过）与免责那行都不能少。 -->
    <!-- 这儿原先摆着「日主 辛 · 偏弱 · 印星」当注脚。按 2026-08-30 定的规则，
         专业细节的家是【那一份】（付费的完整分析），日常这几屏一个都不留 ——
         缩成小字不算数，屏上有就是有。 -->

    <view class="archive" wx:if="{{archive.length > 1}}">
      <view class="archive-k">填过的这几份</view>
      <view wx:for="{{archive}}" wx:key="id" class="arch {{item.id === natal.id ? 'arch-on' : ''}}">
        <text class="arch-label">{{item.label || '没写名'}}</text>
        <text class="arch-when">{{item.year}}·{{item.month}}·{{item.day}}</text>
        <text wx:if="{{item.id === natal.id}}" class="arch-now">在用</text>
        <text wx:else class="arch-act" data-id="{{item.id}}" bindtap="onUse">换成它</text>
        <text wx:if="{{item.id !== natal.id}}" class="arch-act arch-del"
              data-id="{{item.id}}" bindtap="onDrop">删</text>
      </view>
      <view class="archive-note">在用的那一份删不掉 —— 先换成别的</view>
    </view>

    <view class="note" wx:if="{{archNote}}">{{archNote}}</view>

    <!-- 算完之后要有下一步。原先只有「再填一份」——
         最贵的一步做完了，然后没有下文，而这一屏正是把结果接回村子的地方。 -->
    <view class="cta">
      <button class="btn" bindtap="goInvite">看看谁跟你补得上</button>
      <button class="btn ghost" bindtap="rebuild">再填一份</button>
    </view>

    <view class="foot-hint">仅供研究与娱乐 · 不构成人生建议</view>
  </block>

  <!-- form 模式 -->
  <!-- 同上:取不到本命时不给建本命的表单,否则一次网络抖动就多一条重复记录 -->
  <block wx:elif="{{!err}}">
    <!-- 标尺 §1.5.2「沉浸感」:这一屏原先是一张冷表单 —— 屏上没有一张脸、
         没有一句谁说的话、没有一处景，而它是整条链上最贵的一步。
         设定不许没请回家的人说话，所以这里由【村子】问 ——
         请到人之后，日常那几屏才换成住着的那位说。
         这一格跟村主屏那张卡同构:同一个壳、同一个位置感。 -->
    <view class="says intro">
      <view class="says-face intro-face">村</view>
      <view class="says-body">
        <view class="says-who">村子问你</view>
        <view class="says-text">你是哪天出生的？</view>
        <view class="says-foot">
          <text class="says-id">填一次，以后都用它 —— 也可以留几份，随时换</text>
        </view>
      </view>
    </view>

    <view class="form">
      <view class="field">
        <text class="field-k">哪一天</text>
        <picker mode="date" value="{{form.date}}"
                start="1900-01-01" end="2050-12-31" bindchange="onDate">
          <view class="field-v mono {{填了.date ? '' : 'unset'}}">{{填了.date ? form.date : '点一下填'}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-k">几点</text>
        <picker mode="time" value="{{form.time}}" bindchange="onTime">
          <view class="field-v mono {{填了.time ? '' : 'unset'}}">{{填了.time ? form.time : '点一下填'}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-k">性别</text>
        <view class="seg">
          <!-- 原先是「乾/M」「坤/F」—— 拿卦名当性别选项，把一个最普通的
               表单字段变成了术数考试，而它也不准确。排盘那一侧照旧收 M/F -->
          <!-- 没选过时两边都不高亮 —— 预选一个等于替他答了 -->
          <view class="seg-item {{填了.gender && form.gender === 'M' ? 'on' : ''}}" bindtap="setMale">男</view>
          <view class="seg-item {{填了.gender && form.gender === 'F' ? 'on' : ''}}" bindtap="setFemale">女</view>
        </view>
      </view>

      <view class="field">
        <!-- 「备注」是表单话。这一栏的用处是【留几份时分得清谁是谁】，
             所以直接说那件事，占位也给个真例子。 -->
        <text class="field-k">给它起个名</text>
        <input class="field-input" placeholder="比如 我自己" value="{{form.label}}" bindinput="onLabel"/>
      </view>
    </view>

    <view class="cta">
      <button class="btn" bindtap="submit" disabled="{{submitting}}">
        {{submitting ? '算着…' : '算一算'}}
      </button>
    </view>

    <!-- 「会得到这些」（设计册 10.8 点名的一条）：
         **填生辰是这条链上最贵的一步** —— 先说清换回什么，才有人愿意填。

         这四行不是文案，是四件真做得到的事：缺什么与过什么算出来就在这一屏上，
         「每天那一句」是村里按你缺的挑人（「谁能来」那一页顶上那句），
         「苏合配的香」是她按你缺的那一味配（她那一屏上那句话）。
         哪天某一条不成立了，这一行就得删 —— 先答应做不到的事，比不答应更伤。 -->
    <view class="gets">
      <view class="gets-k">会得到这些</view>
      <view class="gets-row"><text class="gets-a">你缺的</text><text class="gets-b">一个字</text></view>
      <view class="gets-row"><text class="gets-a">伤你的</text><text class="gets-b">两个字</text></view>
      <view class="gets-row"><text class="gets-a">每天那一句</text><text class="gets-b">按它来挑人</text></view>
      <view class="gets-row"><text class="gets-a">苏合配的香</text><text class="gets-b">按它来配味</text></view>
    </view>

    <!-- 进弹性槽（矮屏收起）：这是给开发看的技术说明，不是填生辰的人要读的东西，
         正合槽的判据「删掉这一屏仍然成立」。而「会得到这些」不能进槽 ——
         它是 10.8 点名的那一块，收起来就等于没有。 -->
    <view class="foot-hint flexslot">
      时区默认东八区(+8) · 真太阳时校正暂关
    </view>
  </block>

</view>
