.hd { padding: 16rpx 0 16rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }
.hd .subtitle { color: var(--ink-mid); }

/* summary basic */
.basic {
  padding: 8rpx 0 12rpx;
}
.basic-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--stone-line-x);
}
.basic-row:last-child { border-bottom: none; }
.basic-k {
  color: var(--stone-label);
  font-size: 24rpx;
  letter-spacing: 0.02em;
}
.basic-v {
  font-size: 32rpx;
  color: var(--ink);
}
.basic-v.serif {
  font-weight: 600;
  font-size: 40rpx;
  font-weight: 500;
}

/* 缺 · 朱砂章大字卡 · 品牌核心 */
.stamp-card {
  background: var(--paper-panel);
  border: 3rpx solid var(--stamp);
  border-radius: 16rpx;
  padding: 32rpx 32rpx 28rpx;
  margin: 20rpx 0 16rpx;
  text-align: center;
  position: relative;
}
.stamp-label {
  font-weight: 600;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--stamp);
  letter-spacing: 0.02em;
  margin-bottom: 12rpx;
}
.stamp-value {
  font-weight: 600;
  font-size: 220rpx;
  font-weight: 500;
  line-height: 1;
  margin: 12rpx 0 20rpx;
}
.stamp-sub {
  font-size: 22rpx;
  color: var(--ink-faint);
  letter-spacing: 0.02em;
}

/* 过 · chips */
.over {
  padding: 12rpx 0 4rpx;
}
.over-k {
  color: var(--stone-label);
  font-size: 24rpx;
  letter-spacing: 0.02em;
  margin-bottom: 10rpx;
}
.chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.chip {
  font-weight: 600;
  font-size: 44rpx;
  font-weight: 500;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--stone-line);
  border-radius: 16rpx;
  min-width: 88rpx;
  text-align: center;
  line-height: 1.1;
}

.hint {
  padding: 40rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink-mid);
  line-height: 1.7;
  letter-spacing: 0.04em;
}

.cta { text-align: center; padding: 12rpx 0 4rpx; }
.foot-hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--stone-label);
  letter-spacing: 0.02em;
  padding: 20rpx 0 0;
}

/* form */
.form {
  padding: 20rpx 0 8rpx;
}
.field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--stone-line-x);
}
.field-k {
  color: var(--stone-label);
  font-size: 26rpx;
  letter-spacing: 0.02em;
}
.field-v {
  font-size: 30rpx;
  color: var(--ink);
}
.field-v.mono {
  /* 原先是 SF Mono —— 数字对齐是对的，等宽字体的「终端」观感不是。
     `tabular-nums` 同样对齐，而字还是系统字 */
  font-variant-numeric: tabular-nums;
  font-size: 28rpx;
  letter-spacing: 0.04em;
}
.field-input {
  font-size: 30rpx;
  color: var(--ink);
  text-align: right;
  min-width: 260rpx;
  max-width: 400rpx;
}
.seg { display: flex; gap: 12rpx; }
.seg-item {
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--stone-line);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink-mid);
  letter-spacing: 0.14em;
}
.seg-item.on {
  background: var(--ink);
  color: var(--paper);
  border-color: var(--ink);
}

/* 取不到时说一句，别渲成「你还没建」—— 那会诱使人再建一条 */
.err { padding: 24rpx 0; color: var(--peach); font-size: 26rpx; line-height: 1.7; }

/* 这些生辰 —— 只有两份以上才出现 */
.archive { border-top: 1rpx solid var(--stone-line); margin-top: 32rpx; padding-top: 24rpx; }
.archive-k { font-size: 24rpx; color: var(--stone-label); margin-bottom: 16rpx; }
.arch { display: flex; align-items: baseline; padding: 18rpx 0;
        border-bottom: 1rpx solid var(--stone-line); }
.arch-label { font-weight: 600; font-size: 30rpx; color: var(--ink); flex: 1; }
.arch-when { font-size: 22rpx; color: var(--stone-label); margin-right: 20rpx; }
.arch-now { font-size: 22rpx; color: var(--ink); }
.arch-act { font-size: 24rpx; color: var(--stone-label); margin-left: 20rpx; }
.arch-del { color: var(--stone-label); }
.arch-on .arch-label { color: var(--ink); }
.archive-note { font-size: 22rpx; color: var(--stone-label); margin-top: 16rpx; }
.note { margin: 20rpx 0; font-size: 26rpx; color: var(--stone-label); }

/* 「会得到这些」（设计册 H2 / 10.8）：填生辰之前先说清换回什么。
   行高按能读定，不按触点定 —— 它不是可点的东西，是一份清单。 */
.gets { margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid var(--stone-line-x); }
.gets-k { font-size: 22rpx; color: var(--stone-label); letter-spacing: 0.02em; margin-bottom: 10rpx; }
.gets-row { display: flex; align-items: baseline; padding: 6rpx 0; }
.gets-a { flex: none; width: 180rpx; font-size: 26rpx; color: var(--ink); }
.gets-b { flex: 1; font-size: 24rpx; color: var(--ink-faint); }


/* ── 0830 ────────────────────────────────────────────────────
   选中态原先是黑色方块 —— 整屏最重的一块压在一个表单选项上。
   琥珀是这一版说「选中/主动作」的颜色。 */
.seg-item { border-radius: 999rpx; }
.seg-item.on { background: var(--amber); color: #fff; border-color: var(--amber); }
/* 「算一算」是这一屏唯一的动作，给它整行 */
.acts .btn, .submit { width: 100%; box-sizing: border-box; }

/* 还没填的那几格 —— 显示的是提示，不是答案，所以要轻、要看得出「等你点」 */
.field-v.unset { color: var(--ink-faint); font-weight: 400; }

/* 0830 语言清扫：结论在上、该怎么办紧跟着，术语退到注脚 */
.hd .sub { font-size: 25rpx; color: var(--ink-faint); margin-top: 8rpx; }
.stamp-em { color: var(--ink); font-weight: 700; margin: 0 4rpx; }
.sohow {
  margin-top: 20rpx; padding: 20rpx 22rpx;
  background: var(--paper-inset); border-radius: var(--r-card);
  font-size: 27rpx; line-height: 1.75; color: var(--ink);
}
.jargon { margin-top: 18rpx; font-size: 23rpx; color: var(--stone-label); }
.cta { display: flex; flex-direction: column; gap: 16rpx; margin-top: 32rpx; }
.cta .btn { width: 100%; box-sizing: border-box; }

/* ── 还差几样：就地说，表单留在原地 ─────────────────────────
   原先这句走的是 `err`，而表单整块挂在 `wx:elif="{{!err}}"` 上 ——
   按一下「算一算」，整屏只剩一行粉字，连回去填的地方都没有。 */
.miss {
  margin-top: 18rpx; text-align: center;
  font-size: 24rpx; color: var(--amber-deep); line-height: 1.6;
  animation: 落 .34s cubic-bezier(.22,1,.36,1) both;
}
@keyframes 落 { from { opacity: 0; transform: translateY(8rpx) } to { opacity: 1; transform: none } }
/* 差的那一栏自己指出来 —— 一句「还差哪一天、几点」要人回去数哪一栏是哪一栏。
   **左边一道竖线，不铺底色**：三样都缺的时候整片橙，那不是指路是喊叫。 */
.field-miss { box-shadow: inset 4rpx 0 0 var(--amber); padding-left: 18rpx; }
.field-miss .field-k { color: var(--amber-deep); font-weight: 600; }

/* 三样没齐时按钮待命 —— 满橙的大按钮长得跟能按一样，
   而按下去只会得到一句「还差……」。
   选择器要写成 `button.btn.btn-wait`:app.wxss 里是 `button.btn`
   （标签 + 类），单个 `.btn-wait` 压不过它 —— 症状是「这条 CSS 像没写」。
   这个坑在这个仓里踩过不止一次。 */
button.btn.btn-wait { background: #EADFCD; color: #A08E74; box-shadow: none; }

/* 章跟着五行色走 —— 橙色边框配冷灰蓝的「金」是两套颜色在打架。
   每个人的结果屏因此各有其色：缺木是绿的章，缺水是蓝的章。 */
.stamp-mu   { border-color: var(--wx-mu) }
.stamp-huo  { border-color: var(--wx-huo) }
.stamp-tu   { border-color: var(--wx-tu) }
.stamp-jin  { border-color: var(--wx-jin) }
.stamp-shui { border-color: var(--wx-shui) }
.stamp-mu   .stamp-label { color: var(--wx-mu-fg) }
.stamp-huo  .stamp-label { color: var(--wx-huo-fg) }
.stamp-tu   .stamp-label { color: var(--wx-tu-fg) }
.stamp-jin  .stamp-label { color: var(--wx-jin-fg) }
.stamp-shui .stamp-label { color: var(--wx-shui-fg) }


/* 「不知道时辰怎么办」。挂在那一栏底下，不是独立一块 ——
   它是那一栏的注脚，不该看着像又一条要填的东西。 */
.field-note {
  margin: -6rpx 0 18rpx;
  padding: 0 4rpx;
  font-size: 22rpx; line-height: 1.65;
  color: var(--ink-faint);
}
