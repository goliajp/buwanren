.hd { padding: 24rpx 0 20rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 108rpx; line-height: 1; margin: 8rpx 0 12rpx; }

/* 那一句。设计册 M1 上它单独占一行，是这一屏唯一一句「说话」的地方 */
.say {
  padding: 28rpx 4rpx 8rpx;
  font-size: 24rpx;
  color: var(--stone-label);
  letter-spacing: 0.06em;
  line-height: 1.7;
}

.recent-k {
  padding: 16rpx 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--stone-label);
  letter-spacing: 0.18em;
}
.recent {
  background: var(--paper-panel);
  border: 1rpx solid var(--stone-line-x);
  border-radius: 8rpx;
  padding: 24rpx 28rpx;
}
.recent-title {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  color: var(--ink);
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-line { display: flex; align-items: baseline; }
.recent-when { flex: 1; font-size: 24rpx; color: var(--ink-faint); }
.recent-go { flex: none; font-size: 24rpx; color: var(--ink-mid); margin-left: 20rpx; }

/* 空着的时候不留白：把「哪儿能有」指出来（设计册 10.2 的空状态块） */
.recent.empty { background: transparent; border-style: dashed; }
.recent.empty .recent-title { font-size: 30rpx; color: var(--ink-mid); }
/* 取不到 ≠ 没有。这一档只说一句，不摆出「还没买过」那副样子 */
.recent.muted { background: transparent; border-style: dashed; opacity: .7; }

.slot-k { font-size: 22rpx; color: var(--stone-label); letter-spacing: 0.24em; }
.slot-v { flex: 1; margin-left: 20rpx; font-size: 24rpx; color: var(--ink-mid); }

/* .flexslot 全局只有一条「矮屏收起」的规则，没有排版 —— 这一屏自己排。
   （槽里放什么各屏不同，所以布局本来就不该是全局的） */
.flexslot {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 4rpx 0;
  border-top: 1rpx solid var(--stone-line-x);
}
