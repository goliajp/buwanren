.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 128rpx; line-height: 1; margin: 8rpx 0 16rpx; }

/* 已绑定 · profile-card */
.profile-card {
  text-align: center;
  padding: 32rpx 0 24rpx;
}
.avatar {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  border: 1rpx solid var(--stone-line);
  background: var(--paper-inset);
  display: inline-block;
  margin-bottom: 20rpx;
}
.avatar-fallback {
  font-family: "Songti SC", serif;
  font-size: 56rpx;
  font-weight: 500;
  color: var(--stone-label);
  line-height: 138rpx;
  text-align: center;
  letter-spacing: 0;
}
.profile-name {
  font-family: "Songti SC", serif;
  font-size: 44rpx;
  color: var(--ink);
  margin-bottom: 10rpx;
}
.profile-badge {
  display: inline-block;
  font-size: 20rpx;
  color: var(--wx-mu);
  border: 1rpx solid var(--wx-mu);
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  letter-spacing: 0.18em;
}

/* onboard 未绑定 */
.onboard-card {
  background: var(--paper-panel);
  border: 1rpx solid var(--stone-line-x);
  border-radius: 8rpx;
  padding: 44rpx 32rpx 32rpx;
}
.onboard-title {
  font-family: "Songti SC", serif;
  font-size: 48rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.12em;
  margin-bottom: 8rpx;
}
.onboard-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.14em;
  margin-bottom: 40rpx;
}

.wx-form { display: flex; flex-direction: column; gap: 32rpx; }
.wx-field { display: flex; justify-content: center; }

.avatar-btn {
  padding: 0;
  background: transparent;
  border: none;
  line-height: 0;
  width: 140rpx;
  height: 140rpx;
}
.avatar-btn::after { border: none; }
.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 1rpx dashed var(--stone-line);
  background: var(--paper-inset);
  display: block;
}
.avatar-preview.avatar-fallback {
  font-family: "Songti SC", serif;
  font-size: 22rpx;
  color: var(--stone-label);
  line-height: 138rpx;
  text-align: center;
  letter-spacing: 0.14em;
}

.nickname-input {
  width: 100%;
  background: var(--paper-inset);
  padding: 20rpx 24rpx;
  border-radius: 4rpx;
  font-size: 30rpx;
  color: var(--ink);
  text-align: center;
  letter-spacing: 0.14em;
  box-sizing: border-box;
}

.wx-cta { text-align: center; margin-top: 8rpx; }

.wx-hint {
  padding: 24rpx 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--stone-label);
  line-height: 1.7;
  letter-spacing: 0.06em;
}

/* profile 明细 */
.prof-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--stone-line-x);
}
.prof-row:last-child { border-bottom: none; }
.prof-k {
  color: var(--stone-label);
  font-size: 24rpx;
  letter-spacing: 0.32em;
}
.prof-v {
  color: var(--ink-mid);
  font-size: 26rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.prof-v.ok { color: var(--wx-mu); }
.prof-v.mono {
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 20rpx;
  color: var(--ink-mid);
  letter-spacing: 0.02em;
}

.cta {
  text-align: center;
  padding: 40rpx 0 24rpx;
}
.foot-hint {
  text-align: center;
  font-size: 20rpx;
  color: var(--stone-label);
  letter-spacing: 0.24em;
  padding: 24rpx 0 0;
}

/* 改名 —— 对谁都开着，绑定之后也得改得动 */
.rename-row { display: flex; align-items: baseline; padding: 18rpx 0;
              border-top: 1rpx solid var(--stone-line); margin-top: 24rpx; }
.rename-k { font-size: 26rpx; color: var(--stone-label); width: 120rpx; flex: none; }
.rename-v { font-family: "Songti SC", serif; font-size: 32rpx; color: var(--ink); flex: 1; }
.rename-input {
  display: inline-block; width: 320rpx;
  border-bottom: 1rpx solid var(--stone-line);
  font-size: 28rpx; color: var(--ink); padding: 8rpx 0;
}
.rename-act { font-size: 24rpx; color: var(--stone-label); margin-left: 24rpx; }
.rename-note { font-size: 22rpx; color: var(--stone-label); margin-top: 12rpx; }

/* 账号明细的开关行：跟 entries 一个样子，免得多一种样式。 */
.prof-toggle { display: flex; justify-content: space-between; align-items: center;
               padding: 20rpx 0; border-bottom: 1rpx solid #e0e0e0; }
