<view class="page">
  <view class="hd">
    <view class="eyebrow">BUWANREN · ME</view>
    <view class="title">我</view>
  </view>

  <view class="hr"></view>

  <!-- 已绑定微信 · profile card -->
  <block wx:if="{{isWx && user}}">
    <view class="profile-card">
      <image wx:if="{{user.avatar_url}}" class="avatar" src="{{user.avatar_url}}" mode="aspectFill"/>
      <view wx:else class="avatar avatar-fallback">不</view>
      <view class="profile-name serif">{{user.nickname}}</view>
      <view class="profile-badge">微信 · 已绑定</view>
    </view>
  </block>

  <!-- 未绑定微信 · onboard 授权卡 -->
  <block wx:else>
    <view class="onboard-card">
      <view class="onboard-title serif">还是不完人</view>
      <view class="onboard-sub">
        绑定微信,跨设备同步本命档案
      </view>

      <view class="wx-form">
        <view class="wx-field wx-avatar-field">
          <button class="avatar-btn"
                  open-type="chooseAvatar"
                  bindchooseavatar="onChooseAvatar">
            <image wx:if="{{draft.avatar_url}}"
                   class="avatar-preview"
                   src="{{draft.avatar_url}}"
                   mode="aspectFill"/>
            <view wx:else class="avatar-preview avatar-fallback">选头像</view>
          </button>
        </view>

        <view class="wx-field">
          <input class="nickname-input"
                 type="nickname"
                 placeholder="微信昵称"
                 value="{{draft.nickname}}"
                 bindinput="onNickname"
                 bindblur="onNickname"/>
        </view>

        <view class="wx-cta">
          <button class="btn stamp"
                  bindtap="doBind"
                  disabled="{{binding}}">
            {{binding ? '绑定中…' : '绑定微信'}}
          </button>
        </view>

        <view class="wx-hint">
          我们不读取你的手机号或其它信息 · 仅换 openid + 保存你自己填的头像和昵称
        </view>
      </view>
    </view>
  </block>

  <view class="hr"></view>

  <!-- profile 明细 -->
  <view class="card" wx:if="{{user}}">
    <view class="prof-row">
      <text class="prof-k">I D</text>
      <text class="prof-v mono">{{user.id}}</text>
    </view>
    <view class="prof-row">
      <text class="prof-k">平 台</text>
      <text class="prof-v">{{user.platform}}</text>
    </view>
    <view class="prof-row">
      <text class="prof-k">区 域</text>
      <text class="prof-v">{{user.region}} · {{user.locale}}</text>
    </view>
    <view class="prof-row">
      <text class="prof-k">类 型</text>
      <text class="prof-v {{user.is_anonymous ? '' : 'ok'}}">
        {{user.is_anonymous ? '匿名' : '实名'}}
      </text>
    </view>
    <view class="prof-row" wx:if="{{activeNatalId}}">
      <text class="prof-k">本 命</text>
      <text class="prof-v mono">{{activeNatalId}}</text>
    </view>
  </view>

  <view class="cta">
    <button class="btn ghost" bindtap="doLogout">退出并重新登录</button>
  </view>

  <view class="foot-hint">
    不完人 v{{version}} · 仅供研究与娱乐
  </view>
</view>
