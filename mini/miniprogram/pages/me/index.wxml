<view class="page">
  <view class="hd">
    <view class="title">我的</view>
  </view>

  <view class="hr"></view>

  <!-- 设计册 10.4 的 M1 就这五条。授权卡、账号明细、退出并重新登录
       都搬进「设置 ›」了 —— 它们是账号的事，不是「我」的事，
       而其中授权卡一块 372px 就吃光了这一屏的全部富余。 -->
  <view class="entries">
    <view class="entry" bindtap="goName" hover-class="entry-hover" hover-stay-time="100">
      <text class="entry-k">名字</text>
      <text class="entry-v">{{nickname}}</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry" bindtap="goOrders" hover-class="entry-hover" hover-stay-time="100">
      <text class="entry-k">我买过的</text>
      <text class="entry-v">{{orderText}}</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry" bindtap="goBadges" hover-class="entry-hover" hover-stay-time="100">
      <text class="entry-k">我得到的</text>
      <text class="entry-v">{{badgeText}}</text>
      <text class="entry-arrow">›</text>
    </view>
    <!-- 真订着东西的时候才摆这一行。村里现在没有可订的东西，
         那一屏点进去只会说「等有了会摆在这儿」—— 它唯一传达的信息是
         这个产品还没做完，而它跟另外四行并排挂着，会把那四行的可信度
         一起拉低。有货那天它自己就回来了。 -->
    <view class="entry" wx:if="{{hasSubs}}" bindtap="goSubs" hover-class="entry-hover" hover-stay-time="100">
      <text class="entry-k">订着的</text>
      <text class="entry-v">{{subText}}</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry" bindtap="goSettings" hover-class="entry-hover" hover-stay-time="100">
      <text class="entry-k">设置</text>
      <text class="entry-v"></text>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <!-- 「最近一笔」那一块只在【真有一笔】的时候摆出来。
       空的时候它原先是屏上最重的东西：一个粗黑虚线框写着「还没买过什么」——
       而上面菜单里已经写着「我买过的 · 还没有」，再加一句
       「想请谁回家，去村子里挑」，同一件事在一屏上说了三遍
       （标尺 §1.5.5 第 4 条），而且最重的位置给了「什么都没有」。
       现在空的时候只留一行轻提示，指出哪儿能有。 -->
  <view class="recent-k" wx:if="{{recent}}">最近一笔</view>
  <view class="recent" wx:if="{{recent}}" bindtap="goRecent"
        hover-class="entry-hover" hover-stay-time="100">
    <view class="recent-title">{{recent.title}}</view>
    <view class="recent-line">
      <text class="recent-when">{{recent.when}} · {{recent.state}}</text>
      <text class="recent-go">{{recent.go}} ›</text>
    </view>
  </view>
  <view class="nothing" wx:elif="{{recentEmpty}}" bindtap="goVillage"
        hover-class="entry-hover" hover-stay-time="100">
    <text>东西长在人身上 —— 去村里看看谁能来</text>
    <text class="nothing-go">去 ›</text>
  </view>
  <view class="recent muted" wx:else>
    <view class="recent-line"><text class="recent-when">{{recentNote || '取着……'}}</text></view>
  </view>

  <!-- 弹性槽 · 矮屏收起：下一站在哪儿。删掉它这一屏仍然成立 -->
  <view class="flexslot" wx:if="{{nextStop}}" bindtap="goRecent">
    <text class="slot-k">下一站</text>
    <text class="slot-v">{{nextStop}}</text>
    <text class="entry-arrow">›</text>
  </view>
</view>
