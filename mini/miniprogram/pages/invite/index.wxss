.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }

.cats { margin-bottom: 32rpx; }
.cat {
  display: inline-block;
  font-size: 26rpx;
  color: var(--stone-label);
  box-shadow: var(--sh-card);
  border-radius: 16rpx;
  padding: 8rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.cat-on { color: var(--ink); border-color: var(--ink); }

.loading, .err, .empty { padding: 80rpx 0; text-align: center; color: var(--stone-label); }
.err-msg { margin-bottom: 28rpx; }

.item {
  border-top: 1rpx solid var(--stone-line);
  padding: 28rpx 0;
}
.item-hover { background: var(--paper-inset); }
.item-name { font-weight: 600; font-size: 36rpx; color: var(--ink); }
.item-sub { font-size: 26rpx; color: var(--stone-label); margin-top: 10rpx; line-height: 1.6; }
.item-meta { font-size: 22rpx; color: var(--stone-label); margin-top: 12rpx; }
.arrow { float: right; }

.more {
  border-top: 1rpx solid var(--stone-line);
  padding: 32rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--stone-label);
}

/* 谁能来：比铺少一层分类栏，多一句「为什么是这几位」。 */
.why { font-size: 26rpx; color: var(--ink-faint); margin-top: 12rpx; line-height: 1.5; }
.foot { font-size: 24rpx; color: var(--ink-faint); margin-top: 28rpx; line-height: 1.6; }
.empty-t { font-size: 30rpx; font-weight: 600; }
.empty-sub { font-size: 26rpx; color: var(--ink-faint); margin-top: 12rpx; }

/* 收掉最后那 32px：头部 eyebrow 与页脚各让一点。
   一屏差 32px 不是「差不多」—— 差 1px 也要滚，滚了就没有提示。 */
.hd .eyebrow { display: none; }
.foot { margin-top: 16rpx; font-size: 22rpx; }
.item { padding-top: 18rpx; padding-bottom: 18rpx; }

/* 没上架的：在册上，但按不动（设计册 10.8「照实说，不拿别人顶上」） */
.item-off { opacity: .55; }
.item-meta.off { color: var(--ink-faint); }

/* 两行布局：名 + 动作一行，副题一行 */
.item-top { display: flex; align-items: baseline; }
.item-top .item-name { flex: 1; }
.item-top .item-meta { flex: none; margin-left: 20rpx; }


/* ── 0830:一行 → 一张卡（名册就是图鉴，图鉴要有脸）────────────── */
.list { display: flex; flex-direction: column; gap: 12rpx; }
.item {
  display: flex; align-items: center; gap: 18rpx;
  background: var(--paper-panel);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  padding: 15rpx 18rpx;
  border-bottom: none;
  transition: transform .12s cubic-bezier(.34,1.56,.64,1);
}
.item-hover { transform: scale(.985); }
.item-face {
  flex: none; width: 70rpx; height: 70rpx; border-radius: 999rpx;

  display: flex; align-items: center; justify-content: center;
}
.item-body { flex: 1; min-width: 0; }
.item-top { display: flex; align-items: center; gap: 12rpx; }
.item-name { font-size: 31rpx; font-weight: 600; color: var(--ink); }
/* 「缺 X」做成药丸 —— 跟五行标签同一套语言，一眼看出这一页是同一路人 */
/* 底色与字色由 `.lack-<方向>`（app.wxss）给 —— 这里不写 background，
   页面样式在 app.wxss 之后加载，写了就会把方向色盖掉。
   这个坑今天踩过三次（柱头色带、五行条、头像），症状都是
   「功能看着像没做」。没有方向时的兜底也放在 app.wxss，不放这儿。 */
.item-lack {
  font-size: 21rpx; font-weight: 600;
  padding: 3rpx 12rpx; border-radius: 999rpx;
}
.item-sub { font-size: 23rpx; color: var(--ink-faint); margin-top: 5rpx; }
.item-go { flex: none; margin-left: 14rpx; font-size: 25rpx; font-weight: 600; color: var(--amber-deep); }
.item-go.off { color: var(--stone-label); font-weight: 400; }
/* 还没上架的压暗，但【留住卡片的形】—— 背景透明会让它看起来像被裁掉半张。
   四十位都在册上是刻意的，它只是「还没来」，不是「不存在」 */
.item-off { background: rgba(255,255,255,.55); box-shadow: none; }
.item-off .item-name { color: var(--ink-mid); }
/* 还没来的那几位压暗 —— 这一条要盖住方向色，所以写在页面里是对的 */
.item-off .item-lack { background: var(--paper-inset) !important; color: var(--stone-label) !important; }
.item-off .item-face { background: var(--paper-inset); color: var(--stone-label); }

/* ── 还没来的那些：在册上，但不占地方 ─────────────────────────
   默认收成一行,点开才摊。原先它们跟能请的平级混排、五位一页,
   在卖的只有四位 —— 往后七页全是灰的,翻页翻不出东西来。 */
.soon-line {
  display: flex; align-items: center; gap: 14rpx;
  margin-top: 26rpx; padding: 20rpx 22rpx;
  background: var(--paper-inset);
  border-radius: var(--r-card);
  font-size: 25rpx; color: var(--ink-mid);
}
/* 摊开之后它退回一条细横杠 —— 那时它只是个开关,不再是预告 */
.soon-line.open {
  background: none; padding: 16rpx 0; justify-content: center;
  border-top: 1rpx solid var(--stone-line-x); border-radius: 0;
}
.soon-txt { flex: 1; }
.soon-line.open .soon-txt { flex: none; }
/* 三张脸叠着 —— 一堆人站在门外的样子,不是三个并排的头像 */
.soon-peek { flex: none; display: flex; align-items: center; }
.peek-face {
  position: relative;
  width: 52rpx; height: 52rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
  border: 3rpx solid var(--paper-inset);
  filter: saturate(.72);
}
.soon-hover { opacity: .55; }
/* 箭头转过来 —— 收起/展开是同一个东西的两面,不该是两个图标 */
.soon-caret {
  color: var(--stone-label);
  transform: rotate(90deg);
  transition: transform .22s cubic-bezier(.22,1,.36,1);
}
.soon-caret.up { transform: rotate(-90deg); }

.soon-list { display: flex; flex-direction: column; }
.soon-item {
  display: flex; align-items: center; gap: 14rpx;
  padding: 13rpx 4rpx;
  border-bottom: 1rpx solid var(--stone-line-x);
}
.soon-item:last-child { border-bottom: none; }
/* 窄行的脸也留着 —— 名册是图鉴,没有脸就退回四十行文字。
   只是小一号、压暗:他还没来 */
.soon-face {
  flex: none; width: 44rpx; height: 44rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; background: var(--paper-inset); color: var(--stone-label);
}
.soon-name { flex: none; font-size: 27rpx; color: var(--ink-mid); }
.soon-sub {
  flex: 1; min-width: 0; font-size: 22rpx; color: var(--ink-faint);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.soon-lack { flex: none; font-size: 20rpx; color: var(--stone-label); }

/* ── 按下「请回家」之后会发生什么 ────────────────────────────
   第一次来的人不知道这是实物、要寄、要扫。原先只有一行小灰字。 */
.how {
  display: flex; align-items: flex-start; justify-content: space-between;
  margin-top: 30rpx; padding-top: 26rpx;
  border-top: 1rpx solid var(--stone-line-x);
}
.how-step { flex: 1; text-align: center; }
.how-n {
  width: 40rpx; height: 40rpx; margin: 0 auto 12rpx;
  border-radius: 999rpx; background: var(--amber-lite);
  color: var(--amber-deep); font-size: 23rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.how-t { font-size: 25rpx; font-weight: 600; color: var(--ink-mid); }
.how-s { font-size: 21rpx; color: var(--ink-faint); margin-top: 6rpx; line-height: 1.5; }
.how-arrow { flex: none; padding-top: 6rpx; font-size: 30rpx; color: var(--ink-faint); opacity: .5; }

.back { margin-top: 30rpx; text-align: center; font-size: 26rpx; color: var(--ink-faint); }
