<view class="page">
  <view class="hd">
    <view class="title">谁能来</view>
    <!-- 说「为什么是这几位」得【真的按它排过】。
         这一句原先是笼统的「跟你补得上」，而排序只按「在卖的排前面、
         再按 id」—— 陈述了一个不存在的因果（设计册 10.8）。
         现在理由是后端给的那条（用神 → 该找哪一路人），
         没排过时 `why` 是空的，这一句就不说。 -->
    <view class="why" wx:if="{{lack && why}}">你缺「{{lack}}」·{{why}}</view>
    <view class="why" wx:elif="{{lack}}">你缺「{{lack}}」</view>
    <view class="why" wx:elif="{{lackErr}}">{{lackErr}}</view>
    <!-- 药丸写着「缺 亲人」，贴在【他】那一侧 —— 第一次看的人会读成
         「这个人缺勤」，而它说的是他补【你】哪一样。所以这里要点一句。
         填过出生时间之后这句会换成「你缺 X · ……」，那时它自明。 -->
    <view class="why" wx:else>填了出生时间就按你缺的排 · 右边两个字是各人自己缺的 —— 缺过才懂怎么劝人</view>
    <view class="hr"></view>
  </view>

  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
      <view class="sk sk-face"></view>
      <view class="sk-body">
        <view class="sk sk-line short"></view>
        <view class="sk sk-line mid"></view>
      </view>
    </view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="load">再试一次</button>
  </view>

  <block wx:else>
    <!-- 空不是问题，说不清哪儿能有才是 -->
    <view class="empty" wx:if="{{能请.length === 0 && 没来.length === 0}}">
      <view class="empty-t">一位也没数到</view>
      <view class="empty-sub">这份名单没取到 —— 待会儿再看看</view>
    </view>

    <!-- 现在能请的。这一屏的主体：一次全在，不用翻。
         原先四十位平级混排、五位一页 —— 在卖的只有四位，
         于是往后七页全是灰的「还没来」，翻页翻不出东西来。 -->
    <view class="list" wx:if="{{能请.length > 0}}">
      <view wx:for="{{能请}}" wx:key="id"
            class="item enter" style="animation-delay:{{index * 40}}ms"
            data-id="{{item.id}}" bindtap="onTap"
            hover-class="item-hover" hover-stay-time="100">
        <!-- 脸。四十位原先是四十行文字 —— 一个靠角色立身的产品，
             最不该没有角色的就是这一屏。没有美术之前用姓名末字，
             等头像画好换这一处即可。 -->
        <view class="item-face face-{{item.direction}} {{item.纹}} {{item.脸样 ? 'face-art' : ''}}" style="{{item.脸样}}"><text wx:if="{{!item.脸样}}">{{item.face}}</text></view>
        <view class="item-body">
          <view class="item-top">
            <text class="item-name">{{item.name}}</text>
            <text class="item-lack lack-{{item.direction}}" wx:if="{{item.lack}}">缺{{item.lack}}</text>
          </view>
          <view class="item-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        </view>
        <!-- 「请他来」对婆婆是错的 —— 四十位里男女都有。不带代词 -->
        <text class="item-go">请回村 ›</text>
      </view>
    </view>

    <!-- 还没来的那些。**在册上，但不占地方** ——
         默认收成这一行，想看再摊开。四十位一个不少（只列在卖的那几位，
         读的人会以为世上只有那几位），但没来的不该让人一页页翻过去。 -->
    <view class="soon-line {{展开 ? 'open' : ''}}" wx:if="{{没来.length > 0}}" bindtap="onToggle"
          hover-class="soon-hover" hover-stay-time="100">
      <!-- 收着的时候露三张脸。光一个数字是「还有 36 条记录」,
           而这一屏卖的是人 —— 三张脸让那 36 位有重量,点开的理由是真的。
           摊开之后脸就撤掉:下面整列都是脸,这儿再放三张是重复。 -->
      <view class="soon-peek" wx:if="{{!展开}}">
        <view wx:for="{{预告}}" wx:key="id" class="peek-face face-{{item.direction}} {{item.脸样 ? 'face-art' : ''}}"
              style="margin-left:{{index === 0 ? 0 : -18}}rpx; z-index:{{3 - index}}; {{item.脸样}}"><text wx:if="{{!item.脸样}}">{{item.face}}</text></view>
      </view>
      <text class="soon-txt" wx:if="{{展开}}">收起</text>
      <text class="soon-txt" wx:else>另外 {{没来.length}} 位还在路上</text>
      <text class="soon-caret {{展开 ? 'up' : ''}}">›</text>
    </view>

    <!-- 摊开之后是一列窄行,不是一列大卡 —— 它们按不动,给不了大卡那个
         「能点」的暗示;而做成一样大又会把能请的那几位淹掉。 -->
    <view class="soon-list" wx:if="{{展开}}">
      <view wx:for="{{没来}}" wx:key="id" class="soon-item enter"
            style="animation-delay:{{index < 12 ? index * 26 : 312}}ms">
        <view class="soon-face {{item.脸样 ? 'face-art' : ''}}" style="{{item.脸样}}"><text wx:if="{{!item.脸样}}">{{item.face}}</text></view>
        <text class="soon-name">{{item.name}}</text>
        <text class="soon-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        <text class="soon-lack" wx:if="{{item.lack}}">缺{{item.lack}}</text>
      </view>
    </view>

    <!-- 「请回家」按下去会发生什么。原先这里只有一行 22rpx 的灰字
         —— 而这是第一次来的人最需要知道的一件事:这东西是实物,
         寄到手上,扫一下人才住进村里。三步摆开,不必读那一长句。
         摊开名单的时候它让位:那时人在看名单,不是在看怎么买。 -->
    <view class="how" wx:if="{{能请.length > 0 && !展开}}">
      <view class="how-step">
        <view class="how-n">1</view>
        <view class="how-t">请一位</view>
        <view class="how-s">挑能说到你的</view>
      </view>
      <view class="how-arrow">›</view>
      <view class="how-step">
        <view class="how-n">2</view>
        <view class="how-t">收到御守</view>
        <view class="how-s">实物寄到你手上</view>
      </view>
      <view class="how-arrow">›</view>
      <view class="how-step">
        <view class="how-n">3</view>
        <view class="how-t">扫开它</view>
        <view class="how-s">就住进村里</view>
      </view>
    </view>

    <!-- 回村里。`onBack` 在这一页的 ts 里躺了很久却从没绑上过 ——
         而「一屏不是死路」那支门禁把「有翻页」也算成出口,于是它一直绿。
         翻页不离开这一屏,那是个假出口(判据同日一并改掉)。
         真机上原生导航栏是有返回箭头的,但别的屏都摆了这一行,该一样。 -->
    <view class="back" bindtap="onBack">回村里</view>
  </block>
</view>
