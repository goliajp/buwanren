<view class="page">
  <view class="hd">
    <view class="title">谁能来</view>
    <!-- 说「为什么是这几位」得【真的按它排过】。
         这一句原先是笼统的「跟你补得上」，而排序只按「在卖的排前面、
         再按 id」—— 陈述了一个不存在的因果（设计册 10.8）。
         现在理由是后端给的那条（用神 → 该找哪一路人），
         没排过时 `why` 是空的，这一句就不说。 -->
    <view class="why" wx:if="{{lack && why}}">你缺「{{lack}}」·{{why}}</view>
    <view class="why" wx:elif="{{lack}}">你缺「{{lack}}」</view>
    <view class="why" wx:elif="{{lackErr}}">{{lackErr}}</view>
    <!-- 药丸写着「缺 亲人」，贴在【他】那一侧 —— 第一次看的人会读成
         「这个人缺勤」，而它说的是他补【你】哪一样。所以这里要点一句。
         **并在同一行里说**:另起一行会把第五张卡挤到分页栏底下，
         而这一屏的设计目标是一屏放得下（门禁「22/22 页放得下」盯着它）。
         填过生辰之后这句会换成「你缺 X · 这几位跟你补得上」，那时它自明。 -->
    <view class="why" wx:else>填了出生时间就按你缺的排 · 右边两个字是他补你哪一样</view>
    <!-- 这一页一个都请不动时的出路。**不进弹性槽** ——
         弹性槽在矮屏上会被收起，而它恰好是这一屏卡住时唯一能按的东西。 -->
    <view class="stuck" wx:if="{{这页请不动 || onlyOnSale}}" bindtap="onToggleOnSale"
          hover-class="entry-hover" hover-stay-time="100">
      <!-- 来回都走这一条。只给「切过去」不给「切回来」的话，
           人会困在四位的视图里 —— 而「看回四十位」原本也在弹性槽里，
           矮屏一样收起。同一个坑的对称的另一半。 -->
      <text wx:if="{{onlyOnSale}}">只看现在能请的（{{saleCount}} 位）· 看回四十位</text>
      <text wx:else>这一页的几位都还没上架 · 只看现在能请的（{{saleCount}} 位）</text>
      <text class="stuck-go">›</text>
    </view>
    <view class="hr"></view>
  </view>

  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
      <view class="sk sk-face"></view>
      <view class="sk-body">
        <view class="sk sk-line short"></view>
        <view class="sk sk-line mid"></view>
      </view>
    </view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="load">再试一次</button>
  </view>

  <block wx:else>
    <!-- 空不是问题，说不清哪儿能有才是 -->
    <view class="empty" wx:if="{{items.length === 0}}">
      <view class="empty-t">一位也没数到</view>
      <view class="empty-sub">这份名单没取到 —— 待会儿再看看</view>
    </view>

    <!-- 四十位都列出来，在卖的能点、没上架的照实说（设计册 10.8）。
         只列在卖的那几位，读的人会以为世上只有那几位 —— 那是拿别人顶上。 -->
    <view class="list">
      <view wx:for="{{page}}" wx:key="id"
            class="item enter {{item.onSale ? '' : 'item-off'}}"
            style="animation-delay:{{index * 40}}ms"
            data-id="{{item.id}}" bindtap="onTap"
            hover-class="{{item.onSale ? 'item-hover' : ''}}" hover-stay-time="100">
        <!-- 两行，不是三行（设计册 V4 线框就是两行）：
             名 + 动作一行，副题一行。一页五位是「不上下滚动」的落点，
             三行的话第五位会把这一屏顶出去 —— 实测超 97px。 -->
        <!-- 脸。四十位原先是四十行文字 —— 一个靠角色立身的产品，
             最不该没有角色的就是这一屏。没有美术之前用姓名末字，
             等头像画好换这一处即可。 -->
        <view class="item-face face-{{item.direction}}">{{item.face}}</view>
        <view class="item-body">
          <view class="item-top">
            <text class="item-name">{{item.name}}</text>
            <text class="item-lack lack-{{item.direction}}" wx:if="{{item.lack}}">缺 {{item.lack}}</text>
          </view>
          <view class="item-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        </view>
        <!-- 「请他来」对婆婆是错的 —— 四十位里男女都有。不带代词 -->
        <text class="item-go" wx:if="{{item.onSale}}">请回家 ›</text>
        <text class="item-go off" wx:else>还没来</text>
      </view>
    </view>

    <!-- 翻页代替竖向滚动：一页五位，一屏放得下 -->
    <view class="pager" wx:if="{{pageCount > 1}}">
      <view class="pg {{pageNo === 0 ? 'pg-off' : ''}}" bindtap="onPrev">‹ 上一页</view>
      <text class="pg-n">{{pageNo + 1}} / {{pageCount}}</text>
      <view class="pg {{pageNo + 1 >= pageCount ? 'pg-off' : ''}}" bindtap="onNext">下一页 ›</view>
    </view>

    <!-- 卡住那一条出现时这句让位:两条都是注解，而卡住时前者是他唯一按得动的东西，
         两条并存会把第五张卡挤到分页栏底下（这一屏的目标是一屏放得下）。 -->
    <view class="foot" wx:if="{{items.length > 0 && !这页请不动 && !onlyOnSale}}">
      买下之后寄一枚实物到你手上 · 扫开它，人就住进来
    </view>

    <!-- 弹性槽（设计册 V4）：「只看在卖的」。
         四十位里只有几位在卖，而按用神排之后头一位不一定在卖 ——
         缺金的人头三位全是「未上架」，一屏点不动。
         这一条让他一下看到能请的那几位。

         默认【关着】：四十位都列出来是刻意的（只列在卖的那几位，
         读的人会以为世上只有那几位）。想买的时候按一下就行。 -->
    <view class="flexslot onsale" wx:if="{{saleCount > 0}}" bindtap="onToggleOnSale"
          hover-class="onsale-hover" hover-stay-time="100">
      <text wx:if="{{onlyOnSale}}">看回四十位 ›</text>
      <text wx:else>只看在卖的（{{saleCount}} 位）›</text>
    </view>
  </block>
</view>
