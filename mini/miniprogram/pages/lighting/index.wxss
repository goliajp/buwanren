/* 全屏时刻：这一屏自己是深色的，跟别处不一样 —— 它是夜里那二十五分钟 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #1a1712;
  color: #e8e0d0;
  display: flex;
  flex-direction: column;
  padding: 0 48rpx 64rpx;
}

/* 院子那一块吃掉纵向富余（设计 10.1：场景吃比例） */
.yard {
  flex: 1;
  min-height: 240rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 24rpx;
}

/* 一支香：细杆 + 顶上一点火 */
.stick {
  position: relative;
  width: 4rpx;
  height: 210rpx;
  background: linear-gradient(to bottom, #6b5a44 0%, #4a3f30 100%);
  border-radius: 2rpx;
}
.ember {
  position: absolute; top: -6rpx; left: -4rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #e8944a;
  box-shadow: 0 0 18rpx 6rpx rgba(232, 148, 74, 0.55);
  animation: breathe 2.6s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { opacity: .75; box-shadow: 0 0 14rpx 4rpx rgba(232,148,74,.45); }
  50%      { opacity: 1;   box-shadow: 0 0 22rpx 8rpx rgba(232,148,74,.65); }
}

/* 烟。三缕错开，慢慢往上散 */
.smoke {
  position: absolute;
  bottom: 236rpx;
  width: 3rpx; height: 3rpx; border-radius: 50%;
  background: rgba(200, 190, 175, 0.5);
  animation: rise 7s linear infinite;
}
.s1 { animation-delay: 0s; }
.s2 { animation-delay: 2.3s; }
.s3 { animation-delay: 4.6s; }
@keyframes rise {
  0%   { transform: translate(0, 0) scale(1);   opacity: .55; }
  50%  { transform: translate(-18rpx, -120rpx) scale(3); opacity: .28; }
  100% { transform: translate(14rpx, -260rpx) scale(6);  opacity: 0; }
}

.body { flex: none; text-align: center; padding-top: 8rpx; }
.t1 { font-family: "Songti SC", serif; font-size: 44rpx; letter-spacing: 0.1em; }
.t2 { font-size: 26rpx; color: #a89c86; margin-top: 16rpx; line-height: 1.8; }
.meta { margin-top: 36rpx; font-size: 24rpx; color: #8a7f6c; letter-spacing: 0.06em; }
.meta-n { margin-right: 20rpx; }
.meta-t { font-family: "SF Mono", "Menlo", monospace; }

.acts { flex: none; margin-top: 48rpx; display: flex; flex-direction: column; gap: 20rpx; }
.acts .btn.lit { background: #c8763a; color: #fff; border: none; }
.acts .btn.lit[disabled] { background: #55483a; color: #a89c86; opacity: 1; }
.acts .btn.ghost { background: transparent; color: #a89c86; border: 1rpx solid #4a4136; }
