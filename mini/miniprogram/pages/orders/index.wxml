<view class="page">
  <view class="hd">
    <view class="title">我买过的</view>
    <view class="sub" wx:if="{{!loading && !err}}">
      {{total ? total + ' 笔 · 按时间倒着排' : '还没有'}}
    </view>
    <view class="hr"></view>
  </view>

  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-body">
        <view class="sk sk-line mid"></view>
        <view class="sk sk-line short"></view>
      </view>
    </view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="load">再试一次</button>
  </view>

  <block wx:else>
    <!-- 空不是问题，说不清哪儿能有才是 -->
    <view class="empty" wx:if="{{total === 0}}">
      <view class="empty-art pix" style="--pix:url('/images/empty-orders.png')"></view>
      <view class="empty-t">钱包还是满的呢</view>
      <view class="empty-sub">村里每位都带着自己的东西 —— 先去看看谁能来</view>
    </view>

    <view class="list">
      <view wx:for="{{page}}" wx:key="id" class="item enter"
            style="animation-delay:{{index * 40}}ms"
            data-id="{{item.id}}" bindtap="onTap"
            hover-class="press-card" hover-stay-time="100">
        <view class="item-top">
          <text class="item-name">{{item.title}}</text>
          <text class="item-total">{{item.totalText}}</text>
        </view>
        <view class="item-bot">
          <text class="item-when">{{item.whenText}} · {{item.statusText}}</text>
          <text class="item-go">{{item.go}} ›</text>
        </view>
      </view>
    </view>

    <!-- 翻页代替竖向滚动：一页五笔，一屏放得下（设计 10.3） -->
    <view class="pager" wx:if="{{pageCount > 1}}">
      <view class="pg {{pageNo === 0 ? 'pg-off' : ''}}" bindtap="onPrev" hover-class="press-btn" hover-stay-time="80">‹ 上一页</view>
      <text class="pg-n">{{pageNo + 1}} / {{pageCount}}</text>
      <view class="pg {{pageNo + 1 >= pageCount ? 'pg-off' : ''}}" bindtap="onNext">下一页 ›</view>
    </view>

    <view class="foot" wx:if="{{total > 0 && pageCount <= 1}}">没有更多了</view>

    <view class="go-village" bindtap="goVillage" hover-class="entry-hover" hover-stay-time="100">
      <text>去村里看看谁能来</text><text class="arrow">›</text>
    </view>

    <!-- 弹性槽 · 矮屏收起：退款/发票/客服都在单里面，这里只指路 -->
    <!-- 【2026-09-01】原先写「退款、发票、客服都在单里面」——
         三样里只有退款是真的:发票全仓零实现，客服连一个联系入口都没有，
         而这句话还告诉人「答案在单里」。承诺不存在的东西比不承诺更伤。
         说真有的那一样，别的等做出来再写。 -->
    <view class="flexslot" wx:if="{{total > 0}}">点开任一单能看进度，付过的那一笔可以在里面申请退款</view>
  </block>
</view>
