.page { padding: 32rpx 40rpx 40rpx; }
.title { font-size: 44rpx; font-weight: 700; }
.sub { font-size: 26rpx; color: #767676; margin-top: 8rpx; }
.name-input { margin-top: 40rpx; padding: 24rpx 0; font-size: 36rpx;
              border-bottom: 2rpx solid #1a1a1c; }
.hint { font-size: 24rpx; color: #767676; margin-top: 12rpx; }
.note { font-size: 26rpx; color: #b00020; margin-top: 20rpx; }
.hr { height: 1rpx; background: #e0e0e0; margin: 40rpx 0 28rpx; }
.preview-k { font-size: 24rpx; color: #767676; margin-bottom: 16rpx; }
.preview { background: #f6f6f6; padding: 24rpx; }
.who { font-size: 22rpx; color: #767676; margin-top: 16rpx; }
.who:first-child { margin-top: 0; }
.line { font-size: 30rpx; margin-top: 8rpx; line-height: 1.6; }
.acts { margin-top: 48rpx; display: flex; gap: 20rpx; }
