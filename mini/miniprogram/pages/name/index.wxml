<view class="page">
  <view class="hd">
    <view class="title">名字</view>
    <view class="sub">村里的人会这么叫你</view>
  </view>

  <input class="name-input" type="nickname" value="{{draft}}"
         placeholder="换一个名字" bindinput="onInput"/>
  <view class="hint">两到十二个字 · 随时能改</view>

  <view class="note" wx:if="{{note}}">{{note}}</view>

  <!-- 名字不是账户字段，是别人怎么称呼你 —— 所以要看得见叫起来什么样 -->
  <view class="hr"></view>
  <view class="preview-k">叫起来是这样</view>
  <!-- 0830:这是【村民在叫你】—— 灰底方块把它读成了一段说明。
       做成对话气泡 + 一张脸，跟村子主屏那一块同一套语言:
       名字改一个字，你立刻看得见有人这么叫你 -->
  <view class="preview">
    <view class="say-row">
      <!-- 婆婆与苏合的 `lack_bias.direction` 都是 near（往人里去）。
           这两位是写死的举例，所以颜色也写死 —— 但要写【她们真正的那个色】，
           不能各自现调一个:同一个人在别处是粉的，到这儿变成琥珀与绿，
           颜色就不再是在指人了。 -->
      <view class="say-face face-near {{婆脸 ? 'face-art' : ''}}" style="{{婆脸}}"><text wx:if="{{!婆脸}}">婆</text></view>
      <view class="bubble">{{draft || nickname}}，别急，慢慢来</view>
    </view>
    <view class="say-row">
      <view class="say-face face-near {{苏脸 ? 'face-art' : ''}}" style="{{苏脸}}"><text wx:if="{{!苏脸}}">苏</text></view>
      <view class="bubble">{{draft || nickname}}，这一味给你留着</view>
    </view>
  </view>

  <view class="acts">
    <button class="btn" bindtap="save" disabled="{{saving}}">{{saving ? '存着……' : '存下'}}</button>
    <button class="btn ghost" bindtap="onBack">回去</button>
  </view>
</view>
