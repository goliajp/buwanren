.hd { padding: 24rpx 0 28rpx; }
.hd .title { font-size: 50rpx; line-height: 1; }
.hd .sub { font-size: 26rpx; color: var(--ink-faint); margin-top: 10rpx; }

.onboard-card {
  background: var(--paper-panel);
  box-shadow: var(--sh-card);
  border-radius: 16rpx;
  padding: 40rpx 32rpx 32rpx;
}
.onboard-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
  letter-spacing: 0.12em;
  text-align: center;
  margin-bottom: 36rpx;
}

.wx-form { display: flex; flex-direction: column; gap: 30rpx; }
.wx-field { display: flex; justify-content: center; }

.avatar-btn {
  padding: 0;
  background: transparent;
  border: none;
  line-height: 0;
  width: 140rpx;
  height: 140rpx;
}
.avatar-btn::after { border: none; }
.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 1rpx dashed var(--stone-line);
  background: var(--paper-inset);
  display: block;
}
.avatar-preview.avatar-fallback {
  font-weight: 600;
  font-size: 22rpx;
  color: var(--stone-label);
  line-height: 138rpx;
  text-align: center;
  letter-spacing: 0.14em;
}

.nickname-input {
  width: 100%;
  background: var(--paper-inset);
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--ink);
  text-align: center;
  letter-spacing: 0.14em;
  box-sizing: border-box;
}

.wx-cta { text-align: center; margin-top: 8rpx; }
.wx-hint {
  padding: 20rpx 8rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--stone-label);
  line-height: 1.7;
  letter-spacing: 0.06em;
}

.acts { margin-top: 40rpx; text-align: center; }


/* ── 0830 ──────────────────────────────────────────────────
   主按钮原来挂着 `.stamp`（朱印红，这一版映射成桃粉）——
   而桃粉是「喜欢」那一档，压不住一个账号操作。用主色。
   两颗按钮都给整行:这一屏一次只让你做一件事。 */
.page { display: flex; flex-direction: column; }
.card .btn, .cta .btn { width: 100%; box-sizing: border-box; }
.cta { margin-top: auto; padding-top: 32rpx; }
