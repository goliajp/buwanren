.hd { padding: 24rpx 0 20rpx; }
.hd .title { line-height: 1.15; }
.hd .sub { font-size: 24rpx; color: var(--ink-faint); margin-top: 12rpx; letter-spacing: 0.06em; }

.say { padding: 24rpx 0 8rpx; font-size: 30rpx; color: var(--ink); line-height: 1.8; }
.say.muted { font-size: 26rpx; color: var(--ink-faint); }
.say-go { display: block; margin: -12rpx 0 -24rpx; padding: 24rpx 0;
          font-size: 26rpx; color: var(--ink-mid); }

.recipe {
  padding: 12rpx 0 24rpx;
  font-weight: 600;
  font-size: 32rpx;
  color: var(--ink-mid);
  letter-spacing: 0.02em;
}

.loading, .err { padding: 40rpx 0; color: var(--ink-faint); font-size: 26rpx; }
.err-msg { margin-bottom: 20rpx; }

.note { padding: 24rpx 4rpx 0; font-size: 22rpx; color: var(--stone-label); line-height: 1.7; }
.slot-e1 {
  margin-top: 24rpx; padding-top: 18rpx;
  border-top: 1rpx solid var(--stone-line-x);
  font-size: 22rpx; color: var(--stone-label); letter-spacing: 0.06em;
}
/* 这一屏的内容就这么多（三档 + 几句话）。让它自然结束、「回去」贴底 ——
   中间那片空是留白，不是「画到一半」。硬塞内容把它填满才是后者。 */
.page { display: flex; flex-direction: column; }
/* 【贴底，但不拉开太远】。`.page` 是 `min-height: 100vh`（全局），
   配上 `margin-top: auto` 就把这颗按钮顶到视口底 —— 在 iPhone SE 上
   正好，在长屏（14 / ProMax）上会在内容与按钮之间撑出三到五百像素，
   一屏看着像没做完。而那片空白只在长屏出现，我一直只看最矮那一档，
   所以从没见过它。

   `margin-bottom: auto` 让上下两段弹性平分那段富余：按钮不再钉死在
   视口底，而是跟着内容往下留一段。矮屏上富余是 0，行为不变。 */
.acts { margin-top: auto; margin-bottom: auto; padding-top: 48rpx; text-align: center; }
/* 【能点的那一档要够 44px】（2026-09-05 · 点香开着时这一条才出现）。
   不开的时候它只是一句话，多高都行;开着的时候它是【入口】——
   而它算下来只有 28px（22rpx 字 + 18rpx 上内距）。
   这一条只在 `slot-on` 上加，那一句不动。 */
.slot-on {
  display: flex; align-items: center; color: var(--ink-mid);
  min-height: 88rpx; box-sizing: border-box; padding-bottom: 18rpx;
}
.slot-arrow { margin-left: auto; color: var(--stone-label); }


/* ── 0830 ────────────────────────────────────────────────────
   她说话就该有脸；三档是要你选一个，不是一张目录。 */
.say-row { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 22rpx; }
/* 底色与字色由 `.face-<方向>`（app.wxss）给 —— 这里自调过一版绿，
   而苏合的 `lack_bias.direction` 是 near，她在名册与村子里都是粉的。 */
.say-face {
  /* 84rpx = 42px —— 圆牌尺寸统一到这一档:脸是 14 的整数倍时最接近
     原先那 68% 的一档正是 28px（14×2），配 42px 的圆牌是 66.7%。
     顺带一件好处:同一个人在名册、确认、订单、点香几处一样大。 */
  flex: none; width: 84rpx; height: 84rpx; border-radius: 999rpx;
  font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.bubble {
  position: relative; flex: 1;
  background: var(--paper-panel); border-radius: 20rpx;
  box-shadow: var(--sh-card);
  padding: 20rpx 24rpx; font-size: 28rpx; color: var(--ink); line-height: 1.6;
}
.bubble::before {
  content: ''; position: absolute; left: -10rpx; top: 24rpx;
  width: 0; height: 0;
  border-top: 10rpx solid transparent; border-bottom: 10rpx solid transparent;
  border-right: 12rpx solid var(--paper-panel);
}
.say-go { display: block; margin: -14rpx 0 -24rpx; padding: 24rpx 0;
          font-size: 25rpx; font-weight: 600; color: var(--amber-text); }

.recipe { display: flex; align-items: baseline; gap: 18rpx; margin-top: 26rpx; }
.recipe-k { font-size: 23rpx; color: var(--stone-label); }
.recipe-v { font-size: 30rpx; font-weight: 600; color: var(--ink); letter-spacing: 0.06em; }

.picks { display: flex; gap: 12rpx; margin-top: 24rpx; }
.pick {
  flex: 1; min-width: 0; text-align: center;
  background: var(--paper-panel); border-radius: var(--r-card);
  box-shadow: var(--sh-card); padding: 22rpx 10rpx 20rpx;
  transition: transform .12s cubic-bezier(.34,1.56,.64,1);
}
.pick-hover { transform: translateY(3rpx) scale(.98); }
.pick-n { font-size: 24rpx; color: var(--ink-mid); line-height: 1.4; }
.pick-p { margin-top: 10rpx; font-size: 30rpx; font-weight: 700; color: var(--ink);
          font-variant-numeric: tabular-nums; }
.acts { margin-top: auto; }
.acts .btn { width: 100%; box-sizing: border-box; }

/* 点一档直接进确认屏 —— 卡片得说出这件事，而且要说得够重:
   这一屏最要紧的动作是买，它不该比屏底那颗「回去」还轻。
   实心带子贴在卡片底部，三张并排就是三颗按钮。 */
.pick-go {
  margin: 18rpx -10rpx -20rpx; padding: 14rpx 0;
  border-radius: 0 0 var(--r-card) var(--r-card);
  background: var(--amber); color: var(--on-amber);
  font-size: 26rpx; font-weight: 700; letter-spacing: 0.08em;
}
.pick-hover .pick-go { background: var(--amber-deep); }


/* ── 2026-09-01：三档分主次 ─────────────────────────────────
   荐的那一档留实心橙并戴一个小标;另外两档的动作带退成
   「纸底 + 橙字」—— 还是看得出可以点，但不跟主的抢。
   为什么荐最便宜那一档:见 index.ts 里 `标出最便宜那一档` 上面那段。 */
.pick-go {
  background: var(--paper-inset);
  color: var(--amber-text);
  border-top: 2rpx solid #EDE3D2;
}
.pick-rec .pick-go {
  background: var(--amber);
  color: var(--on-amber);
  border-top: none;
}
.pick-rec { border-color: var(--amber); box-shadow: 0 4rpx 14rpx rgba(232,121,26,.14); }
.pick-tag {
  position: absolute; top: -16rpx; left: 50%; transform: translateX(-50%);
  white-space: nowrap;
  padding: 4rpx 14rpx; border-radius: 999rpx;
  background: var(--amber); color: var(--on-amber);
  font-size: 19rpx; font-weight: 600; letter-spacing: .02em;
}
.pick { position: relative; }
