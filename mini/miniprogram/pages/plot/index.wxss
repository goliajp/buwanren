.page { display: flex; flex-direction: column; min-height: 100vh; }

/* 空位子:虚线圆 + 一个问号。实心的圆会读成「有东西」，
   而这一格的意思正是【还没有】 */
.plot-art {
  background: transparent;
  border: 3rpx dashed var(--stone-line);
  color: var(--stone-line);
  font-size: 68rpx;
  box-shadow: none;
}
.empty-s.dim { color: var(--stone-label); font-size: 23rpx; margin-top: 8rpx; }
.empty-state .btn { width: 100%; box-sizing: border-box; }
.back { margin-top: 28rpx; font-size: 26rpx; color: var(--ink-faint); }
