<view class="page">
  <view class="hd">
    <view class="title">我得到的</view>
    <view class="hr"></view>
  </view>

  <view class="sk-rows" wx:if="{{loading}}">
    <view class="sk-card" wx:for="{{[1,2]}}" wx:key="*this">
      <view class="sk sk-face"></view>
      <view class="sk-body"><view class="sk sk-line mid"></view></view>
    </view>
  </view>

  <view class="err" wx:elif="{{err}}">
    <view class="err-msg">{{err}}</view>
    <button class="btn ghost" bindtap="load">再试一次</button>
  </view>

  <block wx:else>
    <view class="count">{{got}} / {{all}}</view>

    <!-- 2 × 3 网格。库里就是六枚（当场数的），一屏放得下，不必滚
         （设计 10.3）。灰的那几枚写着怎么得 —— 条件不藏着。 -->
    <view class="grid">
      <view wx:for="{{items}}" wx:key="id" class="badge enter {{item.earned ? 'got' : ''}}"
            style="animation-delay:{{index * 40}}ms">
        <!-- 圆牌里放名字的头一个字。得到的是琥珀实心，没得到的是灰的空圈 ——
             一眼看得出还差几个，不用去读「还没得到」四个字 -->
        <view class="badge-art">{{item.glyph || item.name}}</view>
        <view class="badge-n">{{item.name}}</view>
        <view class="badge-d">{{item.description}}</view>
        <view class="badge-s" wx:if="{{item.earned}}">{{item.earned_at}}</view>
      </view>
    </view>
  </block>

  <view class="cta">
    <button class="btn ghost" bindtap="onBack">回去</button>
  </view>
</view>
