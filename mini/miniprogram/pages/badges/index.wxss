.hd { padding: 24rpx 0 32rpx; }
.hd .eyebrow { margin-bottom: 20rpx; }
.hd .title { font-size: 56rpx; line-height: 1; margin: 8rpx 0 16rpx; }
.loading, .err { padding: 80rpx 0; text-align: center; color: var(--stone-label); }
.err-msg { margin-bottom: 28rpx; }
.count { font-weight: 600; font-size: 44rpx; color: var(--ink); margin-bottom: 28rpx; }
.badge { border-top: 1rpx solid var(--stone-line); padding: 26rpx 0; opacity: 0.45; }
.badge.got { opacity: 1; }
.badge-top { display: flex; justify-content: space-between; align-items: baseline; }
.badge-name { font-weight: 600; font-size: 34rpx; color: var(--ink); }
.badge-pt { font-size: 22rpx; color: var(--stone-label); }
.badge-desc { font-size: 26rpx; color: var(--stone-label); margin-top: 10rpx; line-height: 1.6; }
.badge-when { font-size: 22rpx; color: var(--stone-label); margin-top: 10rpx; }
.cta { margin-top: 40rpx; }

/* 六枚排 2 × 3，一屏放得下（设计 10.3）。原先是竖排列表，
   六枚就把一屏撑出 264px —— 而滚动在小程序里没有任何提示。 */
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.grid .badge { width: calc((100% - 32rpx) / 3); box-sizing: border-box; padding: 16rpx 12rpx; margin: 0; }
.grid .badge-name { font-size: 24rpx; font-weight: 600; line-height: 1.35; }
.grid .badge-desc { font-size: 20rpx; color: var(--ink-faint); margin-top: 8rpx; line-height: 1.4; }
.grid .badge-when { font-size: 18rpx; color: #999; margin-top: 8rpx; }


/* ── 0830：徽章要有徽章的样子 ──────────────────────────────────
   原先是三列纯文字 + 一条顶线，读起来像一张规格表。
   徽章是【收集品】，收集品要有形状：一个圆牌 + 名字 + 怎么得。
   得到的亮着，没得到的是灰的空圈 —— 一眼看得出还差几个。 */
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.badge {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  background: var(--paper-panel);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  padding: 22rpx 14rpx 18rpx;
  text-align: center;
  border-top: none;
}
.badge-art {
  width: 92rpx; height: 92rpx; margin: 0 auto 14rpx;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700;
  /* 没得到的：虚线空圈，像个【待填的位子】—— 实心灰块看着像坏了 */
  background: transparent;
  border: 2rpx dashed var(--stone-line);
  color: var(--stone-line);
}
/* 得到了的：琥珀实心 + 一圈光。没得到的：空的灰圈 */
.badge.got .badge-art {
  border: none;
  background: linear-gradient(150deg, #FFB463, var(--amber));
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(232,121,26,.32);
}
.badge-n { font-size: 25rpx; font-weight: 600; color: var(--ink); }
.badge.got .badge-n { color: var(--ink); }
.badge-d { font-size: 20rpx; color: var(--ink-faint); margin-top: 6rpx; line-height: 1.5; }
.badge-s { font-size: 19rpx; color: var(--stone-label); margin-top: 8rpx; }

.page { display: flex; flex-direction: column; }
/* 【贴底，但不拉开太远】。`.page` 是 `min-height: 100vh`（全局），
   配上 `margin-top: auto` 就把这颗按钮顶到视口底 —— 在 iPhone SE 上
   正好，在长屏（14 / ProMax）上会在内容与按钮之间撑出三到五百像素，
   一屏看着像没做完。而那片空白只在长屏出现，我一直只看最矮那一档，
   所以从没见过它。

   `margin-bottom: auto` 让上下两段弹性平分那段富余：按钮不再钉死在
   视口底，而是跟着内容往下留一段。矮屏上富余是 0，行为不变。 */
.cta { margin-top: auto; margin-bottom: auto; padding-top: 40rpx; }
.cta .btn { width: 100%; box-sizing: border-box; }
/* 「0 / 6」那个数是这一屏的主角之一 —— 它是进度 */
.count { font-size: 40rpx; font-weight: 700; color: var(--ink); margin-bottom: 20rpx;
         font-variant-numeric: tabular-nums; }

/* 还没拿到的那几枚点得动 —— 通到能拿到它的地方。
   原先六枚全灰、一个都点不动，这一屏唯一能做的事是「回去」。 */
.badge-go { font-size: 21rpx; color: var(--amber-deep); margin-top: 8rpx; font-weight: 600; }
.badge-hover { transform: scale(.97); }
.badge { transition: transform .12s cubic-bezier(.34,1.56,.64,1); }
