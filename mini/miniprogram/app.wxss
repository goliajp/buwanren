/*
 * 不完人 · 全局样式 · 0830 版
 *
 * 换掉了整套「宣纸 + 墨 + 石碑 + 朱印」。那四样加起来在说
 * 「我很古老、我很神秘」，而这个产品要说的是「有人在等你回来」。
 * 参照：星露谷物语 / 旅行青蛙 / 动物森友会 —— 暖、圆、有生气。
 * 设计依据见 .claude/design/product-0830.html
 *
 * 变量名暂时沿用旧名(--paper/--ink/...)以免一次动全部页面；
 * 值全部换过。改名列在 0830 落地清单 A 批的后半。
 */

page {
  /* 底与面 —— 从「旧纸」换成「被灯照着的白」：明度 92 带灰 → 99 带暖 */
  --paper:         #FFFCF6;
  --paper-inset:   #F6F0E6;
  --paper-panel:   #FFFFFF;
  /* 字 —— 暖黑而非纯黑。纯黑压在暖底上会发脏、显硬 */
  --ink:           #2B2620;
  --ink-mid:       #6B6259;
  --ink-faint:     #A69C90;
  --stone-line:   #E4DACA;
  --stone-line-x: #EFE7DA;
  --stone-label:  #A69C90;

  /* 主色：琥珀。这个产品的核心情绪是「有人在等你回来」,
     最准的意象是黄昏的灯 —— 紫是这一品类的通用配色，用它等于自认是那一类 */
  --amber:        #FF9A3C;
  --amber-deep:   #E8791A;
  --amber-lite:   #FFE7CC;
  /* 副色：苔绿 = 村子、住进来了、已完成 */
  --moss:         #3FAE7A;
  --moss-lite:    #DFF3E8;
  /* 甜色：桃粉 = 喜欢、心动、二次元的那点甜 */
  --peach:        #FF7A8A;
  --peach-lite:   #FFE4E7;
  /* 旧名保留：朱印那一处改指琥珀，免得留下一个没人用的红 */
  --stamp:        #FF9A3C;

  /* 五行提亮。旧的五个压得太暗，木和金在小字号下几乎同色 */
  --wx-mu:        #57C97E;
  --wx-huo:       #FF7A5C;
  --wx-tu:        #E8A33D;
  --wx-jin:       #8FA4C4;
  --wx-shui:      #4FA8E8;
  /* 药丸标签用的浅底/深字 —— 五行不再当文字色，改当标签(对比度稳、色盲友好) */
  --wx-mu-bg:#E6F7EC;   --wx-mu-fg:#2E8B57;
  --wx-huo-bg:#FFEDE8;  --wx-huo-fg:#D8543A;
  --wx-tu-bg:#FDF2DC;   --wx-tu-fg:#B57A15;
  --wx-jin-bg:#EDF1F8;  --wx-jin-fg:#5C7091;
  --wx-shui-bg:#E4F2FD; --wx-shui-fg:#2C7FBE;

  /* 圆与影 —— 从「表格」到「东西」 */
  --r-card: 24rpx;
  --r-btn:  28rpx;
  --sh-card: 0 1rpx 4rpx rgba(43,38,32,.05), 0 10rpx 28rpx rgba(43,38,32,.06);

  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", "Helvetica", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 宋体砍了 —— 它是这一版里「古风」最强的单一信号。
   干支本来就是行话，再套一层古体等于双重门槛。
   要强调就加字重，不换字族。 */
.serif {
  font-weight: 600;
  letter-spacing: 0.02em;
}

.mono {
  font-family: "SF Mono", "Menlo", "Courier New", monospace;
  letter-spacing: 0.04em;
}

/* label · 微字 uppercase */
/* 字距从 0.32em 收到 0.1em：大字距是「高冷排版」的标志，
   而这一版要亲和 */
.eyebrow {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--stone-label);
  letter-spacing: 0.1em;
}

/* 更小、更重。又大又细不如小一号加粗耐看 */
.title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.18;
  letter-spacing: -0.01em;
}

.subtitle {
  font-size: 24rpx;
  color: var(--ink-mid);
  letter-spacing: 0.02em;
}

.hr {
  height: 1rpx;
  background: var(--stone-line-x);
  margin: 24rpx 0;
}

/* 卡片：圆角 24rpx + 双层暖阴影，不用边框。
   边框是文档的语言，阴影是物件的语言 */
.card {
  background: var(--paper-panel);
  border-radius: var(--r-card);
  padding: 26rpx 28rpx;
  box-shadow: var(--sh-card);
}

/* 主按钮：琥珀 + 底部 6rpx 实心深色。
   那 6rpx 不是阴影，是【厚度】—— 按下去整个按钮下沉、厚度消失，
   这是游戏按钮的经典做法，也是「有手感」最便宜的一处。 */
button.btn {
  background: var(--amber);
  color: #fff;
  border: none;
  border-radius: var(--r-btn);
  font-size: 30rpx;
  letter-spacing: 0.02em;
  padding: 22rpx 56rpx;
  line-height: 1.4;
  font-weight: 600;
  box-shadow: 0 6rpx 0 var(--amber-deep), 0 10rpx 24rpx rgba(232,121,26,.26);
  transition: transform .12s cubic-bezier(.34,1.56,.64,1), box-shadow .12s;
}
button.btn::after { border: none; }
button.btn[disabled] { opacity: 0.45; box-shadow: none; }
/* 按下去：下沉 6rpx，厚度归零 —— 松手时那条回弹曲线带一点超调 */
button.btn.btn-hover:not([disabled]) {
  transform: translateY(6rpx);
  box-shadow: 0 0 0 var(--amber-deep), 0 4rpx 10rpx rgba(232,121,26,.2);
}

/* 次要动作。原先是纯白 + 厚度 + 阴影，跟主按钮同尺寸 ——
   在米色底上那是【跳出来】的，视觉重量跟主按钮几乎一样。
   结果是「回去」在八屏上成了屏幕最大的东西，而它是最不重要的动作:
   香那一屏最要紧的是买，可白底的「回去」比橙色的「买这一档」还醒目。

   改成透明底 + 一圈细描边:看得见、点得着，但一眼就知道它次于主按钮。
   不用纯文字链是因为好几屏上它是唯一的按钮（空态的「回去」），
   太轻了就找不着落点。 */
button.btn.ghost {
  background: transparent;
  color: var(--ink-mid);
  border: 2rpx solid var(--stone-line);
  box-shadow: none;
}
button.btn.ghost.btn-hover:not([disabled]) {
  transform: none;
  border-color: var(--ink-faint);
  color: var(--ink);
}

/* `.stamp`（朱印红）删了。0830 里它被映射成桃粉，而桃粉是「喜欢」那一档 ——
   用它做主按钮的地方（绑定微信）压不住，看着像个促销标签。
   留着一条没人用的按钮样式，只会诱使下一个人用它。 */

/* ── 五行药丸 ──────────────────────────────────────────────
   五行是【内容标签】，第一要务是一眼分得开。
   旧做法是拿五行色当文字色 —— 对比度随背景漂，小字号下木和金几乎同色。
   改成浅底深字的药丸：对比度稳、色盲友好(形状+文字仍可读),
   而且它把「辛亥」这种行话包装成了看得懂的物件，像游戏里的属性徽章。 */
.pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}
.pill.mu   { background: var(--wx-mu-bg);   color: var(--wx-mu-fg);   }
.pill.huo  { background: var(--wx-huo-bg);  color: var(--wx-huo-fg);  }
.pill.tu   { background: var(--wx-tu-bg);   color: var(--wx-tu-fg);   }
.pill.jin  { background: var(--wx-jin-bg);  color: var(--wx-jin-fg);  }
.pill.shui { background: var(--wx-shui-bg); color: var(--wx-shui-fg); }
.pill.plain{ background: var(--paper-inset); color: var(--ink-mid);   }

/* 五行前景色 · 用 class wx-{五行拼音} 挂大字/chip */
/* 【文字用 -fg 那一套】。`--wx-jin` 这类是【底色】版：金 #8FA4C4、
   水 #4FA8E8 摆在纸色底上对比度只有 2.5:1 左右，而「你缺的是「金」」
   里那个字是这一屏最重要的一个字 —— 看不清就等于没说。
   药丸（`.pill.*`）一直用的就是 -fg，只有这一套落在了底色版上。 */
.wx-mu   { color: var(--wx-mu-fg);   }
.wx-huo  { color: var(--wx-huo-fg);  }
.wx-tu   { color: var(--wx-tu-fg);   }
.wx-jin  { color: var(--wx-jin-fg);  }
.wx-shui { color: var(--wx-shui-fg); }

/* 五行背景色 · 用于分布条 */
.wx-mu-bg   { background: var(--wx-mu);   }
.wx-huo-bg  { background: var(--wx-huo);  }
.wx-tu-bg   { background: var(--wx-tu);   }
.wx-jin-bg  { background: var(--wx-jin);  }
.wx-shui-bg { background: var(--wx-shui); }

.page {
  padding: 48rpx 40rpx 96rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 行：键 · 值 · ›（设计册 10.2 的「行」，H2 / M1 / M3 / M5 / P1 / P2 都用）──
   一直没有样式。`me` 那一屏五条入口都挂着 .entry，而全工程没有一条规则
   接住它 —— 于是它们渲成三段贴在一起的行内文字，没有行高、没有分隔、
   点得到的地方只有那几个字本身。不报错，看着也「有内容」。

   高度按【触点】定，不按文字定：88rpx = 44px，是能稳稳点中的下限。
   值那一栏可长可短，行高不许跟着变。 */
/* 0830：从「一条条横线」改成【圆角分组卡片】。
   横线是文档的语言 —— 一屏全是横线，读起来像一张表而不是一个 app。
   卡片一包，行与行之间的分隔线只留在卡片内部，四角圆起来，
   整块浮在暖底上。这是 iOS 设置那一类的做法，但底色和圆角按这一版的调子。 */
.entries {
  background: var(--paper-panel);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  overflow: hidden;
}
.entry {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--stone-line-x);
}
/* 最后一行不要分隔线 —— 卡片的下边缘已经在那儿了 */
.entry:last-child { border-bottom: none; }
.entry-hover { background: var(--paper-inset); }
.entry-k {
  flex: none;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 0.04em;
}
.entry-v {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--ink-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.entry-arrow {
  flex: none;
  margin-left: 14rpx;
  font-size: 28rpx;
  color: var(--stone-line);
}
/* 没有下一屏可去的那种：值不是「提示」而是事实，所以颜色跟正文一档，
   也不该有箭头 —— 有箭头而点不动，比没有箭头更糟 */
.entry-flat .entry-v { color: var(--ink-mid); }

/* ── 弹性槽：矮屏收起（设计 10.1）───────────────────────────────
   槽里的东西的判据就是「删掉它这一屏仍然成立」，所以放不下时收起来，
   而不是让整屏滚 —— 用户明确要过：小程序没有上下滑动。

   699px 是量出来的：我家那一屏在内容区 700 以上才装得下「近几次」
   （罗盘已经缩到 132px 下限）。

   为什么不用 JS 量：量完改直径、再量的收敛循环把版式变成了时序问题，
   慢机器上还没落定就被量走，同一份代码本机绿、CI 红（2026-08-23）。

   **这里的 100vh 是真机语义 —— tabBar 是原生的、在页面之外，
   所以 100vh 就是内容区。** 镜像里 tabBar 是文档内的 div，
   同一条规则要加上那 50px，换算写在 `web/runtime/page.js` 的
   `paintTabBar` 里，跟 min-height 那处补偿同一个地方、同一个理由。 */
@media (max-height: 699px) {
  .flexslot { display: none; }
}


/* ── 空状态（0830 新增）──────────────────────────────────────
   空屏是最容易被记住的地方，也是这一版之前最潦草的地方：
   一句灰字贴在顶上，下面四分之三全空。

   三件事：①【居中】，不要挤在顶上 ② 一个图形，让它不像出错
   ③ 一条出路。设计册 10.7 说的「空状态要指得出去处」在这儿落地。 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx 40rpx 80rpx;
}
.empty-art {
  width: 168rpx; height: 168rpx; border-radius: 999rpx;
  background: linear-gradient(155deg, var(--amber-lite) 0%, #FFF6EA 100%);
  box-shadow: 0 8rpx 24rpx rgba(232,121,26,.12);
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: var(--amber-deep); font-weight: 700;
  margin-bottom: 30rpx;
}
.empty-t { font-size: 33rpx; font-weight: 600; color: var(--ink); }
.empty-s { font-size: 25rpx; color: var(--ink-faint); margin-top: 12rpx; line-height: 1.7; max-width: 540rpx; }
.empty-state .btn { margin-top: 36rpx; }


/* ── 骨架屏（0830 新增）──────────────────────────────────────
   「取着……」四个字是廉价感的头号来源：白屏一闪，然后内容砸下来。
   骨架屏把那一秒变成「东西正在到位」而不是「什么都没有」。

   两条讲究：
   ① 形状要跟真内容【对得上】—— 对不上的话内容一来就跳一下，比转圈还差
   ② 呼吸要慢（1.4s）。快了像在闪，那是焦虑不是等待

   不用转圈。转圈说的是「系统在忙」，骨架说的是「你的东西在路上」。 */
.sk { background: var(--paper-inset); border-radius: 10rpx; animation: sk-breathe 1.4s ease-in-out infinite; }
@keyframes sk-breathe { 0%, 100% { opacity: 1 } 50% { opacity: .45 } }
.sk-line { height: 26rpx; }
.sk-line.short { width: 38% }
.sk-line.mid   { width: 62% }
.sk-line.long  { width: 88% }
.sk-face { width: 84rpx; height: 84rpx; border-radius: 999rpx; flex: none; }
.sk-card {
  background: var(--paper-panel); border-radius: var(--r-card);
  box-shadow: var(--sh-card); padding: 22rpx 24rpx; margin-bottom: 14rpx;
  display: flex; gap: 20rpx; align-items: center;
}
.sk-card .sk-body { flex: 1; }
.sk-card .sk-line + .sk-line { margin-top: 12rpx; }
.sk-rows { padding-top: 8rpx; }


/* ── 输入框（0830 新增全局）──────────────────────────────────
   原先每一页各写各的，多数是「白底 + 1rpx 深边框」—— 那是网页表单的样子，
   在暖底上尤其硬。这一版统一成【凹陷】：浅色底、无边框、圆角。
   凹下去的东西看起来「可以往里写」，框起来的东西看起来「只能读」。 */
input, textarea, .field-input {
  background: var(--paper-inset);
  border: none;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}
input::placeholder, textarea::placeholder { color: var(--stone-label); }


/* ── 列表逐个入场（0830）────────────────────────────────────
   一整屏内容【一起】出现是「数据到了」；一个接一个出现是「东西正在摆上来」。
   差别只有两百毫秒，但后者是游戏，前者是表格。

   每项差 40ms：五项共 200ms，有节奏而不拖。
   超过 60ms 就开始等 —— 那时它从「有生气」变成「慢」。

   翻页时会再跑一遍，那正好：翻页本来就该有翻的感觉。 */
.enter { animation: enter .34s cubic-bezier(.22,1,.36,1) both; }
@keyframes enter {
  0%   { transform: translateY(14rpx); opacity: 0 }
  100% { transform: translateY(0);     opacity: 1 }
}


/* 头像的默认底色。**必须写在这里，不能写在页面里** ——
   页面样式排在 app.wxss 之后，在那儿写 background 会把下面七条方向色
   全部盖掉，症状是四十个人共用一个颜色（看着就像方向色没做）。
   四柱那条色带踩过同一个坑。 */
.says-face, .item-face, .face, .glyph {
  background: linear-gradient(150deg, var(--amber-lite), #FFC489);
  color: #8A5A1E;
}

/* ── 头像的七种底色（0830）──────────────────────────────────
   四十位共用一个琥珀圆牌时，翻名册一眼分不出谁是谁 —— 而这个产品
   立身之本就是「四十个各不相同的人」。

   配色不是随机分的，按 `lack_bias` 的【方向】走：
   缺勤的催你动、缺静的劝你停、缺亲人的往人里去 —— 同一路人同一个色，
   所以颜色本身也在说事。

   等 40 张头像画好，这一整套连同 `.face-*` 一起撤掉。 */
.face-move   { background: linear-gradient(150deg, #FFE0C2, #FFB067); color: #8A4A12; }
.face-still  { background: linear-gradient(150deg, #DCEEF7, #9CC9E4); color: #2A5C7A; }
.face-wait   { background: linear-gradient(150deg, #E6E2F5, #B3AADD); color: #4A3F7A; }
.face-keep   { background: linear-gradient(150deg, #E3EDDC, #A9C99A); color: #3F5F31; }
.face-let_go { background: linear-gradient(150deg, #F8DFE4, #E7A8B8); color: #7A3448; }
.face-near   { background: linear-gradient(150deg, #FFE6D2, #F5A98C); color: #8A3F28; }
.face-ask    { background: linear-gradient(150deg, #FDEDCB, #E8C878); color: #7A5A1A; }

/* 「缺什么」那颗药丸跟头像走同一个方向色。
   原先它固定是琥珀 —— 于是丹增的卡上，头像是蓝的（缺静 · 劝你停），
   药丸却是橙的，同一件事在一张卡上用两种颜色说了两遍。
   翻名册时颜色本来是最快的那条线索，两套颜色等于没有线索。

   底色比头像浅一档：药丸是标签，不该跟头像抢。
   跟 `.face-*` 放在一起是刻意的 —— 拆开摆迟早有一边先改。 */
.item-lack   { background: #FFEEDF; color: #8A4A12; }   /* 没方向时的兜底 */
.lack-move   { background: #FFEEDF; color: #8A4A12; }
.lack-still  { background: #E7F3F9; color: #2A5C7A; }
.lack-wait   { background: #EFECF9; color: #4A3F7A; }
.lack-keep   { background: #EDF4E8; color: #3F5F31; }
.lack-let_go { background: #FCECEF; color: #7A3448; }
.lack-near   { background: #FFF0E6; color: #8A3F28; }
.lack-ask    { background: #FEF5E2; color: #7A5A1A; }

/* ── 「有人在说话」那张卡（0830 标尺 §1.5.2 沉浸感）──────────────
   村主屏的「他今天说」、首屏的开场白、填出生时间与算完那两屏的旁白
   —— 四处同一张卡、同一个位置感。摊在各页各写一份必然走散，
   而走散的样子是「同一件东西在不同屏上长得不一样」，正好毁掉沉浸感。

   底色由 `.face-<方向>` 给（住着的那位用他自己的颜色）；
   村子自己说话时用 `.intro-face` 的绿 —— 那是「地方」的颜色，不是某个人的。 */
.says {
  align-self: stretch;
  margin: 0 0 12rpx;
  padding: 20rpx 22rpx;
  background: var(--paper-panel);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  display: flex; gap: 18rpx; align-items: flex-start;
}
.says-hover { transform: scale(.985); }
.says-face {
  flex: none;
  width: 84rpx; height: 84rpx; border-radius: 999rpx;
  font-size: 38rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.says-body { flex: 1; min-width: 0; }
.says-who { font-size: 23rpx; color: var(--ink-faint); }
.says-text { font-size: 33rpx; font-weight: 600; color: var(--ink); line-height: 1.5; margin-top: 4rpx; }
.says-foot { display: flex; align-items: baseline; margin-top: 10rpx; }
.says-id { font-size: 21rpx; color: var(--stone-label); }
.says-go { margin-left: auto; font-size: 24rpx; color: var(--amber-deep); font-weight: 600; }
/* 村子自己说话时的脸 —— 绿是「这个地方」的颜色，跟四十个人的七色分得开 */
.intro-face { background: linear-gradient(150deg, var(--moss-lite), #9BD9BA); color: #2E7D5B; }
.intro-alt { color: var(--amber-deep); font-weight: 600; }
