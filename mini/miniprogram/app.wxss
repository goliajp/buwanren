/*
 * 不完人 · 全局样式
 * 铁墨 + 冷灰纸 + 朱砂章 · 五行五色
 * palette 见 README · Songti/PingFang/SF Mono 系统栈,不加载外部字体
 */

page {
  --paper:         #f0ede7;
  --paper-inset:   #e8e5df;
  --paper-panel:   #ffffff;
  --ink:           #1a1a1c;
  --ink-mid:       #4c4d52;
  --ink-faint:     #85858c;
  --stone-line:   #d8d5cf;
  --stone-line-x: #e5e2dc;
  --stone-label:  #a29e97;
  --stamp:        #a83428;

  --wx-mu:        #4d7a56;
  --wx-huo:       #b8593a;
  --wx-tu:        #a48260;
  --wx-jin:       #7a7c85;
  --wx-shui:      #446080;

  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", "Helvetica", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

.serif {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.mono {
  font-family: "SF Mono", "Menlo", "Courier New", monospace;
  letter-spacing: 0.04em;
}

/* label · 微字 uppercase */
.eyebrow {
  font-family: "Helvetica Neue", "Helvetica", sans-serif;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--stone-label);
  letter-spacing: 0.32em;
  text-transform: uppercase;
}

.title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.1;
  letter-spacing: 0.02em;
}

.subtitle {
  font-size: 24rpx;
  color: var(--ink-mid);
  letter-spacing: 0.16em;
}

.hr {
  height: 1rpx;
  background: var(--stone-line-x);
  margin: 24rpx 0;
}

.card {
  background: var(--paper-panel);
  border: 1rpx solid var(--stone-line-x);
  border-radius: 8rpx;
  padding: 24rpx 28rpx;
}

button.btn {
  background: var(--ink);
  color: var(--paper);
  border: none;
  border-radius: 4rpx;
  font-size: 28rpx;
  letter-spacing: 0.16em;
  padding: 20rpx 60rpx;
  line-height: 1.4;
  font-weight: 400;
}
button.btn::after { border: none; }
button.btn[disabled] { opacity: 0.5; }

button.btn.ghost {
  background: transparent;
  color: var(--ink-mid);
  border: 1rpx solid var(--stone-line);
}

button.btn.stamp {
  background: var(--stamp);
  color: var(--paper);
}

/* 五行前景色 · 用 class wx-{五行拼音} 挂大字/chip */
.wx-mu   { color: var(--wx-mu);   }
.wx-huo  { color: var(--wx-huo);  }
.wx-tu   { color: var(--wx-tu);   }
.wx-jin  { color: var(--wx-jin);  }
.wx-shui { color: var(--wx-shui); }

/* 五行背景色 · 用于分布条 */
.wx-mu-bg   { background: var(--wx-mu);   }
.wx-huo-bg  { background: var(--wx-huo);  }
.wx-tu-bg   { background: var(--wx-tu);   }
.wx-jin-bg  { background: var(--wx-jin);  }
.wx-shui-bg { background: var(--wx-shui); }

.page {
  padding: 48rpx 40rpx 96rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 行：键 · 值 · ›（设计册 10.2 的「行」，H2 / M1 / M3 / M5 / P1 / P2 都用）──
   一直没有样式。`me` 那一屏五条入口都挂着 .entry，而全工程没有一条规则
   接住它 —— 于是它们渲成三段贴在一起的行内文字，没有行高、没有分隔、
   点得到的地方只有那几个字本身。不报错，看着也「有内容」。

   高度按【触点】定，不按文字定：88rpx = 44px，是能稳稳点中的下限。
   值那一栏可长可短，行高不许跟着变。 */
.entries { border-top: 1rpx solid var(--stone-line-x); }
.entry {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid var(--stone-line-x);
}
.entry-hover { background: var(--paper-inset); }
.entry-k {
  flex: none;
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 0.04em;
}
.entry-v {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--ink-faint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.entry-arrow {
  flex: none;
  margin-left: 14rpx;
  font-size: 30rpx;
  color: var(--stone-label);
}
/* 没有下一屏可去的那种：值不是「提示」而是事实，所以颜色跟正文一档，
   也不该有箭头 —— 有箭头而点不动，比没有箭头更糟 */
.entry-flat .entry-v { color: var(--ink-mid); }

/* ── 弹性槽：矮屏收起（设计 10.1）───────────────────────────────
   槽里的东西的判据就是「删掉它这一屏仍然成立」，所以放不下时收起来，
   而不是让整屏滚 —— 用户明确要过：小程序没有上下滑动。

   699px 是量出来的：我家那一屏在内容区 700 以上才装得下「近几次」
   （罗盘已经缩到 132px 下限）。

   为什么不用 JS 量：量完改直径、再量的收敛循环把版式变成了时序问题，
   慢机器上还没落定就被量走，同一份代码本机绿、CI 红（2026-08-23）。

   **这里的 100vh 是真机语义 —— tabBar 是原生的、在页面之外，
   所以 100vh 就是内容区。** 镜像里 tabBar 是文档内的 div，
   同一条规则要加上那 50px，换算写在 `web/runtime/page.js` 的
   `paintTabBar` 里，跟 min-height 那处补偿同一个地方、同一个理由。 */
@media (max-height: 699px) {
  .flexslot { display: none; }
}
